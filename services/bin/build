#!/bin/bash -e

while [[ $# -gt 0 ]]; do
  if [[ "$1" == "check" ]]; then
    check=check
    shift
  elif [[ "$1" == "debug" ]]; then
    check="check -i"
    shift
  elif [[ "$1" == "covg" ]]; then
    covg=jacocoTestReport
    shift
  else
    break
  fi
done

ROOT=$(dirname $0)/..
UDMI_ROOT=..
cd $ROOT

jarbase=services-1.0-SNAPSHOT-all.jar
jartmp=/tmp/$jarbase
jardir=build/libs
jarfile=$jardir/$jarbase

newer_files=$([[ -f $jarfile ]] && find src/ ../common/src -type f -newer $jarfile 2>/dev/null || echo missing)
if [[ -z ${check:-} && -z ${covg:-} && -z $newer_files ]]; then
    ls -l $jarfile
    echo $jarfile up-to-date, skipping build.
    exit 0
fi

rm -f $jartmp
echo Stashing $jartmp
[[ ! -f $jarfile ]] || cp -a $jarfile $jartmp

echo Cleaning $ROOT/build/
rm -rf build/
mkdir -p $jardir

[[ ! -f $jartmp ]] || cp -a $jartmp $jarfile

echo Mirroring udmi files...
cp -a ../bin build/udmi_bin/
cp -a ../etc build/udmi_etc/
cp -a ../schema build/schema/

echo Java version $(java --version)

echo Building services in $PWD

./gradlew shadow $check $covg $*

[[ -f $jarfile || ! -f $jartmp ]] || cp -a $jartmp $jarfile
touch -c $jarfile

ls -l $jarfile

echo Done with services build.
