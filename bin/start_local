#!/bin/bash -e

UDMI_ROOT=$(dirname $0)/..
source $UDMI_ROOT/etc/shell_common.sh
source $UDMI_ROOT/etc/tmux_common.sh

if [[ "${1:-}" == "stop" ]]; then
    echo "Stopping local UDMI infrastructure..."
    
    echo "Stopping butler..."
    $UDMI_ROOT/bin/start_butler stop || true

    echo "Stopping UDMIS..."

    $UDMI_ROOT/bin/start_udmis stop || true

    echo "Stopping etcd..."
    $UDMI_ROOT/bin/start_etcd stop || true

    echo "Stopping influx..."
    $UDMI_ROOT/bin/start_influx stop || true

    echo "Stopping postgresql..."
    $UDMI_ROOT/bin/start_postgresql stop || true

    echo "Stopping mosquitto..."
    $UDMI_ROOT/bin/start_mosquitto stop || true

    echo "Stopping pubsub..."
    if [[ -f $UDMI_ROOT/out/pubsub.pid ]]; then
        kill $(cat $UDMI_ROOT/out/pubsub.pid) 2>/dev/null || true
        rm -f $UDMI_ROOT/out/pubsub.pid
    fi
    ps ax | fgrep cloud-pubsub-emulator | fgrep -v grep | awk '{print $1}' | xargs -r kill 2>/dev/null || true

    # Also terminate any active tmux sessions
    $UDMI_ROOT/bin/tmux_barbican stop >/dev/null 2>&1 || true
    $UDMI_ROOT/bin/tmux_butler stop >/dev/null 2>&1 || true
    $UDMI_ROOT/bin/tmux_bridgehead stop >/dev/null 2>&1 || true
    $UDMI_ROOT/bin/tmux_base stop >/dev/null 2>&1 || true
    $UDMI_ROOT/bin/tmux_model stop >/dev/null 2>&1 || true

    echo "Local UDMI infrastructure stopped cleanly."
    exit 0
fi

block=
FILTER_ARGS=()
POSITIONAL_ARGS=()

for arg in "$@"; do
    case "$arg" in
        block)
            block="block"
            ;;
        \+*|\!*)
            FILTER_ARGS+=("$arg")
            ;;
        *)
            POSITIONAL_ARGS+=("$arg")
            ;;
    esac
done

ALLOWED_SERVICES=(mosquitto udmis etcd postgres influxdb butler validator registrar pubsub)

# Parse and strictly validate filter arguments
parse_tmux_args "${FILTER_ARGS[@]}"
tmux_validate_services "start_local" "${ALLOWED_SERVICES[@]}"

set -- "${POSITIONAL_ARGS[@]}"

if [[ $# -eq 0 ]]; then
    site_config="sites/udmi_site_model"
elif [[ $# -eq 1 ]]; then
    site_config=$(realpath "$1")
    if [[ -d $site_config ]]; then
        site_config=$site_config/cloud_iot_config.json
    fi
else
    site_config=$(realpath "$1")
    if [[ -d $site_config ]]; then
        site_config=$site_config/cloud_iot_config.json
    fi
    project_spec="$2"
fi

if [[ -d "$site_config" ]]; then
    site_config="$site_config/cloud_iot_config.json"
fi

if [[ ! -f $site_config ]]; then
    fail "local startup requires explicit site path file ($site_config not found)."
fi
site_model=$(dirname "$site_config")

# Check for missing etc/ dir for docker execution.
if [[ -d var/ && ! -d etc/ ]]; then
    ln -s var etc
fi

cd "$UDMI_ROOT"
UDMIS_LOG=${UDMIS_LOG:-out/udmis.log}
mkdir -p $(dirname "$UDMIS_LOG")
# Do sudo now to prefetch incase it's needed later...
if [[ ${UDMI_NO_SUDO:-false} != true ]]; then
    sudo true
fi
echo Starting local services at $(date -u -Is) | tee $UDMIS_LOG

iot_provider=$(jq -r .iot_provider $site_config)
if [[ -n ${project_spec:-} ]]; then
    project_spec=$(normalize_conn_spec "$project_spec")
    no_prefix=${project_spec#//}
    iot_provider=${no_prefix%%/*}
    no_provider=${no_prefix#*/}
    project_target=${no_provider%%/*}
    if [[ $project_target == *@* ]]; then
        project_target=${project_target%@*}
    fi
    if [[ $project_target == *:* ]]; then
        project_target=${project_target%:*}
    fi
fi

if [[ $iot_provider != mqtt ]]; then
    echo Provider type $iot_provider is not a local setup, doing nothing | tee -a $UDMIS_LOG
    exit 0
fi

[[ -n ${project_target:-} ]] || project_target=$(jq -r .project_id $site_config)
if [[ $project_target == *:* ]]; then
    project_target=${project_target%:*}
fi
registry_id=$(jq -r .registry_id $site_config)${UDMI_REGISTRY_SUFFIX:-}

should_start() {
    local svc="$1"
    local is_optional="${2:-false}"
    tmux_should_run_service "$svc" "$is_optional"
}

# 1. etcd
if should_start "etcd"; then
    echo Starting etcd... | tee -a $UDMIS_LOG
    $UDMI_ROOT/bin/start_etcd >> $UDMIS_LOG 2>&1
else
    echo "Skipping etcd (filtered)" | tee -a $UDMIS_LOG
fi

# 2. influxdb
if should_start "influxdb"; then
    echo Starting influxdb... | tee -a $UDMIS_LOG
    $UDMI_ROOT/bin/start_influx >> $UDMIS_LOG 2>&1
else
    echo "Skipping influxdb (filtered)" | tee -a $UDMIS_LOG
fi

# 3. postgres
if should_start "postgres"; then
    echo Starting postgres... | tee -a $UDMIS_LOG
    $UDMI_ROOT/bin/start_postgresql >> $UDMIS_LOG 2>&1
else
    echo "Skipping postgres (filtered)" | tee -a $UDMIS_LOG
fi

# 4. mosquitto
if should_start "mosquitto"; then
    source $UDMI_ROOT/etc/mosquitto_ctrl.sh
    mkdir -p $CERT_DIR

    echo Starting mosquitto on server $project_target | tee -a $UDMIS_LOG
    $UDMI_ROOT/bin/setup_ca $site_model $project_target >> $UDMIS_LOG 2>&1
    $UDMI_ROOT/bin/start_mosquitto >> $UDMIS_LOG 2>&1

    $MOSQUITTO_CTRL deleteClient $SERV_USER >> $UDMIS_LOG 2>&1 || true
    $MOSQUITTO_CTRL createClient $SERV_USER -p $SERV_PASS >> $UDMIS_LOG 2>&1 || true # No client_id to allow multiple backend connections.
    $MOSQUITTO_CTRL addClientRole $SERV_USER service >> $UDMIS_LOG 2>&1 || true
    $MOSQUITTO_CTRL addClientRole $SERV_USER uufi >> $UDMIS_LOG 2>&1 || true

    # Setup device client security (for all direct/gateway devices in the site model)
    for device_dir in $site_model/devices/*; do
        if [[ -d $device_dir ]]; then
            device_id=$(basename $device_dir)
            metadata_file=$device_dir/metadata.json
            if [[ -f $metadata_file ]] && jq -e '.cloud.auth_type != null' $metadata_file >/dev/null 2>&1; then
                $UDMI_ROOT/bin/mosquctl_device $site_model $device_id >> $UDMIS_LOG 2>&1
            fi
        fi
    done

    echo Starting initializing site $site_model | tee -a $UDMIS_LOG
    $UDMI_ROOT/bin/mosquctl_site $site_model >> $UDMIS_LOG 2>&1

    if [[ -n ${UDMI_ALT_REGISTRY:-} ]]; then
        $UDMI_ROOT/bin/mosquctl_site $site_model $UDMI_ALT_REGISTRY >> $UDMIS_LOG 2>&1
    fi

    # Global access to logs for connection tracking by UDMIS.
    if [[ ${UDMI_NO_SUDO:-false} != true ]]; then
        sudo chmod a+r /var/log/mosquitto/mosquitto.log
    fi
else
    echo "Skipping mosquitto (filtered)" | tee -a $UDMIS_LOG
fi

# 5. udmis
if should_start "udmis"; then
    echo Starting udmis proper... | tee -a $UDMIS_LOG
    $UDMI_ROOT/bin/start_udmis >> $UDMIS_LOG 2>&1
else
    echo "Skipping udmis (filtered)" | tee -a $UDMIS_LOG
fi

# 6. butler
if should_start "butler"; then
    echo Starting butler... | tee -a $UDMIS_LOG
    $UDMI_ROOT/bin/start_butler "$site_model" "${project_spec:-//mqtt/localhost:${MQTT_PORT:-8883}}" >> $UDMIS_LOG 2>&1
else
    echo "Skipping butler (filtered)" | tee -a $UDMIS_LOG
fi

# 7. pubsub (optional: ++pubsub)
if should_start "pubsub" "true"; then
    echo Starting pubsub emulator... | tee -a $UDMIS_LOG
    $UDMI_ROOT/bin/start_pubsub >> $UDMIS_LOG 2>&1
else
    echo "Skipping pubsub (filtered)" | tee -a $UDMIS_LOG
fi

echo Done with local server setup.


echo ""
echo "################################################################"
echo "UUFI Service is READY"
echo "################################################################"
echo "Connection String: mqtt://rocket:monkey@localhost:${MQTT_PORT:-8883}"
echo "CA Certificate:    $site_model/reflector/ca.crt"
echo "Client Cert:       $site_model/reflector/rsa_private.crt"
echo "Client Key:        $site_model/reflector/rsa_private.pem"
echo "################################################################"
echo ""

[[ -z $block ]] || (echo Blocking until termination. && tail -f /dev/null)
