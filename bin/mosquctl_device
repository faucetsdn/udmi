#!/bin/bash -eu

UDMI_ROOT=$(dirname $0)/..
# cd $UDMI_ROOT

source $UDMI_ROOT/etc/shell_common.sh

if [[ $# != 2 ]]; then
    echo Usage: $0 site_model device_id
    false
fi

site_path=$1
device_id=$2

source $UDMI_ROOT/etc/mosquitto_ctrl.sh

site_config=$site_path/cloud_iot_config.json
registry_id=$(jq -r .registry_id $site_config)

# Find the private key file
device_dir="$site_path/devices/$device_id"
key_file=""
for prefix in rsa ec es; do
    if [[ -f "$device_dir/${prefix}_private.pkcs8" ]]; then
        key_file="$device_dir/${prefix}_private.pkcs8"
        break
    fi
done

if [[ -z "$key_file" ]]; then
    for existing in "$device_dir"/*_public.pem "$device_dir"/*_cert.pem "$device_dir"/*_private.pem "$device_dir"/*_private.crt; do
        if [[ -f "$existing" ]]; then
            fail "Existing key/cert file '$existing' found without a matching *_private.pkcs8 in '$device_dir'. Refusing to overwrite existing device keys or leave a mismatched certificate."
        fi
    done
    warn "No private key found for device $device_id, generating..."
    mkdir -p "$device_dir"
    "$UDMI_ROOT/bin/keygen" RS256 "$device_dir"
    key_file="$device_dir/rsa_private.pkcs8"
fi

ns_prefix=""
if [[ "$site_path" =~ sites/udmi~([a-zA-Z0-9_-]+) ]]; then
    ns_prefix="${BASH_REMATCH[1]}~"
elif [[ -n "${UDMI_NAMESPACE:-}" ]]; then
    ns_prefix="${UDMI_NAMESPACE}~"
fi

hash_pass=$(sha256sum < $key_file)
DEV_PASS=${hash_pass:0:8}
DEV_USER=/r/${ns_prefix}$registry_id/d/$device_id
DEV_ID=$DEV_USER

echo Configuring device $device_id as $DEV_ID with password $DEV_PASS

$MOSQUITTO_CTRL deleteClient $DEV_USER || true
$MOSQUITTO_CTRL createClient $DEV_USER -p $DEV_PASS -c $DEV_ID
$MOSQUITTO_CTRL addClientRole $DEV_USER service

if [[ -n "$ns_prefix" ]]; then
    BARE_USER=/r/$registry_id/d/$device_id
    $MOSQUITTO_CTRL deleteClient $BARE_USER || true
    $MOSQUITTO_CTRL createClient $BARE_USER -p $DEV_PASS -c $BARE_USER
    $MOSQUITTO_CTRL addClientRole $BARE_USER service
fi

if [[ -n "${UDMI_REGISTRY_SUFFIX:-}" ]]; then
    SUFFIX_USER=/r/${ns_prefix}$registry_id${UDMI_REGISTRY_SUFFIX}/d/$device_id
    $MOSQUITTO_CTRL deleteClient $SUFFIX_USER || true
    $MOSQUITTO_CTRL createClient $SUFFIX_USER -p $DEV_PASS -c $SUFFIX_USER
    $MOSQUITTO_CTRL addClientRole $SUFFIX_USER service
    if [[ -n "$ns_prefix" ]]; then
        BARE_SUFFIX_USER=/r/$registry_id${UDMI_REGISTRY_SUFFIX}/d/$device_id
        $MOSQUITTO_CTRL deleteClient $BARE_SUFFIX_USER || true
        $MOSQUITTO_CTRL createClient $BARE_SUFFIX_USER -p $DEV_PASS -c $BARE_SUFFIX_USER
        $MOSQUITTO_CTRL addClientRole $BARE_SUFFIX_USER service
    fi
fi

echo Registered devices for $device_id
