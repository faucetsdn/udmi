#!/bin/bash -e

UDMI_ROOT=$(dirname $0)/..
source $UDMI_ROOT/etc/shell_common.sh
source $UDMI_ROOT/etc/mosquitto_ctrl.sh

UDMIS_PID_FILE=${UDMIS_PID_FILE:-var/udmis.pid}
mkdir -p $(dirname "$UDMIS_PID_FILE")

if [[ ${1:-} == stop ]]; then
    if [[ -f $UDMIS_PID_FILE ]]; then
        OLD_PID=$(cat $UDMIS_PID_FILE)
        if ps -p $OLD_PID > /dev/null 2>&1; then
            echo "Killing old udmis process $OLD_PID from local PID file..."
            kill $OLD_PID 2>/dev/null || true
            sleep 1
        fi
    fi
    exit 0
fi

if [[ -f $UDMIS_PID_FILE ]]; then
    OLD_PID=$(cat $UDMIS_PID_FILE)
    if ps -p $OLD_PID > /dev/null 2>&1; then
        echo "Killing old udmis process $OLD_PID from local PID file..."
        kill $OLD_PID 2>/dev/null || true
        sleep 2
    fi
elif [[ "$UDMIS_PID_FILE" == "var/udmis.pid" || "$UDMIS_PID_FILE" == "$UDMI_ROOT/var/udmis.pid" ]]; then
    # Fallback only if default PID file and not in NO_SUDO mode
    if [[ ${UDMI_NO_SUDO:-false} != true ]]; then
        OLD_PID=$(ps ax | fgrep java | fgrep udmis | awk '{print $1}') || true
        if [[ -n $OLD_PID ]]; then
            echo "Killing old udmis process $OLD_PID..."
            ${SUDO:-} kill $OLD_PID 2>/dev/null || true
            sleep 2
        fi
    fi
fi

if [[ -f /.dockerenv || -n ${UDMI_CONTAINER:-} ]]; then
    POD_READY=${UDMI_POD_READY:-/tmp/pod_ready.txt}
    UDMIS_DIR=/root
else
    POD_READY=${UDMI_POD_READY:-$UDMI_ROOT/var/pod_ready.txt}
    UDMIS_DIR=$UDMI_ROOT/udmis
fi
mkdir -p $(dirname "$POD_READY")
export UDMI_POD_READY=$(realpath -m $POD_READY)
rm -f $UDMI_POD_READY

if [[ ${UDMIS_SKIP_PREP:-false} != true ]]; then
    if [[ ! -f $UDMIS_DIR/build/libs/udmis-1.0-SNAPSHOT-all.jar || ! -f $UDMIS_DIR/var/deployed_version.json ]]; then
        if [[ ! -f /root/build/libs/udmis-1.0-SNAPSHOT-all.jar ]]; then
            $UDMI_ROOT/bin/container udmis prep --no-check || true
        fi
    fi
fi

LOGFILE=${UDMIS_LOG:-$UDMI_ROOT/out/udmis.log}
export UDMIS_LOG=$(realpath -m "$LOGFILE")
mkdir -p $(dirname "$UDMIS_LOG")
date >> "$UDMIS_LOG"

export ETCD_CLUSTER=127.0.0.1
export ETCD_PORT=${ETCD_PORT:-2379}
export INFLUX_PORT=${INFLUX_PORT:-8086}
export POSTGRES_PORT=${POSTGRES_PORT:-5432}
export ETCD_SCHEME=${ETCD_SCHEME:-http}
export ETCD_CA=${ETCD_CA:-}
export ETCD_CERT=${ETCD_CERT:-}
export ETCD_KEY=${ETCD_KEY:-}

if [[ ${ETCD_USE_SSL:-false} == true ]]; then
    export ETCD_SCHEME=${ETCD_SCHEME:-https}
    export ETCD_CA=${ETCD_CA:-$(realpath $CERT_DIR/ca.crt)}
    export ETCD_CERT=${ETCD_CERT:-$(realpath $CERT_DIR/rsa_private.crt)}
    export ETCD_KEY=${ETCD_KEY:-$(realpath $CERT_DIR/rsa_private.pem)}
fi

export SSL_SECRETS_DIR=$(realpath $CERT_DIR)
mkdir -p "$ETC_DIR/log"
touch "$ETC_DIR/log/mosquitto.log" 2>/dev/null || true
export MOSQUITTO_LOG_PATH=$(realpath -m "$ETC_DIR/log/mosquitto.log")

# Default config preprocessing
if [[ -z ${UDMIS_CONFIG:-} || $UDMIS_CONFIG == var/local_pod.json || -n ${UDMI_RUN_DIR:-} ]]; then
    target_config=${UDMIS_CONFIG:-$UDMI_ROOT/var/local_pod.json}
    mkdir -p $(dirname "$target_config")
    if [[ -f /root/var/local_pod.json ]]; then
        SOURCE_POD_CONFIG=/root/var/local_pod.json
        INCLUDE_PATH=/root/var/prod_pod.json
    else
        SOURCE_POD_CONFIG=$UDMIS_DIR/etc/local_pod.json
        INCLUDE_PATH="$UDMI_ROOT/udmis/etc/prod_pod.json"
    fi
    ABS_CERT_DIR=$(realpath $CERT_DIR)
    udmi_prefix=""
    if [[ -n "${UDMI_NAMESPACE:-}" ]]; then
        udmi_prefix="${UDMI_NAMESPACE}~"
    fi
    export UDMI_PREFIX="$udmi_prefix"
    jq '.include = "'"$INCLUDE_PATH"'" |
        .base.udmi_prefix = "'"$udmi_prefix"'" |
        .flow_defaults.ca_file = "'"$ABS_CERT_DIR/ca.crt"'" |
        .flow_defaults.cert_file = "'"$ABS_CERT_DIR/rsa_private.crt"'" |
        .flow_defaults.key_file = "'"$ABS_CERT_DIR/rsa_private.pem"'" |
        .flow_defaults.port = '"${MQTT_PORT:-8883}"' |
        .iot_access.implicit.project_id = "'"${ETCD_SCHEME}"'://${ETCD_CLUSTER}:'"${ETCD_PORT}"'" |
        .iot_access.implicit.endpoint.port = '"${MQTT_PORT:-8883}"' |
        .iot_access.implicit.endpoint.ca_file = "'"$ABS_CERT_DIR/ca.crt"'" |
        .iot_access.implicit.endpoint.cert_file = "'"$ABS_CERT_DIR/rsa_private.crt"'" |
        .iot_access.implicit.endpoint.key_file = "'"$ABS_CERT_DIR/rsa_private.pem"'" |
        .iot_data.database.project_id = "'"${ETCD_SCHEME}"'://${ETCD_CLUSTER}:'"${ETCD_PORT}"'"' \
        $SOURCE_POD_CONFIG | sponge "$target_config"
    UDMIS_CONFIG="$target_config"
fi

# Wait for prerequisite services (mosquitto and etcd) if running locally
if [[ -d "$ETC_DIR" ]]; then
    for i in $(seq 1 50); do
        if [[ -f "$ETC_DIR/mosquitto.ready" ]]; then
            break
        fi
        sleep 0.2
    done
elif [[ -n "${MQTT_PORT:-}" ]]; then
    for i in $(seq 1 50); do
        if timeout 1 bash -c "</dev/tcp/127.0.0.1/${MQTT_PORT}" 2>/dev/null; then
            break
        fi
        sleep 0.2
    done
fi

if [[ -n "${ETCD_PORT:-}" ]]; then
    for i in $(seq 1 50); do
        if timeout 1 bash -c "</dev/tcp/127.0.0.1/${ETCD_PORT}" 2>/dev/null || curl -sf "http://127.0.0.1:${ETCD_PORT}/health" >/dev/null 2>&1; then
            break
        fi
        sleep 0.2
    done
fi

echo Using UDMIS_CONFIG $UDMIS_CONFIG

nohup $UDMIS_DIR/bin/run $UDMIS_CONFIG >> "$UDMIS_LOG" 2>&1 &

PID=$!
echo $PID > $UDMIS_PID_FILE
disown $PID 2>/dev/null || true

WAITING=90
for i in `seq 1 $WAITING`; do
    if [[ -f $UDMI_POD_READY || ! -d /proc/$PID ]]; then
        break
    fi
    echo Waiting for udmis startup $((WAITING - i))...
    sleep 1
done

echo ::::::::: tail $UDMIS_LOG
tail -n 30 "$UDMIS_LOG"

if [[ ! -f $UDMI_POD_READY ]]; then
    echo "=== DIAGNOSTIC LOGS FOR UDMIS STARTUP FAILURE ==="
    echo "Host working directory: $PWD"
    echo "Process $PID status:"
    ps -p $PID || echo "Process $PID not running"
    echo "Last 100 lines of $UDMIS_LOG:"
    tail -n 100 "$UDMIS_LOG" || true
    echo "var/ directory contents:"
    ls -la var || true
    echo "=== END DIAGNOSTIC LOGS ==="
fi

[[ -f $UDMI_POD_READY ]] || fail pod_ready.txt not found.

echo udmis running in the background, pid $PID log in $(realpath "$UDMIS_LOG")
