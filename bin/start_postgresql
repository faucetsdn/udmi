#!/bin/bash -e

UDMI_ROOT=$(dirname "$0")/..
source "$UDMI_ROOT/etc/shell_common.sh"

function find_postgres_bin {
    # Check standard system paths first
    for dir in \
        "/usr/lib/postgresql/*/bin" \
        "/usr/lib/postgresql/bin" \
        "/usr/bin" \
        "/usr/local/bin"; do
        # Use glob expansion to find if any postgres/pg_ctl exists
        for path in $dir; do
            if [[ -f "$path/pg_ctl" ]]; then
                echo "$path"
                return 0
            fi
        done
    done
    return 1
}

BINDIR=$(find_postgres_bin) || {
    echo "Error: pg_ctl/postgres executables not found" >&2
    exit 1
}

POSTGRES_DIR=${POSTGRES_DIR:-var/postgresql}
POSTGRES_LOG=${POSTGRES_LOG:-out/postgresql.log}
echo pwd: $(pwd)

if [[ $(id -u) -eq 0 ]]; then
    # We are root (inside the container). Ensure directories exist and are owned by postgres.
    # We also make sure parent directories are traversable and /tmp is world-writable so postgres user can write lock files and sockets.
    chmod 755 /root $(pwd) || true
    chmod 777 /tmp || true
    mkdir -p $(dirname "$POSTGRES_LOG") "$POSTGRES_DIR"
    chown -R postgres:postgres $(dirname "$POSTGRES_LOG") "$POSTGRES_DIR"
else
    mkdir -p $(dirname "$POSTGRES_LOG") "$POSTGRES_DIR"
fi

POSTGRES_PID_FILE=${POSTGRES_PID_FILE:-$POSTGRES_DIR/postgresql.pid}
if [[ -f $POSTGRES_PID_FILE ]]; then
    old_pid=$(cat $POSTGRES_PID_FILE)
    if kill -0 $old_pid > /dev/null 2>&1; then
        echo Killing existing local postgresql pid $old_pid...
        kill $old_pid || true
        sleep 1
    fi
fi

if [[ ${1:-} == stop ]]; then
    exit 0
fi

postgres_port=${POSTGRES_PORT:-5432}
postgres_user=${POSTGRES_USER:-postgres}
postgres_db=${POSTGRES_DB:-postgres}

DATA_DIR="${POSTGRES_DATA_DIR:-$POSTGRES_DIR/data}"

if [[ ! -d "$DATA_DIR" ]]; then
    echo "Initializing new PostgreSQL database cluster at $DATA_DIR..."
    rm -rf "$DATA_DIR"
    if [[ $(id -u) -eq 0 ]]; then
        mkdir -p $(dirname "$DATA_DIR")
        chown -R postgres:postgres var/postgresql
        su -s /bin/bash postgres -c "$BINDIR/initdb -D '$DATA_DIR' -U '${postgres_user}' --auth-local=trust --auth-host=trust --nosync"
    else
        # initdb requires to run under current user. We use trust auth for local development testing.
        $BINDIR/initdb -D "$DATA_DIR" -U "${postgres_user}" --auth-local=trust --auth-host=trust --nosync
    fi
    echo "host all all 0.0.0.0/0 trust" >> "$DATA_DIR/pg_hba.conf"
fi

echo Starting postgresql locally...
# Start postgres process in user space with nohup
# We use -k /tmp to ensure unix socket files are created in /tmp (where we have write permission) instead of /var/run/postgresql.
if [[ $(id -u) -eq 0 ]]; then
    chown -R postgres:postgres out var/postgresql
    nohup su -s /bin/bash postgres -c "$BINDIR/postgres -D '$DATA_DIR' -p ${postgres_port} -h '*' -k /tmp" > $POSTGRES_LOG 2>&1 &
else
    nohup $BINDIR/postgres -D "$DATA_DIR" \
                           -p ${postgres_port} \
                           -h '*' \
                           -k /tmp \
                           > $POSTGRES_LOG 2>&1 &
fi
POSTGRES_PID=$!
echo $POSTGRES_PID > $POSTGRES_PID_FILE
disown $POSTGRES_PID 2>/dev/null || true

echo Waiting for postgresql to start on port ${postgres_port}, log in $POSTGRES_LOG
# Wait up to 15s, polling to check if it's ready
for i in {1..15}; do
    if psql -h 127.0.0.1 -p ${postgres_port} -U "${postgres_user}" -d "${postgres_db}" -c "SELECT 1;" >/dev/null 2>&1; then
        echo "PostgreSQL started successfully."
        break
    fi
    sleep 1
done

if ! kill -0 $POSTGRES_PID >/dev/null 2>&1; then
    cat $POSTGRES_LOG
    echo "error starting postgresql"
    exit 1
fi

echo "Initializing default PostgreSQL tables..."
PYTHONPATH="$UDMI_ROOT/common/src/main/python:$UDMI_ROOT" python3 -c "from udmi.common.db.postgres import PostgresManager; PostgresManager(port='${postgres_port}').init_default_tables()"

echo Completed postgresql startup.
