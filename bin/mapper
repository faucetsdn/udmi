#!/bin/bash -e

UDMI_ROOT=$(dirname $0)/..
source $UDMI_ROOT/etc/shell_common.sh

if [[ $# -lt 4 ]]; then
    usage site_model project device_id command [targets...]
fi

if [ -f "$UDMI_ROOT/venv/bin/activate" ]; then
    source "$UDMI_ROOT/venv/bin/activate"
fi

exec python3 $UDMI_ROOT/butler/bin/butler "$@"
