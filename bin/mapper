#!/bin/bash -e

UDMI_ROOT=$(dirname $0)/..
source $UDMI_ROOT/etc/shell_common.sh


if [[ $# -lt 4 ]]; then
    usage site_model project device_id command [targets...]
fi

[[ ! -d $UDMI_ROOT/validator/src ]] ||
    up_to_date $UDMI_JAR $UDMI_ROOT/validator/src ||
    $UDMI_ROOT/validator/bin/build

java -cp $UDMI_JAR com.google.daq.mqtt.mapping.MappingAgent "$@"
