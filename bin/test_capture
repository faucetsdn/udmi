#!/bin/bash -e

# Script to test the pull_files | pull_save db pipeline using Butler ingestion
# Assumes necessary database infrastructure is already running.


UDMI_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$UDMI_ROOT"
source "$UDMI_ROOT/etc/shell_common.sh"

PG_PORT=${POSTGRES_PORT:-5432}
PG_USER=${POSTGRES_USER:-postgres}
PG_DB=${POSTGRES_DB:-postgres}
INF_PORT=${INFLUX_PORT:-8086}

echo "=== Running pull_files | pull_save db pipeline..."
bin/pull_files tests/traces/simple | bin/pull_save db

echo "=== Verifying PostgreSQL records in raw udmi_messages..."
postgres_count=$(psql -h 127.0.0.1 -p "$PG_PORT" -U "$PG_USER" -d "$PG_DB" -t -A -c "SELECT count(*) FROM udmi_messages;" 2>/dev/null || echo 0)

if [[ $postgres_count -gt 0 ]]; then
    echo "PASS: Found $postgres_count records in PostgreSQL udmi_messages."
else
    echo "FAIL: No records found in PostgreSQL udmi_messages!"
    exit 1
fi

echo "=== Verifying PostgreSQL records in specialized tables..."
sys_state_count=$(psql -h 127.0.0.1 -p "$PG_PORT" -U "$PG_USER" -d "$PG_DB" -t -A -c "SELECT count(*) FROM udmi_system_state;" 2>/dev/null || echo 0)
echo "Found $sys_state_count records in udmi_system_state."

point_state_count=$(psql -h 127.0.0.1 -p "$PG_PORT" -U "$PG_USER" -d "$PG_DB" -t -A -c "SELECT count(*) FROM udmi_point_state;" 2>/dev/null || echo 0)
echo "Found $point_state_count records in udmi_point_state."

echo "=== Verifying InfluxDB records..."
influx_out=$(udmis/bin/influxctl query --host "http://localhost:$INF_PORT" --token "test-influx-token-12345" --org "bridgehead" 'from(bucket: "home") |> range(start: -10y) |> filter(fn: (r) => r._measurement == "point_value")' 2>/dev/null || true)

if [[ "$influx_out" == *"point_value"* ]]; then
    echo "PASS: Successfully verified point_value records in InfluxDB."
else
    echo "FAIL: No point_value records found in InfluxDB!"
    echo "Query output: $influx_out"
    exit 1
fi

echo "=== All capture pipeline tests passed successfully!"
