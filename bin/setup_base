#!/bin/bash -e

PIP_OPTS="--index-url https://pypi.org/simple"
ROOT_DIR=$(realpath $(dirname $0)/..)
cd $ROOT_DIR

# Packages provided by Alpine system repos where exact pins should be relaxed
ALPINE_RELAX_PACKAGES=(
    cffi
    cryptography
    grpcio
    grpcio-status
)

get_requirements_file() {
    if [[ -n $(which apt-get) ]]; then
        echo "etc/requirements.txt"
        return
    fi

    local req_file="/tmp/requirements_alpine.txt"
    cp etc/requirements.txt "$req_file"
    for pkg in "${ALPINE_RELAX_PACKAGES[@]}"; do
        sed -i "s/^${pkg}==/${pkg}>=/" "$req_file"
    done
    echo "$req_file"
}

if [[ $(id -u) == 0 ]]; then
    if [[ -n $(which apt-get) ]]; then
        apt-get update -y
        update_cmd="apt-get install -y"
        extra_packages=""
    else
        update_cmd="apk add"
        extra_packages="${NO_CACHE_DIR:+--no-cache} linux-headers g++ gcc py3-grpcio py3-cryptography py3-cffi"
    fi
    $update_cmd $extra_packages moreutils expect python3-dev mosquitto mosquitto-clients postgresql postgresql-client tmux
else
    echo "Skipping system package installation in non-root mode (run 'sudo bin/setup_base' to install system packages)."
fi

venv_opts=""
if [[ -z $(which apt-get) ]]; then
    venv_opts="--system-site-packages"
fi

python3 --version
python3 -m venv $venv_opts venv

venv_pip3=$($(dirname $0)/which_venv_pip3)
echo $venv_pip3
$(dirname ${venv_pip3})/python3 -m pip install --upgrade pip $PIP_OPTS
req_src=$(get_requirements_file)
${venv_pip3} install ${NO_CACHE_DIR:+--no-cache-dir} -r "$req_src" $PIP_OPTS

if [[ -z $NO_CACHE_DIR ]]; then
    $(dirname ${venv_pip3})/playwright install chromium
fi

java -version

echo "Initializing base site model..."
$ROOT_DIR/bin/clone_model

if [[ $(id -u) == 0 ]]; then
    if [[ -n ${SUDO_UID:-} && -n ${SUDO_GID:-} ]]; then
        chown -R ${SUDO_UID}:${SUDO_GID} sites venv 2>/dev/null || true
    fi
    chmod -R a+rwX sites venv 2>/dev/null || true
fi
