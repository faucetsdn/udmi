#!/usr/bin/env python3
"""Thin CLI wrapper to analyze a BACnet/IP PCAP or PCAPNG capture file."""

from pathlib import Path
import sys

ROOT_DIR = Path(__file__).resolve().parent.parent
COMMON_PY = ROOT_DIR / "common" / "src" / "main" / "python"
if str(COMMON_PY) not in sys.path:
  sys.path.insert(0, str(COMMON_PY))

# pylint: disable=wrong-import-position
from udmi.common.bacnet_analyzer.__main__ import main

if __name__ == "__main__":
  sys.exit(main())
