#!/bin/bash -e

ROOT=$(dirname $0)/..
# cd $ROOT

source $ROOT/etc/shell_common.sh

if [[ $(id -u) == 0 && -f /etc/mosquitto/dynamic_security.json ]]; then
    echo Checking for properly configured mosquitto...
    fgrep -q scrumptious /etc/mosquitto/dynamic_security.json || (echo mosquitto dynamic security not configured; false)

    echo Checking that mqtt broker is running
    BROKER=$(netstat -nlpa 2>/dev/null | fgrep :1883) || true

    if [[ -n $BROKER ]]; then
        # This is the local address of the previously configured MQTT broker
        export MQTT_TEST_BROKER=tcp://localhost:1883
        echo Using MQTT broker at $MQTT_TEST_BROKER
    fi
fi

# This is the local address for PubSub emulation, created by bin/start_pubsub
[[ ! -f out/pubsub.env ]] || source out/pubsub.env || true
echo Using PubSub emulator at ${PUBSUB_EMULATOR_HOST:-localhost}

$ROOT/udmis/bin/build check
