#!/bin/bash -eu

set -o pipefail

util_name=$(basename $0)
UDMI_ROOT=$(realpath $(dirname $0)/..)

source $UDMI_ROOT/etc/shell_common.sh

OUT_DIR=$UDMI_ROOT/out
mkdir -p $OUT_DIR
rm -f $OUT_DIR/$util_name.log 2>/dev/null || true

[[ ! -d $UDMI_ROOT/validator/src ]] ||
    up_to_date $UDMI_JAR $UDMI_ROOT/validator/src ||
    $UDMI_ROOT/validator/bin/build

JAVA_CLASS=com.google.daq.mqtt.util.Dispatcher

echo starting run at $(date --utc --iso=s)

if [[ ${1:-} == JDWP ]]; then
    JDWP="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"
    shift
else
    JDWP=
fi

if [[ $# -ge 1 && "$1" != -* ]]; then
    target=$1
    if [[ -d "$target" ]]; then
        if [[ $# -ge 2 && "$2" != -* ]]; then
            site_path=$1
            project_spec=$(normalize_conn_spec "$2")
            shift 2
            set -- "$site_path" "$project_spec" "$@"
        fi
    elif [[ -f "$target" ]]; then
        # File argument is solo
        true
    else
        fail "Argument '$target' is neither a file nor a directory"
    fi
fi

if [[ -n "${project_spec:-}" && "$project_spec" =~ localhost: ]]; then
    if [[ -d "${ETC_DIR:-var/mosquitto}" ]]; then
        for i in {1..50}; do
            if [[ -f "${ETC_DIR:-var/mosquitto}/mosquitto.ready" ]]; then
                break
            fi
            sleep 0.2
        done
    fi
fi

cmd="java -cp $UDMI_JAR $JDWP $JAVA_CLASS $util_name $@"
echo $cmd
$cmd 2>&1 | tee $OUT_DIR/$util_name.log
