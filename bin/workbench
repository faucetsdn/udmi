#!/bin/bash
# ==========================================================================
# UDMI Workbench Launcher Script
# ==========================================================================

# Exit on error
set -e

# Resolve the workspace directory (script parent's parent)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(dirname "$SCRIPT_DIR")"
cd "$WORKSPACE_DIR"

# Check if project environment is initialized
if ! bin/which_venv_pip3 > /dev/null 2>&1; then
  echo "Error: Virtual environment not found or not initialized."
  echo "Please run 'bin/setup_base' first to install system dependencies and virtualenv."
  exit 1
fi

# Create or update the ui/version.txt file using git on startup
if command -v git > /dev/null 2>&1 && git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  git rev-parse --short HEAD > ui/version.txt
else
  if [ ! -f ui/version.txt ]; then
    echo "HEAD" > ui/version.txt
  fi
fi

# Parse arguments
VERSION="${UDMI_WORKBENCH_VERSION:-v2}"
if [ "$VERSION" = "1" ] || [ "$VERSION" = "v1" ]; then
  VERSION="v1"
else
  VERSION="v2"
fi

MANUAL_PORT=""
STOP_REQUESTED=false

show_usage() {
  echo "Usage: $0 [--v1 | --v2] [stop] [--port=PORT | -p PORT | PORT]"
  echo ""
  echo "Arguments:"
  echo "  --v1              Launch UDMI Workbench v1 (Classic)"
  echo "  --v2              Launch UDMI Workbench v2 (Modern, Default)"
  echo "  stop              Stop running UDMI Workbench backend server process(es)"
  echo "  --port=N, -p N    Specify custom TCP port (default: 8080)"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --v1)
      VERSION="v1"
      shift
      ;;
    --v2)
      VERSION="v2"
      shift
      ;;
    stop)
      STOP_REQUESTED=true
      shift
      ;;
    --port=*)
      MANUAL_PORT="${1#*=}"
      shift
      ;;
    --port|-p)
      if [ -z "$2" ]; then
        echo "Error: Option '$1' requires a port argument."
        show_usage
        exit 1
      fi
      MANUAL_PORT="$2"
      shift 2
      ;;
    [0-9]*)
      MANUAL_PORT="$1"
      shift
      ;;
    -h|--help)
      show_usage
      exit 0
      ;;
    *)
      echo "Error: Unknown argument '$1'"
      show_usage
      exit 1
      ;;
  esac
done

# Function to stop running UDMI Workbench server on specified port
stop_workbench_server() {
  local target_port="$1"
  echo "Stopping any running UDMI Workbench server instances..."
  
  if [ -n "$target_port" ] && command -v lsof > /dev/null 2>&1; then
    local PIDS=$(lsof -t -i :"${target_port}" 2>/dev/null || true)
    for pid in $PIDS; do
      local cmdline=$(tr '\0' ' ' < /proc/"$pid"/cmdline 2>/dev/null || true)
      if [[ "$cmdline" == *"ui/v2/server.py"* || "$cmdline" == *"ui/v1/server.py"* || "$cmdline" == *"ui/src/server.py"* || "$cmdline" == *"ui/server.py"* ]]; then
        echo "Stopping UDMI Workbench process (PID ${pid}) on port ${target_port}..."
        kill -9 "$pid" 2>/dev/null || true
      else
        echo "Port ${target_port} process (PID ${pid}) is not UDMI Workbench; leaving untouched."
      fi
    done
  else
    # Fallback: kill any remaining python process matching ui workbench servers
    pkill -9 -f "ui/v2/server.py" 2>/dev/null || true
    pkill -9 -f "ui/v1/server.py" 2>/dev/null || true
    pkill -9 -f "ui/src/server.py" 2>/dev/null || true
    pkill -9 -f "ui/server.py" 2>/dev/null || true
  fi

  sleep 0.5
  echo "Workbench server stop check completed."
}

if [ "$STOP_REQUESTED" = true ]; then
  PORT="${MANUAL_PORT:-8080}"
  stop_workbench_server "$PORT"
  exit 0
fi

# Function to check whether port is used by Workbench or non-Workbench process
check_port_owner() {
  local check_port="$1"
  if ! lsof -i :"$check_port" > /dev/null 2>&1; then
    echo "free"
    return
  fi
  
  local pid=$(lsof -t -i :"$check_port" 2>/dev/null | head -n 1 || true)
  if [ -n "$pid" ]; then
    local cmdline=$(tr '\0' ' ' < /proc/"$pid"/cmdline 2>/dev/null || true)
    if [[ "$cmdline" == *"ui/v2/server.py"* || "$cmdline" == *"ui/v1/server.py"* || "$cmdline" == *"ui/src/server.py"* || "$cmdline" == *"ui/server.py"* ]]; then
      echo "workbench"
      return
    fi
  fi
  echo "other"
}

PORT="${MANUAL_PORT:-8080}"
SERVER_RUNNING=true

if [ -n "$MANUAL_PORT" ]; then
  # Manual port specified by user
  PORT_OWNER=$(check_port_owner "$PORT")
  if [ "$PORT_OWNER" = "other" ]; then
    echo "Error: Specified port ${PORT} is occupied by another process (not UDMI Workbench)."
    exit 1
  elif [ "$PORT_OWNER" = "free" ]; then
    SERVER_RUNNING=false
  fi
else
  # Default port 8080 requested: check if occupied by non-workbench process
  PORT_OWNER=$(check_port_owner "$PORT")
  if [ "$PORT_OWNER" = "other" ]; then
    echo "Notice: Default port ${PORT} is being used by another application."
    # Auto-seek next available port
    while [ "$PORT_OWNER" = "other" ]; do
      PORT=$((PORT + 1))
      PORT_OWNER=$(check_port_owner "$PORT")
    done
    
    if [ "$PORT_OWNER" = "free" ]; then
      echo "Selected alternate available port: ${PORT}"
      SERVER_RUNNING=false
    else
      echo "Reusing existing UDMI Workbench running on port ${PORT}"
    fi
  elif [ "$PORT_OWNER" = "free" ]; then
    SERVER_RUNNING=false
  fi
fi

if [ "$SERVER_RUNNING" = false ]; then
  echo "Starting UDMI Workbench ($VERSION) backend server on port ${PORT}..."
  mkdir -p out
  if [ "$VERSION" = "v1" ] && [ -f "ui/v1/server.py" ]; then
    SERVER_SCRIPT="ui/v1/server.py"
  elif [ -f "ui/v2/server.py" ]; then
    SERVER_SCRIPT="ui/v2/server.py"
  elif [ -f "ui/src/server.py" ]; then
    SERVER_SCRIPT="ui/src/server.py"
  else
    SERVER_SCRIPT="ui/server.py"
  fi

  setsid python3 "$SERVER_SCRIPT" --port="${PORT}" > out/workbench_server.log 2>&1 &
  
  # Wait for the server to spin up
  for i in {1..10}; do
    if lsof -i :"${PORT}" > /dev/null 2>&1; then
      break
    fi
    sleep 0.5
  done
  
  if ! lsof -i :"${PORT}" > /dev/null 2>&1; then
    echo "Error: Failed to start the backend server on port ${PORT}. Check logs in out/workbench_server.log"
    exit 1
  fi
  echo "Backend server started successfully on port ${PORT}."
else
  echo "UDMI Workbench backend server is already running on port ${PORT}."
fi

# Build URL
if [ "$VERSION" = "v1" ]; then
  URL="http://localhost:${PORT}/ui/v1/index.html"
else
  URL="http://localhost:${PORT}/ui/v2/index.html"
fi

echo "Opening UDMI Workbench ($VERSION) in your default browser..."
echo "Workbench running at: ${URL}"

if command -v xdg-open > /dev/null 2>&1; then
  xdg-open "$URL" > /dev/null 2>&1 &
elif command -v open > /dev/null 2>&1; then
  open "$URL" > /dev/null 2>&1 &
elif command -v python3 > /dev/null 2>&1; then
  python3 -m webbrowser "$URL" > /dev/null 2>&1 &
fi
