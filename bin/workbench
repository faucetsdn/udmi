#!/bin/bash
# ==========================================================================
# UDMI Workbench Launcher Script
# ==========================================================================

# Exit on error
set -e

# Resolve the workspace directory (script parent's parent)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(dirname "$SCRIPT_DIR")"
cd "$WORKSPACE_DIR"

# Check if project environment is initialized
if ! bin/which_venv_pip3 > /dev/null 2>&1; then
  echo "Error: Virtual environment not found or not initialized."
  echo "Please run 'bin/setup_base' first to install system dependencies and virtualenv."
  exit 1
fi

# Create or update the ui/version.txt file using git on startup
if command -v git > /dev/null 2>&1 && git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  git rev-parse --short HEAD > ui/version.txt
else
  if [ ! -f ui/version.txt ]; then
    echo "HEAD" > ui/version.txt
  fi
fi

# Parse arguments
FEATURE="all"
MANUAL_PORT=""

show_usage() {
  echo "Usage: $0 [testbed | sequencer | mantis | all] [--port=PORT | -p PORT | PORT]"
  echo ""
  echo "Arguments:"
  echo "  testbed, tb       Launch with Testbed tool only"
  echo "  sequencer, seq    Launch with Sequencer tool only"
  echo "  mantis, man       Launch with Mantis tool only"
  echo "  all, suite        Launch with all tools (default)"
  echo "  --port=N, -p N    Specify custom TCP port (default: 8080)"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    testbed|tb)
      FEATURE="testbed"
      shift
      ;;
    sequencer|seq)
      FEATURE="sequencer"
      shift
      ;;
    mantis|man)
      FEATURE="mantis"
      shift
      ;;
    all|suite)
      FEATURE="all"
      shift
      ;;
    --port=*)
      MANUAL_PORT="${1#*=}"
      shift
      ;;
    --port|-p)
      if [ -z "$2" ]; then
        echo "Error: Option '$1' requires a port argument."
        show_usage
        exit 1
      fi
      MANUAL_PORT="$2"
      shift 2
      ;;
    [0-9]*)
      MANUAL_PORT="$1"
      shift
      ;;
    -h|--help)
      show_usage
      exit 0
      ;;
    *)
      echo "Error: Unknown argument '$1'"
      show_usage
      exit 1
      ;;
  esac
done

# Determine backend features parameter
if [ "$FEATURE" = "all" ]; then
  FEATURES_PARAM="testbed,sequencer,mantis"
else
  FEATURES_PARAM="$FEATURE"
fi

# Function to check whether port is used by Workbench or non-Workbench process
check_port_owner() {
  local check_port="$1"
  if ! lsof -i :"$check_port" > /dev/null 2>&1; then
    echo "free"
    return
  fi
  
  local pid=$(lsof -t -i :"$check_port" 2>/dev/null | head -n 1 || true)
  if [ -n "$pid" ]; then
    local cmdline=$(tr '\0' ' ' < /proc/"$pid"/cmdline 2>/dev/null || true)
    if [[ "$cmdline" == *"ui/src/server.py"* ]]; then
      echo "workbench"
      return
    fi
  fi
  echo "other"
}

PORT="${MANUAL_PORT:-8080}"
SERVER_RUNNING=true
RESTART_NEEDED=false

if [ -n "$MANUAL_PORT" ]; then
  # Manual port specified by user
  PORT_OWNER=$(check_port_owner "$PORT")
  if [ "$PORT_OWNER" = "other" ]; then
    echo "Error: Specified port ${PORT} is occupied by another process (not UDMI Workbench)."
    exit 1
  elif [ "$PORT_OWNER" = "free" ]; then
    SERVER_RUNNING=false
  fi
else
  # Default port 8080 requested: check if occupied by non-workbench process
  PORT_OWNER=$(check_port_owner "$PORT")
  if [ "$PORT_OWNER" = "other" ]; then
    echo "Notice: Default port ${PORT} is being used by another application."
    # Auto-seek next available port
    while [ "$PORT_OWNER" = "other" ]; do
      PORT=$((PORT + 1))
      PORT_OWNER=$(check_port_owner "$PORT")
    done
    
    if [ "$PORT_OWNER" = "free" ]; then
      echo "Selected alternate available port: ${PORT}"
      SERVER_RUNNING=false
    else
      echo "Reusing existing UDMI Workbench running on port ${PORT}"
    fi
  elif [ "$PORT_OWNER" = "free" ]; then
    SERVER_RUNNING=false
  fi
fi

if [ "$SERVER_RUNNING" = true ]; then
  # Server is running on $PORT, check active features
  RUNNING_FEATURES=$(curl -s --max-time 1 "http://localhost:${PORT}/api/features" | tr -d '[]" ' || echo "")
  NORM_RUNNING=$(echo "$RUNNING_FEATURES" | tr ',' '\n' | sort | tr '\n' ',' | sed 's/,$//')
  NORM_REQUESTED=$(echo "$FEATURES_PARAM" | tr ',' '\n' | sort | tr '\n' ',' | sed 's/,$//')
  
  if [ "$NORM_RUNNING" != "$NORM_REQUESTED" ]; then
    echo "UDMI Workbench server on port ${PORT} is running with different features (${RUNNING_FEATURES:-unknown})."
    RESTART_NEEDED=true
  fi
fi

if [ "$SERVER_RUNNING" = false ] || [ "$RESTART_NEEDED" = true ]; then
  if [ "$RESTART_NEEDED" = true ]; then
    echo "Restarting backend server on port ${PORT} with requested features (${FEATURES_PARAM})..."
    bin/stop_workbench --port="${PORT}"
  else
    echo "Starting UDMI Workbench backend server on port ${PORT}..."
  fi
  
  mkdir -p out
  setsid python3 ui/src/server.py --port="${PORT}" --features="${FEATURES_PARAM}" > out/workbench_server.log 2>&1 &
  
  # Wait for the server to spin up
  for i in {1..10}; do
    if lsof -i :"${PORT}" > /dev/null 2>&1; then
      break
    fi
    sleep 0.5
  done
  
  if ! lsof -i :"${PORT}" > /dev/null 2>&1; then
    echo "Error: Failed to start the backend server on port ${PORT}. Check logs in out/workbench_server.log"
    exit 1
  fi
  echo "Backend server started successfully on port ${PORT}."
else
  echo "UDMI Workbench backend server is already running on port ${PORT} with the correct feature set."
fi

# Build URL (Purely backend feature flag construct; no URL parameters)
URL="http://localhost:${PORT}/ui/src/index.html"

echo "Opening UDMI Workbench (${FEATURE}) in your default browser..."
echo "Workbench running at: ${URL}"

if command -v xdg-open > /dev/null 2>&1; then
  xdg-open "$URL" > /dev/null 2>&1 &
elif command -v open > /dev/null 2>&1; then
  open "$URL" > /dev/null 2>&1 &
elif command -v python3 > /dev/null 2>&1; then
  python3 -m webbrowser "$URL" > /dev/null 2>&1 &
fi
