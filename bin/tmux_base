#!/bin/bash -e
# Tmux-encapsulated controller for Base (certs, clone)

UDMI_ROOT=$(dirname $(realpath $0))/..
source $UDMI_ROOT/etc/tmux_common.sh

SESSION_NAME="udmi_base"
ALLOWED_SERVICES=(certs clone)

parse_tmux_args "$@"
tmux_validate_services "Base" "${ALLOWED_SERVICES[@]}"

case "$TMUX_ACTION" in
    stop)
        tmux_stop_session "$SESSION_NAME"
        ;;
    status)
        tmux_session_status "$SESSION_NAME"
        ;;
    logs)
        tmux_capture_logs "$SESSION_NAME" "$TMUX_TARGET_ID" "${TMUX_EXTRA_ARGS[0]:-50}"
        ;;
    attach)
        tmux_attach_session "$SESSION_NAME" "$TMUX_TARGET_ID"
        ;;
    start)
        echo "=== Initializing Base in tmux session '$SESSION_NAME' ==="
        echo "Site Model:   $TMUX_SITE_MODEL"
        echo "Project Spec: $TMUX_PROJECT_SPEC"

        cd "$UDMI_ROOT"

        # 1. Clone (optional / setup: ++clone)
        if tmux_should_run_service "clone" "true"; then
            tmux_init_or_add_window "$SESSION_NAME" "clone" "bin/clone_model '$TMUX_SITE_MODEL'"
        fi

        # 2. Certs / Keygen (default: enabled)
        if tmux_should_run_service "certs"; then
            tmux_init_or_add_window "$SESSION_NAME" "certs" "bin/setup_ca '$TMUX_SITE_MODEL' localhost"
        fi

        echo "Base session '$SESSION_NAME' initialized."
        tmux_session_status "$SESSION_NAME"
        ;;
    *)
        echo "Unknown action '$TMUX_ACTION'. Usage: $0 [start|stop|status|logs|attach] [site_model] [project_spec] [+only | !exclude | ++optional]"
        exit 1
        ;;
esac
