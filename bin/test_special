#!/bin/bash -e

UDMI_ROOT=$(dirname $0)/..
cd $UDMI_ROOT

source etc/shell_common.sh

[[ $# == 1 ]] || usage PROJECT_SPEC

project_spec=$1
shift
site_path=sites/udmi_site_model
device_id=AHU-1
serial_no=192842
device_out=$site_path/out/devices/$device_id

pubber_bg $device_id

rm -rf $device_out

# Run with trace enabled to capture all intermediate messages
bin/sequencer -vv -s $serial_no $site_path $project_spec $device_id broken_config

# Check that the message captures for broken_config contain the raw (extracted) message payload"
echo
echo Checking broken_config capture results...
fgrep "RESULT pass system broken_config" $device_out/RESULT.log
find $device_out -name \*.attr | xargs fgrep "While converting string"
fgrep "{ broken by" -r $device_out/tests/broken_config/trace

echo
echo Checking config query functionality...
query_out=$device_out/query_test.json
bin/reset_config $site_path $project_spec $device_id query $query_out
fgrep '"version"' $query_out

# TODO: UDMIS bug - UDMIS currently returns a synthesized state ({"configAcked":false})
# instead of an error when querying a non-existent device. Uncomment this test once fixed.
# echo Checking config query for non-existent device...
# if bin/reset_config $site_path $project_spec INVALID-DEVICE-123 query > /dev/null 2>&1; then
#     fail "Querying a non-existent device should have failed!"
# else
#     echo "Failed as expected."
# fi

echo
echo Done with special sequence tests.
echo
