#!/bin/bash -e

# UUFI Test Client Logic
# Performs: Handshake -> Config Update (+ Same-Channel Ack & State Reply) ->
#           Single-Channel Null Query -> Control Error Reply -> System Model Update

UDMI_ROOT=$(dirname $0)/..
cd ${UDMI_ROOT}
source etc/shell_common.sh

HOST=${1:-localhost}
PORT=${2:-8883}
USER=${3:-rocket}
PASS=${4:-monkey}
CLIENT_ID="uufi-test-client"
SITE_MODEL=${5:-sites/udmi_site_model}
TXN_ID="TXN-$(date +%s)"
DUT_ID="AHU-1"
REGISTRY_ID="ZZ-TRI-FECTA"

CA_CERT="$SITE_MODEL/reflector/ca.crt"
echo "Waiting for non-empty CA certificate $CA_CERT..."
TIMEOUT=60
while [[ (! -f $CA_CERT || ! -s $CA_CERT) && $TIMEOUT -gt 0 ]]; do
    sleep 1
    TIMEOUT=$((TIMEOUT - 1))
done

MQTT_ARGS="-h $HOST -p $PORT -u $USER -P $PASS --cafile $CA_CERT --cert $SITE_MODEL/reflector/rsa_private.crt --key $SITE_MODEL/reflector/rsa_private.pem --insecure"

BG_PIDS=()
TEMP_FILES=()
METADATA_FILE="$SITE_MODEL/devices/$DUT_ID/metadata.json"

restore_metadata() {
    if [[ -f "${METADATA_FILE}.bak" ]]; then
        mv "${METADATA_FILE}.bak" "$METADATA_FILE" 2>/dev/null || true
    fi
}

create_fifo() {
    local _f
    _f=$(mktemp -u "${TMPDIR:-/tmp}/uufi_fifo.XXXXXX")
    mkfifo "$_f"
    TEMP_FILES+=("$_f")
    printf -v "$1" '%s' "$_f"
}

stop_watcher() {
    local pid
    for pid in "$@"; do
        [[ -z "$pid" ]] && continue
        kill "$pid" 2>/dev/null || true
    done
    for pid in "$@"; do
        [[ -z "$pid" ]] && continue
        wait "$pid" 2>/dev/null || true
    done
}

cleanup() {
    restore_metadata
    for pid in "${BG_PIDS[@]}"; do
        kill "$pid" 2>/dev/null || true
    done
    rm -f "${TEMP_FILES[@]}"
}
trap cleanup EXIT

# 1. UUFI Handshake
REPLY_FILE=$(mktemp)
TEMP_FILES+=("$REPLY_FILE")
create_fifo HS_FIFO
mosquitto_sub $MQTT_ARGS -i "${CLIENT_ID}_hs_sub" -t "/uufi/c/config/udmi" -F "%p" > "$HS_FIFO" &
HS_MOSQ_PID=$!
BG_PIDS+=("$HS_MOSQ_PID")
(
    while read -r line; do
        echo "$line" > "$REPLY_FILE"
        REPLY_TXN=$(jq -r .payload.reply.transaction_id < "$REPLY_FILE" 2>/dev/null)
        REPLY_PRINCIPAL=$(jq -r .principal < "$REPLY_FILE" 2>/dev/null)
        REPLY_SOURCE=$(jq -r .source < "$REPLY_FILE" 2>/dev/null)
        if [[ "$REPLY_TXN" == "$TXN_ID" ]]; then
            if [[ "$REPLY_PRINCIPAL" != "$CLIENT_ID" ]]; then
                echo "ERROR: Expected principal $CLIENT_ID in handshake reply but got $REPLY_PRINCIPAL" >&2
                exit 1
            fi
            if [[ "$REPLY_SOURCE" != "udmis" ]]; then
                echo "ERROR: Expected source udmis in handshake reply but got $REPLY_SOURCE" >&2
                exit 1
            fi
            kill -USR1 $$ 2>/dev/null || true
            exit 0
        fi
    done < "$HS_FIFO"
) &
SUB_PID=$!
BG_PIDS+=("$SUB_PID")

GOT_HANDSHAKE=0
trap "GOT_HANDSHAKE=1" USR1
sleep 2

echo "Sending UUFI handshake Step 1 (State Declaration)... (txn: $TXN_ID)"
HANDSHAKE_STATE="{\"subType\":\"state\",\"subFolder\":\"udmi\",\"version\":\"1.5.7\",\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"setup\":{\"functions_ver\":9,\"transaction_id\":\"$TXN_ID\",\"msg_source\":\"$CLIENT_ID\"}}"
echo "Handshake payload: $HANDSHAKE_STATE"
mosquitto_pub $MQTT_ARGS -i "${CLIENT_ID}_hs_pub" -t "/uufi/c/state/udmi" -m "$HANDSHAKE_STATE"

TIMEOUT=30
while [ $GOT_HANDSHAKE -eq 0 ] && [ $TIMEOUT -gt 0 ]; do
    echo "Waiting for handshake reply... ($TIMEOUT)"
    sleep 1
    TIMEOUT=$((TIMEOUT - 1))
done

stop_watcher "$HS_MOSQ_PID" "$SUB_PID"
if [ $GOT_HANDSHAKE -eq 0 ]; then
    echo "Timed out waiting for handshake reply (txn: $TXN_ID)"
    exit 1
fi
echo "Handshake SUCCESS"

# 2. Comprehensive Exchange (Config Update -> Same-Channel Success Ack + State Reply)
echo "Starting comprehensive exchange test..."
CFG_TXN_ID="${TXN_ID}-cfg"
CFG_ACK_FILE=$(mktemp)
STATE_REPLY_FILE=$(mktemp)
TEMP_FILES+=("$CFG_ACK_FILE" "$STATE_REPLY_FILE")

echo "Subscribing to /uufi/r/$REGISTRY_ID/d/$DUT_ID/c/config/pointset for Success Ack..."
create_fifo ACK_FIFO
mosquitto_sub $MQTT_ARGS -i "${CLIENT_ID}_ack_sub" -t "/uufi/r/$REGISTRY_ID/d/$DUT_ID/c/config/pointset" -F "%p" > "$ACK_FIFO" &
ACK_MOSQ_PID=$!
BG_PIDS+=("$ACK_MOSQ_PID")
(
    while read -r line; do
        ACK_SOURCE=$(echo "$line" | jq -r '.source // empty' 2>/dev/null || true)
        ACK_TXN=$(echo "$line" | jq -r '.transactionId // empty' 2>/dev/null || true)
        if [[ "$ACK_SOURCE" == "udmis" && "$ACK_TXN" == "$CFG_TXN_ID" ]]; then
            echo "$line" > "$CFG_ACK_FILE"
            ACK_PRINCIPAL=$(jq -r '.principal // empty' < "$CFG_ACK_FILE" 2>/dev/null || true)
            ACK_SETVAL=$(jq -r '.payload.points.filter_differential_pressure_setpoint.set_value // empty' < "$CFG_ACK_FILE" 2>/dev/null || true)
            if [[ "$ACK_PRINCIPAL" != "$CLIENT_ID" ]]; then
                echo "ERROR: Expected principal $CLIENT_ID in config ack but got $ACK_PRINCIPAL" >&2
                exit 1
            fi
            if [[ "$ACK_SETVAL" != "42" ]]; then
                echo "ERROR: Expected set_value 42 in config ack but got $ACK_SETVAL" >&2
                exit 1
            fi
            echo "Received same-channel Config Success Ack from udmis!"
            kill -USR1 $$ 2>/dev/null || true
            exit 0
        fi
    done < "$ACK_FIFO"
) &
SUB_ACK_PID=$!
BG_PIDS+=("$SUB_ACK_PID")

echo "Subscribing to /uufi/r/$REGISTRY_ID/d/$DUT_ID/c/state/pointset..."
create_fifo STATE_FIFO
mosquitto_sub $MQTT_ARGS -i "${CLIENT_ID}_sub" -t "/uufi/r/$REGISTRY_ID/d/$DUT_ID/c/state/pointset" -F "%p" > "$STATE_FIFO" &
STATE_MOSQ_PID=$!
BG_PIDS+=("$STATE_MOSQ_PID")
(
    while read -r line; do
        echo "Received UUFI state update: $line"
        echo "$line" > "$STATE_REPLY_FILE"
        VALUE_STATE=$(jq -r .payload.points.filter_differential_pressure_setpoint.value_state < "$STATE_REPLY_FILE" 2>/dev/null)
        STATE_SOURCE=$(jq -r .source < "$STATE_REPLY_FILE" 2>/dev/null)
        if [[ "$VALUE_STATE" == "applied" ]]; then
            if [[ "$STATE_SOURCE" != "udmis" ]]; then
                echo "ERROR: Expected source udmis in state reply but got $STATE_SOURCE" >&2
                exit 1
            fi
            echo "Found expected value_state applied with source udmis!"
            kill -USR2 $$ 2>/dev/null || true
            exit 0
        fi
    done < "$STATE_FIFO"
) &
SUB_STATE_PID=$!
BG_PIDS+=("$SUB_STATE_PID")

GOT_CFG_ACK=0
GOT_STATE=0
trap "GOT_CFG_ACK=1" USR1
trap "GOT_STATE=1" USR2
sleep 2

echo "Sending UUFI-wrapped Config Update for $DUT_ID..."
NOW_TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
NEW_CONFIG="{\"subType\":\"config\",\"subFolder\":\"pointset\",\"deviceId\":\"$DUT_ID\",\"deviceRegistryId\":\"$REGISTRY_ID\",\"projectId\":\"vibrant\",\"transactionId\":\"$CFG_TXN_ID\",\"publishTime\":\"$NOW_TS\",\"source\":\"$CLIENT_ID\",\"principal\":\"$CLIENT_ID\",\"payload\":{\"version\":\"1.5.7\",\"timestamp\":\"$NOW_TS\",\"points\":{\"filter_differential_pressure_setpoint\":{\"set_value\":42}}}}"
echo "Config update payload: $NEW_CONFIG"
mosquitto_pub $MQTT_ARGS -i "${CLIENT_ID}_pub" -t "/uufi/r/$REGISTRY_ID/d/$DUT_ID/c/config/pointset" -m "$NEW_CONFIG"

echo "Waiting for Config Success Ack and State Update reply from $DUT_ID through UUFI..."
TIMEOUT=60
while ([ $GOT_CFG_ACK -eq 0 ] || [ $GOT_STATE -eq 0 ]) && [ $TIMEOUT -gt 0 ]; do
    echo "Waiting for config ack ($GOT_CFG_ACK) and state update ($GOT_STATE)... ($TIMEOUT)"
    sleep 1
    TIMEOUT=$((TIMEOUT - 1))
done

stop_watcher "$ACK_MOSQ_PID" "$SUB_ACK_PID" "$STATE_MOSQ_PID" "$SUB_STATE_PID"

if [ $GOT_CFG_ACK -eq 0 ]; then
    echo "Timed out waiting for same-channel Config Success Ack (txn: $CFG_TXN_ID)"
    exit 1
fi

if [ $GOT_STATE -eq 0 ]; then
    echo "Timed out waiting for State Update reply"
    if [[ -f "$STATE_REPLY_FILE" && -s "$STATE_REPLY_FILE" ]]; then
        echo "=== DIAGNOSTIC: Last received state update ==="
        cat "$STATE_REPLY_FILE"
        echo "=============================================="
    else
        echo "DIAGNOSTIC: No state update replies were received at all."
    fi
    exit 1
fi

echo "Comprehensive Exchange SUCCESS: Received Config Ack and matching state update"

# 2b. Single-Channel Query (payload: null)
echo "Starting single-channel null-payload Query test..."
QUERY_TXN_ID="${TXN_ID}-qry"
QUERY_REPLY_FILE=$(mktemp)
TEMP_FILES+=("$QUERY_REPLY_FILE")
create_fifo QRY_FIFO
mosquitto_sub $MQTT_ARGS -i "${CLIENT_ID}_qry_sub" -t "/uufi/r/$REGISTRY_ID/d/$DUT_ID/c/config/pointset" -F "%p" > "$QRY_FIFO" &
QRY_MOSQ_PID=$!
BG_PIDS+=("$QRY_MOSQ_PID")
(
    while read -r line; do
        Q_SOURCE=$(echo "$line" | jq -r '.source // empty' 2>/dev/null || true)
        Q_TXN=$(echo "$line" | jq -r '.transactionId // empty' 2>/dev/null || true)
        if [[ "$Q_SOURCE" == "udmis" && "$Q_TXN" == "$QUERY_TXN_ID" ]]; then
            echo "$line" > "$QUERY_REPLY_FILE"
            Q_PRINCIPAL=$(jq -r '.principal // empty' < "$QUERY_REPLY_FILE" 2>/dev/null || true)
            Q_SETVAL=$(jq -r '.payload.points.filter_differential_pressure_setpoint.set_value // empty' < "$QUERY_REPLY_FILE" 2>/dev/null || true)
            if [[ "$Q_PRINCIPAL" != "$CLIENT_ID" || "$Q_SETVAL" != "42" ]]; then
                echo "ERROR: Unexpected query reply: $line" >&2
                exit 1
            fi
            echo "Single-channel Query SUCCESS!"
            kill -USR1 $$ 2>/dev/null || true
            exit 0
        fi
    done < "$QRY_FIFO"
) &
SUB_QRY_PID=$!
BG_PIDS+=("$SUB_QRY_PID")

GOT_QUERY=0
trap "GOT_QUERY=1" USR1
sleep 2

NOW_TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
QUERY_MSG="{\"subType\":\"config\",\"subFolder\":\"pointset\",\"deviceId\":\"$DUT_ID\",\"deviceRegistryId\":\"$REGISTRY_ID\",\"projectId\":\"vibrant\",\"transactionId\":\"$QUERY_TXN_ID\",\"publishTime\":\"$NOW_TS\",\"source\":\"$CLIENT_ID\",\"principal\":\"$CLIENT_ID\",\"payload\":null}"
mosquitto_pub $MQTT_ARGS -i "${CLIENT_ID}_qry_pub" -t "/uufi/r/$REGISTRY_ID/d/$DUT_ID/c/config/pointset" -m "$QUERY_MSG"

TIMEOUT=20
while [ $GOT_QUERY -eq 0 ] && [ $TIMEOUT -gt 0 ]; do
    sleep 1
    TIMEOUT=$((TIMEOUT - 1))
done
stop_watcher "$QRY_MOSQ_PID" "$SUB_QRY_PID"
if [ $GOT_QUERY -eq 0 ]; then
    echo "Timed out waiting for single-channel Query reply (txn: $QUERY_TXN_ID)"
    exit 1
fi

# 2c. Control-Plane Error Reply (unsupported string sentinel -> UufiControl level 500)
echo "Starting Control-Plane Error Reply test..."
ERR_TXN_ID="${TXN_ID}-err"
ERR_REPLY_FILE=$(mktemp)
TEMP_FILES+=("$ERR_REPLY_FILE")
create_fifo ERR_FIFO
mosquitto_sub $MQTT_ARGS -i "${CLIENT_ID}_err_sub" -t "/uufi/r/$REGISTRY_ID/d/$DUT_ID/c/config/pointset" -F "%p" > "$ERR_FIFO" &
ERR_MOSQ_PID=$!
BG_PIDS+=("$ERR_MOSQ_PID")
(
    while read -r line; do
        E_SOURCE=$(echo "$line" | jq -r '.source // empty' 2>/dev/null || true)
        E_TXN=$(echo "$line" | jq -r '.transactionId // empty' 2>/dev/null || true)
        if [[ "$E_SOURCE" == "udmis" && "$E_TXN" == "$ERR_TXN_ID" ]]; then
            echo "$line" > "$ERR_REPLY_FILE"
            E_PRINCIPAL=$(jq -r '.principal // empty' < "$ERR_REPLY_FILE" 2>/dev/null || true)
            E_LEVEL=$(jq -r '.payload.control.status.level // empty' < "$ERR_REPLY_FILE" 2>/dev/null || true)
            if [[ "$E_PRINCIPAL" != "$CLIENT_ID" || "$E_LEVEL" != "500" ]]; then
                echo "ERROR: Expected UufiControl level 500 error reply, got: $line" >&2
                exit 1
            fi
            echo "Control-Plane Error Reply SUCCESS (level=500): $(cat "$ERR_REPLY_FILE")"
            kill -USR1 $$ 2>/dev/null || true
            exit 0
        fi
    done < "$ERR_FIFO"
) &
SUB_ERR_PID=$!
BG_PIDS+=("$SUB_ERR_PID")

GOT_ERR=0
trap "GOT_ERR=1" USR1
sleep 2

NOW_TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
BAD_SENTINEL_MSG="{\"subType\":\"config\",\"subFolder\":\"pointset\",\"deviceId\":\"$DUT_ID\",\"deviceRegistryId\":\"$REGISTRY_ID\",\"projectId\":\"vibrant\",\"transactionId\":\"$ERR_TXN_ID\",\"publishTime\":\"$NOW_TS\",\"source\":\"$CLIENT_ID\",\"principal\":\"$CLIENT_ID\",\"payload\":\"unsupported_sentinel\"}"
mosquitto_pub $MQTT_ARGS -i "${CLIENT_ID}_err_pub" -t "/uufi/r/$REGISTRY_ID/d/$DUT_ID/c/config/pointset" -m "$BAD_SENTINEL_MSG"

TIMEOUT=20
while [ $GOT_ERR -eq 0 ] && [ $TIMEOUT -gt 0 ]; do
    sleep 1
    TIMEOUT=$((TIMEOUT - 1))
done
stop_watcher "$ERR_MOSQ_PID" "$SUB_ERR_PID"
if [ $GOT_ERR -eq 0 ]; then
    echo "Timed out waiting for Control-Plane Error Reply (txn: $ERR_TXN_ID)"
    exit 1
fi

# 3. System Model Write Rejection Test (inbound model/system write -> UufiControl level 500)
echo "Starting System Model Write Rejection test..."
cp "$METADATA_FILE" "${METADATA_FILE}.bak"

MODEL_REPLY_FILE=$(mktemp)
TEMP_FILES+=("$MODEL_REPLY_FILE")
echo "Subscribing to /uufi/r/$REGISTRY_ID/d/$DUT_ID/c/model/system..."
create_fifo MODEL_FIFO
mosquitto_sub $MQTT_ARGS -i "${CLIENT_ID}_model_sub" -t "/uufi/r/$REGISTRY_ID/d/$DUT_ID/c/model/system" -F "%p" > "$MODEL_FIFO" &
MODEL_MOSQ_PID=$!
BG_PIDS+=("$MODEL_MOSQ_PID")
(
    while read -r line; do
        MODEL_SOURCE=$(echo "$line" | jq -r '.source // empty' 2>/dev/null || true)
        MODEL_PRINCIPAL=$(echo "$line" | jq -r '.principal // empty' 2>/dev/null || true)
        if [[ "$MODEL_SOURCE" == "udmis" && "$MODEL_PRINCIPAL" == "site_trigger" ]]; then
            echo "Received UUFI System Model reply: $line"
            echo "$line" > "$MODEL_REPLY_FILE"
            MODEL_LEVEL=$(jq -r '.payload.control.status.level // empty' < "$MODEL_REPLY_FILE" 2>/dev/null || true)
            if [[ "$MODEL_LEVEL" != "500" ]]; then
                echo "ERROR: Expected UufiControl level 500 rejection for model write, got: $line" >&2
                exit 1
            fi
            echo "Received expected level-500 Control Ack rejecting inbound model/system write!"
            kill -USR1 $$ 2>/dev/null || true
            exit 0
        fi
    done < "$MODEL_FIFO"
) &
SUB_MODEL_PID=$!
BG_PIDS+=("$SUB_MODEL_PID")

GOT_MODEL=0
trap "GOT_MODEL=1" USR1
sleep 2

echo "Triggering System Model write using site_trigger..."
$UDMI_ROOT/bin/site_trigger update "$SITE_MODEL" "$DUT_ID" "system_firmware" "v3" "mqtt://$USER:$PASS@$HOST:$PORT"

echo "Waiting for System Model Write Control Ack on the bus..."
TIMEOUT=30
while [ $GOT_MODEL -eq 0 ] && [ $TIMEOUT -gt 0 ]; do
    echo "Waiting for system model write control ack... ($TIMEOUT)"
    sleep 1
    TIMEOUT=$((TIMEOUT - 1))
done

stop_watcher "$MODEL_MOSQ_PID" "$SUB_MODEL_PID"
if [ $GOT_MODEL -eq 0 ]; then
    echo "Timed out waiting for System Model Write Control Ack"
    if [[ -f "$MODEL_REPLY_FILE" && -s "$MODEL_REPLY_FILE" ]]; then
        echo "=== DIAGNOSTIC: Last received system model reply ==="
        cat "$MODEL_REPLY_FILE"
        echo "=============================================="
    else
        echo "DIAGNOSTIC: No system model replies were received at all."
    fi
    exit 1
fi

restore_metadata
echo "System Model Write Rejection SUCCESS: Received level-500 Control Ack on bus"

echo "UUFI Comprehensive Integration Test PASSED"
