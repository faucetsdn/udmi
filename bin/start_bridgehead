#!/bin/bash -e

UDMI_ROOT=$(dirname $(realpath $0))/..
INVOCATION_DIR="$PWD"

source $UDMI_ROOT/etc/shell_common.sh

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: $(basename $0) [--local|--from-workspace | --version <tag>] [site_model_path] [docker-compose-options...]"
    echo ""
    echo "Prepares prerequisites (certificates, .env, directories),"
    echo "brings up the UDMI Bridgehead architecture using Docker Compose,"
    echo "and waits until the UDMIS service is ready."
    echo ""
    echo "Options / Arguments:"
    echo "  --local, --from-workspace Build base container images (udmis, validator, pubber)"
    echo "                          from local workspace source instead of using ghcr.io latest."
    echo "  --version <tag>         Pin ghcr.io/faucetsdn/udmi/{udmis,validator,pubber} base"
    echo "                          images to a specific release tag (e.g., 1.5.6 or latest)."
    echo "                          Mutually exclusive with --local/--from-workspace."
    echo "  site_model_path         (Optional) Path to site model directory."
    echo "                          Overrides SITE_MODEL_PATH env variable."
    echo "  -h, --help              Show this help message and exit."
    echo ""
    echo "Environment Variables:"
    echo "  SITE_MODEL_PATH         Path to site model directory (default: sites/udmi_site_model)."
    echo "  UDMIS_BASE_IMAGE        Base image for udmis (default: ghcr.io/faucetsdn/udmi/udmis:latest)."
    echo "  VALIDATOR_BASE_IMAGE    Base image for validator (default: ghcr.io/faucetsdn/udmi/validator:latest)."
    echo ""
    echo "Examples:"
    echo "  $(basename $0)                             # Default: uses ghcr.io latest images"
    echo "  $(basename $0) --version 1.5.6             # Pin Bridgehead to UDMI release tag 1.5.6"
    echo "  $(basename $0) --local                     # Build base images from workspace source"
    echo "  $(basename $0) --local sites/udmi_site_model"
    exit 0
fi

# Parse options
LOCAL_BUILD=false
UDMI_VERSION=""
SITE_MODEL_ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --local|--from-workspace)
            LOCAL_BUILD=true
            shift
            ;;
        --version)
            [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || fail "Option --version requires a <tag> argument (e.g., --version 1.5.6)."
            UDMI_VERSION="$2"
            shift 2
            ;;
        --version=*)
            fail "Non-canonical syntax '$1'. Use '--version <tag>' (space-separated)."
            ;;
        *)
            if [[ -z "$SITE_MODEL_ARG" && "$1" != -* ]]; then
                SITE_MODEL_ARG="$1"
                shift
            else
                break
            fi
            ;;
    esac
done

if [[ "$LOCAL_BUILD" == "true" && -n "$UDMI_VERSION" ]]; then
    fail "Options --local/--from-workspace and --version cannot be used together."
fi

if [[ -n "$UDMI_VERSION" ]]; then
    if [[ ! "$UDMI_VERSION" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$ ]]; then
        fail "Invalid UDMI version tag '$UDMI_VERSION'."
    fi
    if [[ -n "${UDMIS_BASE_IMAGE:-}" || -n "${VALIDATOR_BASE_IMAGE:-}" || -n "${PUBBER_IMAGE:-}" ]]; then
        fail "Option --version cannot be combined with explicit UDMIS_BASE_IMAGE, VALIDATOR_BASE_IMAGE, or PUBBER_IMAGE overrides."
    fi
    export UDMIS_BASE_IMAGE="ghcr.io/faucetsdn/udmi/udmis:${UDMI_VERSION}"
    export VALIDATOR_BASE_IMAGE="ghcr.io/faucetsdn/udmi/validator:${UDMI_VERSION}"
    export PUBBER_IMAGE="ghcr.io/faucetsdn/udmi/pubber:${UDMI_VERSION}"
fi

# Resolve site model path from positional argument or environment variable
if [[ -n "$SITE_MODEL_ARG" ]]; then
    SITE_MODEL_PATH="$SITE_MODEL_ARG"
fi

if [[ -n "${SITE_MODEL_PATH:-}" ]]; then
    if [[ "$SITE_MODEL_PATH" != /* ]]; then
        SITE_MODEL_PATH="$INVOCATION_DIR/$SITE_MODEL_PATH"
    fi
    SITE_MODEL_PATH=$(realpath -m "$SITE_MODEL_PATH")
else
    SITE_MODEL_PATH="$UDMI_ROOT/sites/udmi_site_model"
fi
export SITE_MODEL_PATH

if [[ ! -d "$SITE_MODEL_PATH" ]]; then
    fail "Site model directory '$SITE_MODEL_PATH' does not exist."
fi

# Verify Docker CLI, daemon access, and Compose plugin before modifying host state
if ! command -v docker >/dev/null 2>&1; then
    fail "Docker CLI ('docker') is not installed or not in PATH. Install Docker Engine and the Docker Compose plugin."
fi

# Capture stderr only on failure; discard normal stdout
if ! DOCKER_INFO_ERR=$(docker info 2>&1 >/dev/null); then
    echo "$DOCKER_INFO_ERR" >&2
    fail "Cannot connect to the Docker daemon. Ensure Docker is running and your user is in the 'docker' group (run 'sudo groupadd -f docker && sudo usermod -aG docker \"\$USER\"', then log out and log back in so 'docker info' succeeds without sudo)."
fi

if ! docker compose version >/dev/null 2>&1; then
    fail "Docker Compose plugin ('docker compose') is not available. Install the Docker Compose plugin."
fi

if [[ -n "$UDMI_VERSION" ]]; then
    for img in "$UDMIS_BASE_IMAGE" "$VALIDATOR_BASE_IMAGE"; do
        if ! docker image inspect "$img" >/dev/null 2>&1; then
            echo "Pulling pinned base image $img..."
            if ! docker pull "$img"; then
                fail "Requested UDMI version '$UDMI_VERSION' image '$img' could not be pulled. Verify the tag exists in ghcr.io/faucetsdn/udmi/ (if GHCR returns 'denied', run 'docker logout ghcr.io')."
            fi
        fi
    done
fi

if [[ "$LOCAL_BUILD" == "true" ]]; then
    echo "Building base container images from local workspace source..."
    "$UDMI_ROOT/bin/container" validator build --no-check
    "$UDMI_ROOT/bin/container" udmis build --no-check
    "$UDMI_ROOT/bin/container" pubber build --no-check
    export UDMIS_BASE_IMAGE=udmis:latest
    export VALIDATOR_BASE_IMAGE=validator:latest
    export PUBBER_IMAGE=pubber:latest
fi

cd "$UDMI_ROOT/bridgehead"

echo "=== Setting up Bridgehead prerequisites ==="

# 1. Create var directories on host
echo "Creating var directories..."
mkdir -p var/mosquitto/data var/mosquitto/log var/mosquitto/certs var/etcd var/tmp var/sshKeys var/influxdb-storage

# 2. Ensure reflector certificate exists if site model is available
if [[ -d "$SITE_MODEL_PATH/reflector" ]]; then
    if [[ ! -f "$SITE_MODEL_PATH/reflector/rsa_private.crt" && -f "$SITE_MODEL_PATH/reflector/rsa_private.pem" ]]; then
        echo "Generating X.509 certificate for reflector client..."
        openssl req -x509 -new -nodes -key "$SITE_MODEL_PATH/reflector/rsa_private.pem" -sha256 -days 3650 -out "$SITE_MODEL_PATH/reflector/rsa_private.crt" -subj "/CN=UDMI-reflector" || true
    fi
    if [[ ! -f "$SITE_MODEL_PATH/reflector/ca.crt" && -f "$SITE_MODEL_PATH/reflector/rsa_private.crt" ]]; then
        cp "$SITE_MODEL_PATH/reflector/rsa_private.crt" "$SITE_MODEL_PATH/reflector/ca.crt"
    fi
fi

mkdir -p "$SITE_MODEL_PATH/out"

# 3. Setup .env if missing
if [[ ! -f .env ]]; then
    echo "Generating .env file..."
    HOST_IP=$(hostname -I | awk '{print $1}')
    cat <<EOF > .env
HOST_IP=${HOST_IP:-127.0.0.1}
SITE_MODEL_PATH=${SITE_MODEL_PATH}
AUTH_USER=scrumptious
AUTH_PASS=aardvark
SERV_USER=rocket
SERV_PASS=monkey
INFLUXDB_TOKEN=$(openssl rand -hex 32)
INFLUX_USER=bridgehead
INFLUX_PASSWORD=password
GRAFANA_USER=bridgehead
GRAFANA_PASSWORD=password
EOF
    echo ".env created successfully."
fi

# 4. Prepare images and bring up Docker compose
echo "Preparing bridgehead container images..."
retry_cmd docker compose pull --ignore-buildable --policy missing
retry_cmd docker compose build
echo "Starting bridgehead services via docker compose (Site model: $SITE_MODEL_PATH, UDMIS: ${UDMIS_BASE_IMAGE:-ghcr.io/faucetsdn/udmi/udmis:latest}, Validator: ${VALIDATOR_BASE_IMAGE:-ghcr.io/faucetsdn/udmi/validator:latest})..."
rm -f var/tmp/udmis.log var/tmp/pod_ready.txt 2>/dev/null || true
docker compose up -d --no-build "$@"

echo "Waiting for UDMIS service to become ready..."
UDMIS_READY=false
for i in {1..60}; do
    STARTED_AT=$(docker inspect -f '{{.State.StartedAt}}' udmis 2>/dev/null || true)
    if docker logs ${STARTED_AT:+--since "$STARTED_AT"} udmis 2>&1 | grep "udmis running in the background" >/dev/null; then
        UDMIS_READY=true
        echo "UDMIS service is ready."
        break
    fi
    echo "Waiting for UDMIS... [$i/60]"
    sleep 2
done

if [[ "$UDMIS_READY" != "true" ]]; then
    echo "Dumping UDMIS logs:"
    docker logs udmis || true
    fail "UDMIS failed to become ready within 120 seconds."
fi

echo "=== Bridgehead deployment started successfully ==="
