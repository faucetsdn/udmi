#!/bin/bash -e

UDMI_ROOT=$(dirname "$0")/..
source "$UDMI_ROOT/etc/shell_common.sh"

BAILEY_LOG=out/bailey.log
mkdir -p out var

BAILEY_PID_FILE=var/bailey.pid
if [[ -f $BAILEY_PID_FILE ]]; then
    old_pid=$(cat $BAILEY_PID_FILE)
    if ps -p $old_pid > /dev/null 2>&1; then
        echo "Killing existing local bailey pid $old_pid..."
        kill $old_pid 2>/dev/null || true
        sleep 1
    fi
    rm -f $BAILEY_PID_FILE
else
    if [[ ${UDMI_NO_SUDO:-false} != true ]]; then
        old_pid=$(ps ax | fgrep python | fgrep bailey | fgrep -v grep | awk '{print $1}') || true
        if [[ -n $old_pid ]]; then
            echo "Killing existing bailey pid $old_pid..."
            kill $old_pid 2>/dev/null || true
        fi
    fi
fi

if [[ ${1:-} == stop ]]; then
    exit 0
fi

site_model="${1:-sites/udmi_site_model}"
target_project="${2:-${TARGET_PROJECT:-//mqtt/localhost:${MQTT_PORT:-8883}}}"

export PYTHONUNBUFFERED=1
export POSTGRES_PORT=${POSTGRES_PORT:-5432}
export INFLUX_PORT=${INFLUX_PORT:-8086}

echo "Starting bailey on $target_project with model $site_model..."
nohup $UDMI_ROOT/bin/bailey "$site_model" "$target_project" >> $BAILEY_LOG 2>&1 &
BAILEY_PID=$!
echo $BAILEY_PID > $BAILEY_PID_FILE
disown $BAILEY_PID 2>/dev/null || true

echo "Started bailey daemon (PID $BAILEY_PID)"
