#!/bin/bash -e

ROOT_DIR=$(realpath $(dirname $0)/..)
cd "$ROOT_DIR"

source "$ROOT_DIR/etc/shell_common.sh"
export LC_ALL=C

if [[ $(id -u) == 0 ]] && ! which sponge &>/dev/null; then
    if [[ -n $(which apt-get) ]]; then
        update_cmd="apt-get install -y"
        extra_packages=""
    else
        update_cmd="apk add"
        # Some extra packages are necessary for alpine based docker builds.
        extra_packages="${NO_CACHE_DIR:+--no-cache} linux-headers g++ gcc"
    fi
    $update_cmd $extra_packages moreutils expect python3 python3-pip python3-venv || true
fi

python3 --version

VENV_DIR="$ROOT_DIR/codegen/venv"
SCHEMA_INPUT_DIR="$ROOT_DIR/schema"
SCHEMA_OUTPUT_DIR="$ROOT_DIR/codegen/pyschema"
GEN_PYTHON_DIR="$ROOT_DIR/gencode/python"
PYTHON_OUTPUT_DIR="$GEN_PYTHON_DIR/udmi/schema"

python3 -m venv "$VENV_DIR"
source "$VENV_DIR"/bin/activate

pip install "datamodel-code-generator==0.35.0" "dataclasses-json==0.6.7"

# Clean up previous output directories
rm -rf "$SCHEMA_OUTPUT_DIR"
rm -rf "$GEN_PYTHON_DIR"

mkdir -p "$SCHEMA_OUTPUT_DIR"
mkdir -p "$PYTHON_OUTPUT_DIR"

# Copy poetry configuration file
cp "$ROOT_DIR/etc/pyschema.toml" "$GEN_PYTHON_DIR/pyproject.toml"
cp "$ROOT_DIR/etc/_schema_base.py" "$PYTHON_OUTPUT_DIR/_base.py"

# Transform schemas by removing 'file:' prefix.
# datamodel-codegen does not work with paths with 'file:' prefix
find "$SCHEMA_INPUT_DIR" -type f -print0 | while IFS= read -r -d $'\0' file; do
  FILENAME=$(basename "$file")
  OUTPUT_FILE="$SCHEMA_OUTPUT_DIR/$FILENAME"
  sed 's/file://' "$file" > "$OUTPUT_FILE" || {
    echo "Error: Failed to process schema file '$file'" >&2
    exit 1
  }
done
echo "Generated pyschema in '$SCHEMA_OUTPUT_DIR'"

# Generate python code from schemas
datamodel-codegen --input "$SCHEMA_OUTPUT_DIR" --input-file-type jsonschema \
--output "$PYTHON_OUTPUT_DIR" --use-default --force-optional \
--use-schema-description --reuse-model --use-exact-imports \
--output-model-type dataclasses.dataclass --disable-timestamp \
--base-class ._base.DataModel

# handle manually curated enums
# copy level.py from etc/level.py
cp "$ROOT_DIR/etc/level.py" "$PYTHON_OUTPUT_DIR/level.py"
# create category.py from docs/specs/categories.md
bin/gencode_py_categories
# create bucket.py from docs/specs/buckets.md
bin/gencode_py_buckets

# Resolve mutual circular imports by moving them to the bottom of the module (after class definitions)
python3 - "$PYTHON_OUTPUT_DIR" << 'EOF'
import os, re, sys

out_dir = sys.argv[1]
import_re = re.compile(r"^from \.([a-zA-Z0-9_]+) import .+$")
deps = {}
lines_by_mod = {}

for fname in sorted(os.listdir(out_dir)):
    if not fname.endswith(".py") or fname == "__init__.py":
        continue
    mod = fname[:-3]
    path = os.path.join(out_dir, fname)
    with open(path, "r", encoding="utf-8") as f:
        lines = f.readlines()
    lines_by_mod[mod] = (path, lines)
    deps[mod] = set()
    for line in lines:
        m = import_re.match(line.strip())
        if m:
            deps[mod].add(m.group(1))

for mod, (path, lines) in lines_by_mod.items():
    cyclic_targets = {target for target in deps[mod] if mod in deps.get(target, set())}
    if not cyclic_targets:
        continue
    kept = []
    deferred = []
    for line in lines:
        m = import_re.match(line.strip())
        if m and m.group(1) in cyclic_targets:
            deferred.append(line.rstrip("\n") + "\n")
        else:
            kept.append(line)
    if deferred:
        if kept and not kept[-1].endswith("\n"):
            kept[-1] += "\n"
        kept.append("\n")
        kept.extend(deferred)
        with open(path, "w", encoding="utf-8") as f:
            f.writelines(kept)
EOF

# add import statements to udmi/schema/__init__.py
find "$PYTHON_OUTPUT_DIR" -name "*.py" -not -name "__init__.py" -print0 | while IFS= read -r -d $'\0' file; do
  module_name=$(basename "$file" .py)
  echo "from .$module_name import *"
done | sort > "$PYTHON_OUTPUT_DIR"/__init__.py.tmp
mv "$PYTHON_OUTPUT_DIR"/__init__.py.tmp "$PYTHON_OUTPUT_DIR"/__init__.py

echo "Generated python code in '$PYTHON_OUTPUT_DIR'"

deactivate

echo "Done with python gencode."