#!/bin/bash
# ==========================================================================
# UDMI Workbench Stop Script
# Stops running UDMI Workbench backend server processes without disturbing
# non-Workbench processes on the same port.
# Usage: bin/stop_workbench [--port=PORT | PORT]
# ==========================================================================

set -e

PORT="8080"
for arg in "$@"; do
  case "$arg" in
    --port=*)
      PORT="${arg#*=}"
      ;;
    [0-9]*)
      PORT="$arg"
      ;;
  esac
done

echo "Stopping any running UDMI Workbench server instances..."

# Check if process listening on target port is actually UDMI Workbench
if [ -n "$PORT" ] && command -v lsof > /dev/null 2>&1; then
  PIDS=$(lsof -t -i :"${PORT}" 2>/dev/null || true)
  for pid in $PIDS; do
    cmdline=$(tr '\0' ' ' < /proc/"$pid"/cmdline 2>/dev/null || true)
    if [[ "$cmdline" == *"ui/src/server.py"* ]]; then
      echo "Stopping UDMI Workbench process (PID ${pid}) on port ${PORT}..."
      kill -9 "$pid" 2>/dev/null || true
    else
      echo "Port ${PORT} process (PID ${pid}) is not UDMI Workbench; leaving untouched."
    fi
  done
fi

# Fallback: kill any remaining python process matching ui/server.py
pkill -9 -f "ui/src/server.py" 2>/dev/null || true

sleep 0.5
echo "Workbench server stop check completed."
