#!/bin/bash
# ==========================================================================
# UDMI Workbench Stop Script
# Stops any running UDMI Workbench backend server process on port 8080
# or running ui/server.py, regardless of workspace working directory.
# ==========================================================================

set -e

echo "Stopping any running UDMI Workbench server instances..."

# Terminate process listening on port 8080
if command -v fuser > /dev/null 2>&1; then
  fuser -k 8080/tcp > /dev/null 2>&1 || true
fi

if command -v lsof > /dev/null 2>&1; then
  PIDS=$(lsof -t -i :8080 2>/dev/null || true)
  if [ -n "$PIDS" ]; then
    kill -9 $PIDS 2>/dev/null || true
  fi
fi

# Terminate any running python process matching ui/server.py
pkill -9 -f "ui/server.py" 2>/dev/null || true

sleep 0.5
echo "Workbench server stopped."
