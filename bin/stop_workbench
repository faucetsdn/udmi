#!/bin/bash
# ==========================================================================
# UDMI Workbench Stop Script
# Stops any running UDMI Workbench backend server process.
# Usage: bin/stop_workbench [--port=PORT | PORT]
# ==========================================================================

set -e

PORT="8080"
for arg in "$@"; do
  case "$arg" in
    --port=*)
      PORT="${arg#*=}"
      ;;
    [0-9]*)
      PORT="$arg"
      ;;
  esac
done

echo "Stopping any running UDMI Workbench server instances..."

# Terminate process listening on target port
if [ -n "$PORT" ]; then
  if command -v fuser > /dev/null 2>&1; then
    fuser -k "${PORT}/tcp" > /dev/null 2>&1 || true
  fi

  if command -v lsof > /dev/null 2>&1; then
    PIDS=$(lsof -t -i :"${PORT}" 2>/dev/null || true)
    if [ -n "$PIDS" ]; then
      kill -9 $PIDS 2>/dev/null || true
    fi
  fi
fi

# Terminate any running python process matching ui/server.py
pkill -9 -f "ui/server.py" 2>/dev/null || true

sleep 0.5
echo "Workbench server stopped."
