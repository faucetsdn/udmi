#!/bin/bash -e

UDMI_ROOT=$(dirname $(realpath $0))/..
INVOCATION_DIR="$PWD"

source $UDMI_ROOT/etc/shell_common.sh

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: $(basename $0) [--setup-endpoint] [-v|-vv] [-a] [-x] [-s serial_no] <DEVICE_ID> [TEST_NAMES...]"
    echo ""
    echo "Registers the target device in UDMI Bridgehead and runs the UDMI Sequencer"
    echo "against it inside the validator container, restoring host file ownership"
    echo "and printing the resulting host report paths."
    echo ""
    echo "Options / Arguments:"
    echo "  -v                      Enable DEBUG logging and save message traces (default)."
    echo "  -vv                     Enable TRACE logging."
    echo "  -a                      Include ALPHA stage sequences (min_stage=ALPHA)."
    echo "  -x                      Execute only ALPHA stage sequences (min_stage==ALPHA)."
    echo "  -s <serial_no>          Explicit serial number override for the device."
    echo "  --setup-endpoint        (Optional) Set up device endpoint only: generate CA-signed"
    echo "                          client cert, register device in Mosquitto, write"
    echo "                          out/devices/<ID>/endpoint.json, and exit without running sequencer."
    echo "  <DEVICE_ID>             Target device ID defined under site_model/devices/."
    echo "  [TEST_NAMES...]         (Optional) Specific sequence test names to run."
    echo "  -h, --help              Show this help message and exit."
    echo ""
    echo "Examples:"
    echo "  $(basename $0) GAT-123                     # Run full sequencer suite"
    echo "  $(basename $0) GAT-123 system_last_update  # Run specific sequence test"
    echo "  $(basename $0) -vv -a AHU-1 writeback"
    echo "  $(basename $0) --setup-endpoint AHU-1      # Optional: export endpoint.json & certs for physical DUT"
    exit 0
fi

SETUP_ENDPOINT=false
HAS_SEQ_FLAGS=false
SEQ_FLAGS=()
HAS_VERBOSE=false

while [[ $# -gt 0 && "$1" == -* ]]; do
    case "$1" in
        --setup-endpoint)
            SETUP_ENDPOINT=true
            shift
            ;;
        -v|-vv)
            HAS_VERBOSE=true
            HAS_SEQ_FLAGS=true
            SEQ_FLAGS+=("$1")
            shift
            ;;
        -a|-x)
            HAS_SEQ_FLAGS=true
            SEQ_FLAGS+=("$1")
            shift
            ;;
        -s)
            [[ $# -ge 2 ]] || fail "Option -s requires a <serial_no> argument."
            HAS_SEQ_FLAGS=true
            SEQ_FLAGS+=("-s" "$2")
            shift 2
            ;;
        *)
            fail "Unknown option '$1'. Run '$(basename $0) --help' for usage."
            ;;
    esac
done

if [[ "$HAS_VERBOSE" != "true" ]]; then
    SEQ_FLAGS=("-v" "${SEQ_FLAGS[@]}")
fi

if [[ $# -lt 1 ]]; then
    fail "Missing required <DEVICE_ID> argument. Run '$(basename $0) --help' for usage."
fi

DEVICE_ID="$1"
shift

if [[ "$SETUP_ENDPOINT" == "true" ]]; then
    [[ "$HAS_SEQ_FLAGS" != "true" ]] || fail "Option --setup-endpoint cannot be combined with sequencer flags (-v, -vv, -a, -x, -s)."
    [[ $# -eq 0 ]] || fail "Option --setup-endpoint sets up the device endpoint and exits; do not pass [TEST_NAMES...] with --setup-endpoint."
fi

# 1. Verify Bridgehead containers are running and UDMIS is ready
for container in udmis validator; do
    if [[ "$(docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null || true)" != "true" ]]; then
        fail "Container '$container' is not running. Start Bridgehead first with: bin/start_bridgehead [site_model_path]"
    fi
done

STARTED_AT=$(docker inspect -f '{{.State.StartedAt}}' udmis 2>/dev/null || true)
if ! docker logs ${STARTED_AT:+--since "$STARTED_AT"} udmis 2>&1 | grep "udmis running in the background" >/dev/null; then
    fail "UDMIS container is running but not yet ready. Wait for startup to complete or check 'docker logs udmis'."
fi

# 2. Resolve host SITE_MODEL_PATH from active validator container mount or bridgehead/.env
if [[ -z "${SITE_MODEL_PATH:-}" ]]; then
    SITE_MODEL_PATH=$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/root/site_model"}}{{.Source}}{{end}}{{end}}' validator 2>/dev/null || true)
fi
if [[ -z "${SITE_MODEL_PATH:-}" && -f "$UDMI_ROOT/bridgehead/.env" ]]; then
    SITE_MODEL_PATH=$(grep -E '^SITE_MODEL_PATH=' "$UDMI_ROOT/bridgehead/.env" | tail -n 1 | cut -d= -f2- || true)
fi
if [[ -z "${SITE_MODEL_PATH:-}" ]]; then
    SITE_MODEL_PATH="$UDMI_ROOT/sites/udmi_site_model"
fi
if [[ "$SITE_MODEL_PATH" != /* ]]; then
    SITE_MODEL_PATH="$INVOCATION_DIR/$SITE_MODEL_PATH"
fi
SITE_MODEL_PATH=$(realpath -m "$SITE_MODEL_PATH")

if [[ ! -d "$SITE_MODEL_PATH/devices/$DEVICE_ID" ]]; then
    fail "Device '$DEVICE_ID' not found in site model directory '$SITE_MODEL_PATH/devices/$DEVICE_ID'."
fi

fix_permissions() {
    docker exec validator chown -RH "$(id -u):$(id -g)" /root/site_model/ 2>/dev/null || true
}
trap fix_permissions EXIT

GATEWAY_ID=$(jq -r '.gateway.gateway_id // empty' "$SITE_MODEL_PATH/devices/$DEVICE_ID/metadata.json" 2>/dev/null || true)
TARGET_ID="${GATEWAY_ID:-$DEVICE_ID}"
if [[ ! -d "$SITE_MODEL_PATH/devices/$TARGET_ID" ]]; then
    fail "Target gateway '$TARGET_ID' for device '$DEVICE_ID' not found in '$SITE_MODEL_PATH/devices/$TARGET_ID'."
fi

if [[ "$SETUP_ENDPOINT" == "true" ]]; then
    SITE_CONFIG="$SITE_MODEL_PATH/cloud_iot_config.json"
    [[ -f "$SITE_CONFIG" ]] || fail "Site config '$SITE_CONFIG' not found."
    REGISTRY_ID=$(jq -r '.registry_id // empty' "$SITE_CONFIG")
    [[ -n "$REGISTRY_ID" ]] || fail "registry_id not defined in '$SITE_CONFIG'."

    CA_FILE="$SITE_MODEL_PATH/reflector/ca.crt"
    [[ -f "$CA_FILE" ]] || fail "Broker CA certificate '$CA_FILE' not found."

    if [[ -z "${HOST_IP:-}" && -f "$UDMI_ROOT/bridgehead/.env" ]]; then
        HOST_IP=$(grep -E '^HOST_IP=' "$UDMI_ROOT/bridgehead/.env" | tail -n 1 | cut -d= -f2- || true)
    fi
    [[ -n "${HOST_IP:-}" ]] || fail "HOST_IP is not set in environment or '$UDMI_ROOT/bridgehead/.env'."

    KEY_PREFIX=""
    for prefix in rsa ec es; do
        if [[ -f "$SITE_MODEL_PATH/devices/$TARGET_ID/${prefix}_private.pkcs8" ]]; then
            KEY_PREFIX="$prefix"
            break
        fi
    done
    if [[ -z "$KEY_PREFIX" ]]; then
        fail "No *_private.pkcs8 key found in '$SITE_MODEL_PATH/devices/$TARGET_ID/'. Generate device keys first (e.g., docker exec validator bin/keygen RS256 site_model/devices/$TARGET_ID)."
    fi

    PKCS8_FILE="$SITE_MODEL_PATH/devices/$TARGET_ID/${KEY_PREFIX}_private.pkcs8"
    PEM_FILE="$SITE_MODEL_PATH/devices/$TARGET_ID/${KEY_PREFIX}_private.pem"
    CRT_FILE="$SITE_MODEL_PATH/devices/$TARGET_ID/${KEY_PREFIX}_private.crt"
    [[ -f "$PEM_FILE" ]] || fail "Matching PEM private key '$PEM_FILE' not found."

    if [[ ! -f "$CRT_FILE" ]]; then
        echo "=== Generating CA-signed client certificate for '$TARGET_ID' ==="
        docker exec -e HOST_IP="$HOST_IP" validator bin/keygen CERT "site_model/devices/$TARGET_ID"
        fix_permissions
        [[ -f "$CRT_FILE" ]] || fail "Failed to generate client certificate '$CRT_FILE'."
    fi

    echo "=== Registering device '$DEVICE_ID' in Bridgehead ==="
    if [[ "$TARGET_ID" != "$DEVICE_ID" ]]; then
        docker exec validator bin/registrar site_model/ //mqtt/mosquitto "$TARGET_ID" "$DEVICE_ID"
    else
        docker exec validator bin/registrar site_model/ //mqtt/mosquitto "$DEVICE_ID"
    fi
    fix_permissions

    HASH_PASS=$(sha256sum < "$PKCS8_FILE")
    CLIENT_PASS="${HASH_PASS:0:8}"
    CLIENT_ID="/r/${REGISTRY_ID}/d/${TARGET_ID}"
    TOPIC_PREFIX="/r/${REGISTRY_ID}/d/${DEVICE_ID}"

    ENDPOINT_OUT="$SITE_MODEL_PATH/out/devices/$DEVICE_ID/endpoint.json"
    mkdir -p "$(dirname "$ENDPOINT_OUT")"
    jq -n \
        --arg hostname "$HOST_IP" \
        --arg client_id "$CLIENT_ID" \
        --arg topic_prefix "$TOPIC_PREFIX" \
        --arg password "$CLIENT_PASS" \
        '{
          protocol: "mqtt",
          transport: "ssl",
          hostname: $hostname,
          port: 8883,
          client_id: $client_id,
          topic_prefix: $topic_prefix,
          auth_provider: {
            basic: {
              username: $client_id,
              password: $password
            }
          }
        }' > "$ENDPOINT_OUT"

    echo ""
    echo "=== Device Endpoint Bundle (Host Paths) ==="
    echo "  endpoint.json : $ENDPOINT_OUT"
    echo "  CA cert       : $CA_FILE"
    echo "  Client cert   : $CRT_FILE"
    echo "  Client key    : $PEM_FILE"
    echo "=== Endpoint configured for device '$DEVICE_ID' on Bridgehead ($HOST_IP:8883) ==="
    exit 0
fi

# 3. Register target device so metadata and credentials are fresh in etcd and mosquitto
echo "=== [1/2] Registering device '$DEVICE_ID' in Bridgehead ==="
if [[ "$TARGET_ID" != "$DEVICE_ID" ]]; then
    docker exec validator bin/registrar site_model/ //mqtt/mosquitto "$TARGET_ID" "$DEVICE_ID"
else
    docker exec validator bin/registrar site_model/ //mqtt/mosquitto "$DEVICE_ID"
fi

# 4. Run sequencer against target device
echo "=== [2/2] Running sequencer for device '$DEVICE_ID' ==="
SEQ_EXIT=0
docker exec validator bin/sequencer "${SEQ_FLAGS[@]}" site_model/ //mqtt/mosquitto "$DEVICE_ID" "$@" || SEQ_EXIT=$?

fix_permissions

RESULT_LOG="$SITE_MODEL_PATH/out/devices/$DEVICE_ID/RESULT.log"
RESULTS_MD="$SITE_MODEL_PATH/out/devices/$DEVICE_ID/results.md"
RESULTS_JSON="$SITE_MODEL_PATH/out/sequencer_${DEVICE_ID}.json"

echo ""
echo "=== Sequencer Reports (Host Paths) ==="
[[ -f "$RESULT_LOG" ]] && echo "  RESULT.log : $RESULT_LOG"
[[ -f "$RESULTS_MD" ]] && echo "  results.md : $RESULTS_MD"
[[ -f "$RESULTS_JSON" ]] && echo "  JSON report: $RESULTS_JSON"

if [[ $SEQ_EXIT -ne 0 ]] || \
   ! docker exec validator grep -q "Found 0 test failures, exit code 0" /root/out/sequencer.log 2>/dev/null || \
   grep -q "^RESULT fail " "$RESULT_LOG" 2>/dev/null; then
    fail "Sequencer run failed for device '$DEVICE_ID'. See reports above for details."
fi

echo "=== Sequencer run PASSED for device '$DEVICE_ID' ==="
