#!/bin/bash -e

ROOT=$(dirname $0)/..
cd $ROOT

echo '#########################################' Testing simple mock sequencer...
bin/sequencer tests/sites/downgrade/ -- DWN-2 system_mode_restart || true

RESULTLOG=tests/sites/downgrade/out/devices/DWN-2/RESULT.log
fgrep "RESULT fail system.mode system_mode_restart PREVIEW " $RESULTLOG ||
    bin/fail missing output from $RESULTLOG

echo
echo '#########################################' Testing faceted test without facet values...
# DWN-2 defines no discovery families, so the faceted scan test should be reported as skipped
# (and not silently omitted from the results).
bin/sequencer tests/sites/downgrade/ -- DWN-2 scan_single_now || true

fgrep "RESULT skip discovery.scan scan_single_now PREVIEW 0/0 No discovery facets defined in metadata" $RESULTLOG ||
    bin/fail missing faceted skip output from $RESULTLOG

echo
echo '#########################################' Done with mock sequencer tests
