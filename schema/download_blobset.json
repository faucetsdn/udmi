{
  "$udmi_version": "1.5.7",
  "title": "Blobset Download",
  "description": "Direct cloud-to-device payload delivery for blobset configurations over the download/blobset channel.",
  "$section": "Messages",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "description": "RFC 3339 UTC timestamp the download payload was generated",
      "type": "string",
      "format": "date-time",
      "examples": ["2019-01-17T14:02:29.364Z"]
    },
    "version": {
      "description": "Version of the UDMI schema",
      "type": "string"
    },
    "blobs": {
      "description": "Map of system blobset keys to their provisioned endpoint configuration payloads",
      "type": "object",
      "additionalProperties": false,
      "existingJavaType": "java.util.HashMap<String, EndpointConfiguration>",
      "patternProperties": {
        "^_[a-z_]+$": {
          "$ref": "file:configuration_endpoint.json#"
        }
      }
    }
  },
  "required": [
    "timestamp",
    "version",
    "blobs"
  ]
}
