{
  "$udmi_version": "1.5.7",
  "title": "Uufi Control",
  "description": "Control-plane payload for UUFI status, progress, and error replies",
  "$section": "Messages",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "version",
    "control"
  ],
  "properties": {
    "timestamp": {
      "description": "RFC 3339 UTC timestamp the control message was generated",
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "description": "Version of the UDMI schema",
      "type": "string"
    },
    "control": {
      "title": "Uufi Control Block",
      "description": "UUFI control-plane payload block",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "file:entry.json"
        }
      }
    }
  }
}
