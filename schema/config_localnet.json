{
  "$udmi_version": "1.5.7",
  "title": "Localnet Config",
  "description": "Currently unused: request local network configuration",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "description": "RFC 3339 UTC timestamp the configuration was generated",
      "type": "string",
      "format": "date-time",
      "examples": ["2019-01-17T14:02:29.364Z"]
    },
    "version": {
      "description": "Version of the UDMI schema",
      "type": "string"
    },
    "families": {
      "description": "Address family config for reporting.",
      "existingJavaType": "java.util.HashMap<String, FamilyLocalnetConfig>",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
          "$ref": "file:config_localnet_family.json"
        }
      }
    },
    "networks": {
      "description": "Network address family config for reporting.",
      "existingJavaType": "java.util.HashMap<String, FamilyLocalnetConfig>",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9]*(_[a-z0-9]+)*$": {
          "$ref": "file:config_localnet_family.json"
        }
      }
    }
  }
}

