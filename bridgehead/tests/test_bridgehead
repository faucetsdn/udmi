#!/bin/bash -e

# Navigate to bridgehead directory
BRIDGEHEAD_DIR=$(dirname $(realpath $0))/..
cd "$BRIDGEHEAD_DIR"

UDMI_ROOT=$(realpath "$BRIDGEHEAD_DIR/..")
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    echo "Usage: $(basename $0) [-h|--help]"
    echo ""
    echo "Runs end-to-end integration tests for the UDMI Bridgehead architecture."
    echo ""
    echo "Options:"
    echo "  -h, --help              Show this help message and exit."
    echo ""
    echo "Test Description:"
    echo "  1. Clones/prepares default test site model using bin/clone_model."
    echo "  2. Launches Bridgehead services using bin/start_bridgehead --local."
    echo "  3. Prepares device registrar and starts Pubber container to send telemetry."
    echo "  4. Executes discovery sequence and registrar verification."
    echo "  5. Executes sequencer test against GAT-123 and verifies Management UI and report generation."
    echo ""
    echo "Expected Result:"
    echo "  - UDMIS becomes ready within timeout and Tomcat serves /bridgeheadManager/."
    echo "  - Output matches expected summary count (Device extra: 6, Device status: 5)."
    echo "  - Registrar processes discovery results for expected devices (AHU-22, SNS-4, GAT-123, UNK-1)."
    echo "  - Sequencer passes system_last_update and generates results.md and sequencer_GAT-123.json."
    echo "  - Prints 'Test PASSED' with exit code 0."
    exit 0
fi

SITE_MODEL_PATH="$UDMI_ROOT/sites/bridgehead_site_model"

clone_site_model() {
    local target_dir="$1"
    local model_ver="1.23"
    local repo_url="https://github.com/faucetsdn/udmi_site_model.git"
    
    echo "Cloning test site model into $target_dir..."
    rm -rf "$target_dir"
    mkdir -p "$(dirname "$target_dir")"
    git clone "$repo_url" "$target_dir"
    
    pushd "$target_dir" >/dev/null
    git fetch origin "$model_ver"
    git checkout -q "$model_ver"
    git log -n 1
    popd >/dev/null
}

# Backup existing .env if it exists
if [ -f .env ]; then
    echo "Backing up existing .env"
    cp .env .env.bak
fi

# Function to clean up on exit
cleanup() {
    echo "----- Cleaning up... -----"
    mkdir -p "$UDMI_ROOT/out"
    docker logs udmis > "$UDMI_ROOT/out/bridgehead_udmis_docker.log" 2>&1 || true
    docker cp udmis:/tmp/udmis.log "$UDMI_ROOT/out/bridgehead_udmis.log" 2>/dev/null || true
    docker cp udmis:/tmp/tomcat.log "$UDMI_ROOT/out/bridgehead_tomcat.log" 2>/dev/null || true
    docker logs validator > "$UDMI_ROOT/out/bridgehead_validator.log" 2>&1 || true
    docker logs pubber > "$UDMI_ROOT/out/bridgehead_pubber.log" 2>&1 || true
    cp out/registrar_output.txt "$UDMI_ROOT/out/bridgehead_registrar.log" 2>/dev/null || true
    cp out/sequencer_output.txt "$UDMI_ROOT/out/bridgehead_sequencer.log" 2>/dev/null || true
    
    if [ -f "$SITE_MODEL_PATH/devices/AHU-1/out/exceptions.txt" ]; then
        cp "$SITE_MODEL_PATH/devices/AHU-1/out/exceptions.txt" "$UDMI_ROOT/out/bridgehead_ahu1_exceptions.txt" 2>/dev/null || true
    fi
    
    echo "Stopping Pubber container..."
    docker stop pubber || true
    
    echo "Fixing permissions..."
    docker exec validator chown -RH $(id -u):$(id -g) /root/site_model/ 2>/dev/null || true
    docker exec udmis chown -RH $(id -u):$(id -g) /root/site_model/ /root/udmi/var/etcd/ 2>/dev/null || true
    docker exec mosquitto chown -RH $(id -u):$(id -g) /site_model/ /mosquitto/data/ 2>/dev/null || true
    
    echo "Stopping docker-compose services and cleaning runtime state..."
    "$UDMI_ROOT/bin/stop_bridgehead" --clean || docker compose down -v
    rm -rf "$SITE_MODEL_PATH" 2>/dev/null || true
    
    # Restore .env if backup exists
    if [ -f .env.bak ]; then
        echo "Restoring .env"
        mv .env.bak .env
    fi
}
trap cleanup EXIT

# Clean up existing containers and runtime state
docker rm -f $(docker ps -aq) 2>/dev/null || true
docker network rm $(docker network ls -q) 2>/dev/null || true
"$UDMI_ROOT/bin/stop_bridgehead" --clean 2>/dev/null || docker compose down -v --remove-orphans 2>/dev/null || true
[ ! -d "$BRIDGEHEAD_DIR/var" ] || { echo "ERROR: bridgehead/var still exists after stop_bridgehead --clean"; exit 1; }
rm -rf "$SITE_MODEL_PATH" 2>/dev/null || true

# Verify CLI fail-fast validation for version pinning and warm reset
! "$UDMI_ROOT/bin/start_bridgehead" --local --version latest "$SITE_MODEL_PATH" >/dev/null 2>&1 || { echo "ERROR: --local --version should fail"; exit 1; }
! "$UDMI_ROOT/bin/start_bridgehead" --version >/dev/null 2>&1 || { echo "ERROR: missing --version arg should fail"; exit 1; }
! "$UDMI_ROOT/bridgehead/bin/reset" unexpected_arg >/dev/null 2>&1 || { echo "ERROR: reset with extra arg should fail"; exit 1; }

mkdir -p out

echo "Cloning test site model..."
clone_site_model "$SITE_MODEL_PATH"

# Verify Docker preflight fails fast without retries or creating bridgehead/var
DOCKER_PREFLIGHT_OUT=$(DOCKER_HOST="unix:///nonexistent/bridgehead_test_docker.sock" "$UDMI_ROOT/bin/start_bridgehead" "$SITE_MODEL_PATH" 2>&1) && { echo "ERROR: start_bridgehead should fail when Docker daemon is unreachable"; exit 1; } || true
echo "$DOCKER_PREFLIGHT_OUT" | grep -q "Cannot connect to the Docker daemon" || { echo "ERROR: start_bridgehead missing Docker daemon preflight error"; echo "$DOCKER_PREFLIGHT_OUT"; exit 1; }
! echo "$DOCKER_PREFLIGHT_OUT" | grep -q "retrying in 2s" || { echo "ERROR: start_bridgehead retried instead of failing fast on Docker preflight"; echo "$DOCKER_PREFLIGHT_OUT"; exit 1; }
[ ! -d "$BRIDGEHEAD_DIR/var" ] || { echo "ERROR: start_bridgehead created bridgehead/var before Docker preflight"; exit 1; }

# Verify bin/mosquctl_device refuses to overwrite existing public key / cert files when *_private.pkcs8 is absent
MOSQ_GUARD_DIR=$(mktemp -d)
mkdir -p "$MOSQ_GUARD_DIR/devices/DUT-PUB" "$MOSQ_GUARD_DIR/devices/DUT-CERT"
echo '{"registry_id": "TEST-REG"}' > "$MOSQ_GUARD_DIR/cloud_iot_config.json"
printf '%s\n' "-----BEGIN PUBLIC KEY-----" "SENTINEL-PUBKEY" "-----END PUBLIC KEY-----" > "$MOSQ_GUARD_DIR/devices/DUT-PUB/rsa_public.pem"
printf '%s\n' "-----BEGIN CERTIFICATE-----" "SENTINEL-CERT" "-----END CERTIFICATE-----" > "$MOSQ_GUARD_DIR/devices/DUT-CERT/rsa_cert.pem"
PUB_SHA_BEFORE=$(sha256sum "$MOSQ_GUARD_DIR/devices/DUT-PUB/rsa_public.pem" | awk '{print $1}')
CERT_SHA_BEFORE=$(sha256sum "$MOSQ_GUARD_DIR/devices/DUT-CERT/rsa_cert.pem" | awk '{print $1}')

MOSQ_PUB_OUT=$("$UDMI_ROOT/bin/mosquctl_device" "$MOSQ_GUARD_DIR" DUT-PUB 2>&1) && { echo "ERROR: mosquctl_device should fail on public-key-only device"; rm -rf "$MOSQ_GUARD_DIR"; exit 1; } || true
echo "$MOSQ_PUB_OUT" | grep -q "Refusing to overwrite existing device keys" || { echo "ERROR: mosquctl_device missing overwrite guard error for rsa_public.pem"; echo "$MOSQ_PUB_OUT"; rm -rf "$MOSQ_GUARD_DIR"; exit 1; }
[ "$(sha256sum "$MOSQ_GUARD_DIR/devices/DUT-PUB/rsa_public.pem" | awk '{print $1}')" = "$PUB_SHA_BEFORE" ] || { echo "ERROR: mosquctl_device overwrote rsa_public.pem"; rm -rf "$MOSQ_GUARD_DIR"; exit 1; }
[ ! -e "$MOSQ_GUARD_DIR/devices/DUT-PUB/rsa_private.pkcs8" ] || { echo "ERROR: mosquctl_device generated rsa_private.pkcs8 for public-key-only device"; rm -rf "$MOSQ_GUARD_DIR"; exit 1; }

MOSQ_CERT_OUT=$("$UDMI_ROOT/bin/mosquctl_device" "$MOSQ_GUARD_DIR" DUT-CERT 2>&1) && { echo "ERROR: mosquctl_device should fail on cert-only device"; rm -rf "$MOSQ_GUARD_DIR"; exit 1; } || true
echo "$MOSQ_CERT_OUT" | grep -q "Refusing to overwrite existing device keys" || { echo "ERROR: mosquctl_device missing overwrite guard error for rsa_cert.pem"; echo "$MOSQ_CERT_OUT"; rm -rf "$MOSQ_GUARD_DIR"; exit 1; }
[ "$(sha256sum "$MOSQ_GUARD_DIR/devices/DUT-CERT/rsa_cert.pem" | awk '{print $1}')" = "$CERT_SHA_BEFORE" ] || { echo "ERROR: mosquctl_device overwrote rsa_cert.pem"; rm -rf "$MOSQ_GUARD_DIR"; exit 1; }
[ ! -e "$MOSQ_GUARD_DIR/devices/DUT-CERT/rsa_private.pkcs8" ] || { echo "ERROR: mosquctl_device generated rsa_private.pkcs8 for cert-only device"; rm -rf "$MOSQ_GUARD_DIR"; exit 1; }
rm -rf "$MOSQ_GUARD_DIR"

mkdir -p "$SITE_MODEL_PATH/out"
chmod a+rwx "$SITE_MODEL_PATH/out" 2>/dev/null || true

echo "Launching bridgehead services with local workspace build..."
"$UDMI_ROOT/bin/start_bridgehead" --local "$SITE_MODEL_PATH"

# Generate valid keys/certs for AHU-1 inside validator container to avoid validation errors
docker exec validator bin/keygen CERT site_model/devices/AHU-1

echo "Executing discovery sequence..."
sleep 5

# 1. Warm clean-state reset and device setup
touch "$SITE_MODEL_PATH/out/stale_marker.txt"
"$UDMI_ROOT/bridgehead/bin/reset"
[ ! -e "$SITE_MODEL_PATH/out/stale_marker.txt" ] || { echo "ERROR: bridgehead/bin/reset did not clear stale out/ file"; exit 1; }
[ -f "$SITE_MODEL_PATH/devices/AHU-1/rsa_private.crt" ] || { echo "ERROR: bridgehead/bin/reset removed device certificate"; exit 1; }
[ -f "$SITE_MODEL_PATH/reflector/ca.crt" ] || { echo "ERROR: bridgehead/bin/reset removed reflector CA certificate"; exit 1; }
echo "Warm reset (bridgehead/bin/reset) completed."
sleep 15
"$UDMI_ROOT/bridgehead/bin/setup_device" GAT-123
echo "Step 1: Device setup (bridgehead/bin/setup_device) completed."

# 2. Start Pubber container
docker rm -f pubber 2>/dev/null || true
docker run -d --rm --name pubber --network udminet -v "$SITE_MODEL_PATH":/root/site_model "${PUBBER_IMAGE:-pubber:latest}" /bin/bash -c "tail -f /dev/null"
echo "Step 2: Pubber container started."

# 3. Run Pubber inside container (using mosquitto service name)
docker exec -d pubber /bin/bash -c "bin/pubber site_model/ //mqtt/mosquitto GAT-123 852649"
echo "Step 3: Pubber command executed inside container."

# Wait a bit for pubber to send messages
sleep 15
echo "Wait for Pubber messages completed."

# 4. Run discovery script
docker exec validator /root/discovery.sh GAT-123
echo "Step 4: Discovery script executed."

failed=0

# 5. Run registrar to check results
echo "Waiting for messages to flush before registrar..."
sleep 30
docker exec validator bin/registrar site_model/ //mqtt/mosquitto > out/registrar_output.txt 2>&1 || failed=1
echo "Step 5: Ran Registrar to check results."

# 6. Execute Sequencer test via bridgehead/bin/sequencer
echo "Executing Sequencer test via bridgehead/bin/sequencer..."
"$UDMI_ROOT/bridgehead/bin/sequencer" GAT-123 system_last_update > out/sequencer_output.txt 2>&1 || failed=1
echo "Step 6: Sequencer test executed."

echo "Verifying Management UI deployment..."
curl -fsS http://localhost:8080/bridgeheadManager/ >/dev/null || failed=1

echo "Verifying registrar output..."
cat out/registrar_output.txt

# Verify expected summary
grep -q "Device validation: 1" out/registrar_output.txt || failed=1
grep -q "Device status: 5" out/registrar_output.txt || failed=1

# Also verify specific processed lines as per sample output
grep -q "Processed AHU-22" out/registrar_output.txt || failed=1
grep -q "Processed SNS-4" out/registrar_output.txt || failed=1
grep -q "Processed GAT-123" out/registrar_output.txt || failed=1
grep -q "Processed UNK-1" out/registrar_output.txt || failed=1

echo "Verifying sequencer output..."
cat out/sequencer_output.txt

# Verify Sequencer & setup_device results and host file ownership
grep -q "RESULT pass system system_last_update" out/sequencer_output.txt || failed=1
grep -q "Found 0 test failures, exit code 0" out/sequencer_output.txt || failed=1
[ -s "$SITE_MODEL_PATH/out/devices/GAT-123/endpoint.json" ] || failed=1
[ -O "$SITE_MODEL_PATH/out/devices/GAT-123/endpoint.json" ] || failed=1
[ -s "$SITE_MODEL_PATH/devices/GAT-123/ec_private.crt" ] || failed=1
[ -O "$SITE_MODEL_PATH/devices/GAT-123/ec_private.crt" ] || failed=1
jq -e '.protocol == "mqtt" and .transport == "ssl" and .port == 8883 and .client_id == "/r/ZZ-TRI-FECTA/d/GAT-123" and .topic_prefix == "/r/ZZ-TRI-FECTA/d/GAT-123" and (.auth_provider.basic.password | length == 8)' "$SITE_MODEL_PATH/out/devices/GAT-123/endpoint.json" >/dev/null || failed=1
[ -s "$SITE_MODEL_PATH/out/sequencer_GAT-123.json" ] || failed=1
[ -s "$SITE_MODEL_PATH/out/devices/GAT-123/results.md" ] || failed=1
[ -O "$SITE_MODEL_PATH/out/sequencer_GAT-123.json" ] || failed=1
[ -O "$SITE_MODEL_PATH/out/devices/GAT-123/results.md" ] || failed=1

if [ $failed -eq 0 ]; then
    echo "----- Test PASSED -----"
else
    echo "----- Test FAILED -----"
    exit 1
fi
