#!/bin/bash -e

ROOT=$(realpath $(dirname $0)/..)
UDMI_ROOT=$(realpath $ROOT/..)
source $UDMI_ROOT/etc/shell_common.sh
cd $ROOT

check=
covg=
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "check" ]]; then
    check=check
    shift
  elif [[ "$1" == "debug" ]]; then
    check="check -i"
    shift
  elif [[ "$1" == "covg" ]]; then
    covg=jacocoTestReport
    shift
  else
    break
  fi
done

jarbase=pubber-1.0-SNAPSHOT-all.jar
jartmp=/tmp/$jarbase
jardir=build/libs
jarfile=$jardir/$jarbase

if [[ -z $check && -z $covg ]] && up_to_date $jarfile src/; then
    mirror_udmi_files
    ls -l $jarfile
    echo $jarfile up-to-date, skipping build.
    exit 0
fi

rm -f $jartmp
echo Stashing $jartmp
[[ ! -f $jarfile ]] || cp -a $jarfile $jartmp

echo Cleaning build/
rm -rf build/
mkdir -p $jardir

[[ ! -f $jartmp ]] || cp -a $jartmp $jarfile

mirror_udmi_files

echo Building pubber in $PWD
./gradlew --console=plain shadow $check $covg

[[ -f $jarfile || ! -f $jartmp ]] || cp -a $jartmp $jarfile
touch -c $jarfile

ls -l $jarfile

echo Done with pubber build
