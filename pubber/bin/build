#!/bin/bash -e

while [[ $# -gt 0 ]]; do
  if [[ "$1" == "check" ]]; then
    check=check
    shift
  elif [[ "$1" == "debug" ]]; then
    check="check -i"
    shift
  elif [[ "$1" == "covg" ]]; then
    covg=jacocoTestReport
    shift
  else
    break
  fi
done

rundir=$(dirname $0)
cd $rundir/..

jarbase=pubber-1.0-SNAPSHOT-all.jar
jartmp=/tmp/$jarbase
jardir=build/libs
jarfile=$jardir/$jarbase

newer_files=$([[ -f $jarfile ]] && find src/ ../gencode/java ../common/src -type f -newer $jarfile 2>/dev/null || echo missing)
if [[ -z ${check:-} && -z ${covg:-} && -z $newer_files ]]; then
    ls -l $jarfile
    echo $jarfile up-to-date, skipping build.
    exit 0
fi

rm -f $jartmp
echo Stashing $jartmp
[[ ! -f $jarfile ]] || cp -a $jarfile $jartmp

echo Cleaning build/
rm -rf build/
mkdir -p $jardir

[[ ! -f $jartmp ]] || cp -a $jartmp $jarfile

echo Mirroring udmi files...
cp -a ../bin build/udmi_bin/
cp -a ../etc build/udmi_etc/

echo Building pubber in $PWD
./gradlew --console=plain shadow $check $covg

[[ -f $jarfile || ! -f $jartmp ]] || cp -a $jartmp $jarfile
touch -c $jarfile

ls -l $jarfile

echo Done with pubber build
