#!/bin/bash
# ==============================================================================
# UDMI Workbench: Promote UI Implementation
# ==============================================================================
# Promotes a sandboxed UI implementation generated in a worktree/branch into the
# main workspace HEAD (copying ui/src/ and ui/spec/impl/).
# ==============================================================================

set -e

# Resolve repo root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UI_DIR="$(dirname "$SCRIPT_DIR")"
REPO_ROOT="$(dirname "$UI_DIR")"

cd "$REPO_ROOT"

# Text Styling
BOLD='\033[1m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${BOLD}${CYAN}🚀 UDMI Workbench: Promote UI Implementation to HEAD${NC}\n"

TARGET_WORKTREE=""

if [ "$#" -gt 0 ]; then
  TARGET_WORKTREE="$1"
else
  # Discover active worktrees under out/worktrees/
  WORKTREES=()
  if [ -d "out/worktrees" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] && WORKTREES+=("$line")
    done < <(find out/worktrees -maxdepth 1 -mindepth 1 -type d)
  fi

  if [ "${#WORKTREES[@]}" -eq 0 ]; then
    echo -e "${YELLOW}No active UI worktrees found in out/worktrees/.${NC}"
    echo -e "Usage: $0 <path-to-worktree-or-branch>"
    exit 1
  fi

  echo -e "${BOLD}Select a Worktree Implementation to Promote:${NC}"
  for i in "${!WORKTREES[@]}"; do
    echo -e "  ${CYAN}[$((i+1))]${NC} ${WORKTREES[$i]}"
  done
  echo ""
  read -p "Enter choice [1-${#WORKTREES[@]}]: " CHOICE
  
  if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || [ "$CHOICE" -lt 1 ] || [ "$CHOICE" -gt "${#WORKTREES[@]}" ]; then
    echo -e "${RED}Invalid choice.${NC}"
    exit 1
  fi
  
  TARGET_WORKTREE="${WORKTREES[$((CHOICE-1))]}"
fi

if [ ! -d "$TARGET_WORKTREE" ]; then
  echo -e "${RED}Error: Target worktree directory '$TARGET_WORKTREE' does not exist.${NC}"
  exit 1
fi

if [ ! -d "$TARGET_WORKTREE/ui/src" ]; then
  echo -e "${RED}Error: '$TARGET_WORKTREE' does not contain a valid 'ui/src/' directory.${NC}"
  exit 1
fi

echo -e "Promoting UI from: ${GREEN}${TARGET_WORKTREE}${NC} to workspace HEAD..."

# Copy ui/src and ui/spec/impl
mkdir -p ui/src ui/spec/impl
cp -r "$TARGET_WORKTREE/ui/src/"* ui/src/
if [ -d "$TARGET_WORKTREE/ui/spec/impl" ]; then
  cp -r "$TARGET_WORKTREE/ui/spec/impl/"* ui/spec/impl/
fi

# Run verification tests
echo -e "\n${BOLD}Running verification unit tests on promoted UI...${NC}"
if bin/test_workbench; then
  echo -e "\n${GREEN}${BOLD}🎉 Success! UI implementation promoted to HEAD and verified.${NC}"
else
  echo -e "\n${YELLOW}⚠️ UI files copied, but unit tests encountered issues. Check git status.${NC}"
fi

# Prompt for worktree cleanup
BRANCH_NAME=$(basename "$TARGET_WORKTREE")
echo ""
read -p "Would you like to clean up and remove the worktree '$TARGET_WORKTREE'? [y/N]: " CLEANUP
if [[ "$CLEANUP" =~ ^[Yy]$ ]]; then
  echo -e "Removing worktree and branch ${BRANCH_NAME}..."
  git worktree remove --force "$TARGET_WORKTREE" || rm -rf "$TARGET_WORKTREE"
  git branch -D "$BRANCH_NAME" 2>/dev/null || true
  echo -e "${GREEN}Cleanup complete.${NC}"
fi

echo -e "\n${BOLD}Current status:${NC}"
git status --short ui/src ui/spec/impl
