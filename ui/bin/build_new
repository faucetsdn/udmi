#!/bin/bash
# ==============================================================================
# UDMI Workbench: Build New UI (Worktree Sandboxed)
# ==============================================================================
# Creates an isolated git worktree, clears disposable UI files (ui/src/ and
# ui/spec/impl/), and invokes the Gemini AI CLI to generate a complete
# new UI implementation based on core specifications and a selected design vibe.
# ==============================================================================

set -e

# Resolve repo root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UI_DIR="$(dirname "$SCRIPT_DIR")"
REPO_ROOT="$(dirname "$UI_DIR")"

cd "$REPO_ROOT"

# Text Styling
BOLD='\033[1m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
MAGENTA='\033[0;35m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${BOLD}${CYAN}🎨 UDMI Workbench: New UI Generator (Sandboxed Worktree)${NC}\n"

# 1. Determine AI CLI tool command
DRY_RUN=true
AI_CMD=""

if [ -n "$GEMINI_CMD" ]; then
  AI_CMD="$GEMINI_CMD"
  FIRST_WORD=$(echo "$AI_CMD" | awk '{print $1}')
  if command -v "$FIRST_WORD" > /dev/null 2>&1; then
    DRY_RUN=false
  else
    echo -e "${YELLOW}Notice: Specified GEMINI_CMD binary '$FIRST_WORD' not found in PATH.${NC}"
  fi
elif [ -n "$AI_CLI" ]; then
  AI_CMD="$AI_CLI"
  FIRST_WORD=$(echo "$AI_CMD" | awk '{print $1}')
  if command -v "$FIRST_WORD" > /dev/null 2>&1; then
    DRY_RUN=false
  fi
elif command -v agentapi > /dev/null 2>&1; then
  AI_CMD="agentapi new-conversation"
  DRY_RUN=false
elif command -v gemini > /dev/null 2>&1; then
  AI_CMD="gemini"
  DRY_RUN=false
elif command -v gemini-cli > /dev/null 2>&1; then
  AI_CMD="gemini-cli"
  DRY_RUN=false
elif [ -x "/google/bin/releases/gemini-cli/tools/gemini" ]; then
  AI_CMD="/google/bin/releases/gemini-cli/tools/gemini"
  DRY_RUN=false
fi

if [ "$DRY_RUN" = true ]; then
  echo -e "${YELLOW}Notice: No active AI CLI binary found in PATH.${NC}"
  echo -e "Prompt files will be generated for manual or AI-assisted execution."
  echo -e "To enable direct invocation, export ${BOLD}GEMINI_CMD=\"path/to/cli\"${NC} or ensure ${BOLD}agentapi${NC} / ${BOLD}gemini${NC} is in PATH.\n"
else
  echo -e "${GREEN}Using AI CLI command:${NC} ${BOLD}${AI_CMD}${NC}\n"
fi

# 2. Design Vibe Selection
VIBES=(
  "Cyberpunk Neon: Deep dark slate, neon cyan/magenta accents, glowing borders, high-contrast engineering density."
  "Glassmorphism Midnight: Translucent frosted glass panels, subtle blur overlays, crisp Google Sans typography."
  "Retro Terminal Grid: Monochrome CRT phosphor green/amber accents, dense scanline aesthetics, monospaced data grids."
  "Industrial Dark Matter: Stealth matte black, high-visibility safety orange indicators, compact telemetry dashboards."
  "Minimalist Botanical: Nordic clean sage green accents, spacious card layout, soft elevation, minimalist controls."
  "Vaporwave Synth: Sunset gradient accents, retro-futuristic card tiles, vibrant status indicators."
  "Random Whimsical: Pick a unique, creative, and surprising visual theme automatically."
  "Custom: Enter your own custom design vibe prompt."
)

SELECTED_VIBE=""
SELECTED_VIBE_NAME=""

if [ "$#" -gt 0 ]; then
  SELECTED_VIBE="$*"
  SELECTED_VIBE_NAME="custom"
else
  echo -e "${BOLD}Select a Design Vibe for the New UI:${NC}"
  for i in "${!VIBES[@]}"; do
    echo -e "  ${CYAN}[$((i+1))]${NC} ${VIBES[$i]}"
  done
  echo ""
  read -p "Enter choice [1-8] (Default: 7 Random): " CHOICE
  CHOICE=${CHOICE:-7}

  case "$CHOICE" in
    1)
      SELECTED_VIBE_NAME="cyberpunk"
      SELECTED_VIBE="${VIBES[0]}"
      ;;
    2)
      SELECTED_VIBE_NAME="glassmorphism"
      SELECTED_VIBE="${VIBES[1]}"
      ;;
    3)
      SELECTED_VIBE_NAME="retro-terminal"
      SELECTED_VIBE="${VIBES[2]}"
      ;;
    4)
      SELECTED_VIBE_NAME="industrial-dark"
      SELECTED_VIBE="${VIBES[3]}"
      ;;
    5)
      SELECTED_VIBE_NAME="minimalist-botanical"
      SELECTED_VIBE="${VIBES[4]}"
      ;;
    6)
      SELECTED_VIBE_NAME="vaporwave"
      SELECTED_VIBE="${VIBES[5]}"
      ;;
    7)
      # Random selection among preset themes
      RAND_IDX=$((RANDOM % 6))
      SELECTED_VIBE_NAME="whimsical-$((RAND_IDX+1))"
      SELECTED_VIBE="${VIBES[$RAND_IDX]}"
      echo -e "${MAGENTA}✨ Random Whimsical Choice: ${SELECTED_VIBE}${NC}"
      ;;
    8)
      SELECTED_VIBE_NAME="custom"
      read -p "Enter your custom design vibe prompt: " CUSTOM_INPUT
      SELECTED_VIBE="$CUSTOM_INPUT"
      ;;
    *)
      SELECTED_VIBE_NAME="whimsical"
      SELECTED_VIBE="${VIBES[0]}"
      ;;
  esac
fi

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
BRANCH_NAME="ui-vibe-${SELECTED_VIBE_NAME}-${TIMESTAMP}"
WORKTREE_DIR="out/worktrees/${BRANCH_NAME}"
ABS_WORKTREE_DIR="${REPO_ROOT}/${WORKTREE_DIR}"

echo -e "\n${BOLD}Creating isolated git worktree:${NC}"
echo -e "  Branch:   ${GREEN}${BRANCH_NAME}${NC}"
echo -e "  Location: ${GREEN}${WORKTREE_DIR}${NC}\n"

# 3. Create Git Worktree
mkdir -p out/worktrees
git worktree add -b "$BRANCH_NAME" "$WORKTREE_DIR"

# 4. Wipe Disposable Files in Worktree
echo -e "${YELLOW}Clearing existing UI implementation and disposable spec files in worktree...${NC}"
rm -rf "${ABS_WORKTREE_DIR}/ui/src/"*
rm -rf "${ABS_WORKTREE_DIR}/ui/spec/impl/"*

mkdir -p "${ABS_WORKTREE_DIR}/ui/src"
mkdir -p "${ABS_WORKTREE_DIR}/ui/spec/impl"
mkdir -p "${ABS_WORKTREE_DIR}/out"
mkdir -p "${REPO_ROOT}/out"

# 5. Assemble Core Specs Prompt Context
PROMPT_CONTENT=$(cat << EOF
You are an expert Frontend Architect rebuilding the UDMI Workbench UI from scratch inside a clean workspace.

BACKGROUND & INVARIANTS:
The repository contains permanent core specifications in ui/spec/core/ that MUST be strictly adhered to:
1. ui/spec/core/01-architecture.md (Micro-frontend iframe sandboxing, postMessage state sync, WSL path resolution)
2. ui/spec/core/02-functional-requirements.md (WHAT to display & control: Workspace path, Site Model Status, Project Spec Builder [//provider/]project[/namespace][+user], Device Matrix, Live Log Streamer, Mantis AI Triage)
3. ui/spec/core/03-data-and-api-contracts.md (REST API & SSE stream contracts)
4. ui/spec/core/04-state-and-events.md (udmi_state_change postMessage envelope)
5. ui/spec/core/user-flows.md (User interaction journeys)
6. ui/spec/core/tools/ (Shell, Sequencer, Mantis functional requirements)

DESIGN VIBE & AESTHETIC DIRECTIVE:
You MUST build a complete, stunning, and fully functional UI implementation adhering to the following design vibe:
"${SELECTED_VIBE}"

STRICT SCRATCH-BUILD INSTRUCTIONS:
- The target directories ui/src/ and ui/spec/impl/ have been wiped 100% CLEAN AND EMPTY to prevent old implementation files from polluting the new design.
- CRITICAL: Do NOT enter plan mode or draft a preliminary textual plan. Immediately create and write out the full output files using file-writing tools.
- CRITICAL: Do NOT attempt to use read_file or text-search tools on any paths inside ui/src/ or ui/spec/impl/ because those files do NOT exist yet. Reading non-existent files will cause fatal tool errors.
- Read all permanent specifications in ui/spec/core/ FIRST using read_file to understand all required domain capabilities, state protocols, and API contracts.
- Create and write out all required implementation specs in ui/spec/impl/ and application files in ui/src/ from scratch using file-writing tools.
- Do not run shell or test commands yourself; focus exclusively on generating the complete production source files.

OUTPUT DELIVERABLES:
1. Implementation Specifications (under ui/spec/impl/):
   - ui/spec/impl/layout-and-viewport.md: Document the spatial layout structure, viewport rules, panel scrolling, and responsive breakpoints created.
   - ui/spec/impl/design-guidelines.md: Document the visual design tokens, color roles, typography scale, and aesthetic styling rules created.

2. Application Source Code (under ui/src/):
   - Implement a complete, production-ready web application inside ui/src/ that fulfills all functional domain capabilities and requirements defined in ui/spec/core/.
   - Maintain tool sandboxing, state synchronization, and backend API integration as specified in ui/spec/core/.

CORE REQUIREMENTS:
- Production-ready, highly polished, and fully functional aesthetic matching the design vibe directive.
- Fulfills all functional controls, site model browsing, Project Spec Builder, device compliance matrix, live log streamer, and Mantis AI triage capabilities.

Please generate and write all the required files into the repository.
EOF
)

ROOT_PROMPT_FILE="${REPO_ROOT}/out/ui_generation_prompt.txt"
WORKTREE_PROMPT_FILE="${ABS_WORKTREE_DIR}/out/ui_generation_prompt.txt"

echo "$PROMPT_CONTENT" > "$ROOT_PROMPT_FILE"
echo "$PROMPT_CONTENT" > "$WORKTREE_PROMPT_FILE"

echo -e "${GREEN}${BOLD}✅ Prompt file successfully created at:${NC}"
echo -e "  • ${CYAN}file://${ROOT_PROMPT_FILE}${NC}"
echo -e "  • ${CYAN}file://${WORKTREE_PROMPT_FILE}${NC}\n"

# 6. Invoke AI Generation (Headless Mode with -p)
if [ "$DRY_RUN" = false ]; then
  echo -e "${BOLD}${CYAN}🚀 Invoking ${AI_CMD} CLI...${NC}"
  echo -e "${YELLOW}⏳ Please wait: Gemini AI is actively analyzing specifications and writing UI code into the worktree.${NC}"
  echo -e "${YELLOW}   (This process typically takes 1-3 minutes as full application files are generated. Please do not interrupt.)${NC}\n"
  cd "$ABS_WORKTREE_DIR"
  if [[ "$AI_CMD" == *"agentapi"* ]]; then
    $AI_CMD --title="Generate UI (${SELECTED_VIBE_NAME})" "$(cat "$WORKTREE_PROMPT_FILE")"
  else
    $AI_CMD -p "$(cat "$WORKTREE_PROMPT_FILE")" --approval-mode yolo || \
    $AI_CMD -p "$(cat "$WORKTREE_PROMPT_FILE")" --approval-mode auto_edit || \
    $AI_CMD --prompt "$(cat "$WORKTREE_PROMPT_FILE")" --approval-mode auto_edit || \
    $AI_CMD run --prompt-file "$WORKTREE_PROMPT_FILE" || true
  fi

  # 7. Agentic Actor-Critic Review Loop (Empirical Tests + Design Critic Audit)
  MAX_ATTEMPTS=3
  ATTEMPT=1
  BUILD_SUCCESS=false

  while [ "$ATTEMPT" -le "$MAX_ATTEMPTS" ]; do
    echo -e "\n${BOLD}${CYAN}🔄 [Attempt ${ATTEMPT}/${MAX_ATTEMPTS}] Phase 1: Running empirical test suite (unit tests + Selenium E2E browser tests)...${NC}"
    
    TEST_LOG="${ABS_WORKTREE_DIR}/out/test_verification_attempt_${ATTEMPT}.log"
    mkdir -p "$(dirname "$TEST_LOG")"
    
    EMPIRICAL_PASSED=false
    if bin/test_workbench > "$TEST_LOG" 2>&1; then
      cat "$TEST_LOG"
      echo -e "\n${GREEN}${BOLD}✅ Empirical verification tests passed on Attempt ${ATTEMPT}.${NC}"
      EMPIRICAL_PASSED=true
    else
      cat "$TEST_LOG"
      echo -e "\n${YELLOW}⚠️ Empirical tests failed on Attempt ${ATTEMPT}/${MAX_ATTEMPTS}.${NC}"
    fi

    CRITIC_VERDICT="APPROVED"
    CRITIC_FEEDBACK=""

    if [ "$EMPIRICAL_PASSED" = true ] && [ "$DRY_RUN" = false ]; then
      echo -e "\n${BOLD}${MAGENTA}🕵️ Phase 2: Invoking Design & Architectural Critic Agent audit...${NC}"
      
      CRITIC_PROMPT_FILE="${ABS_WORKTREE_DIR}/out/critic_prompt_attempt_${ATTEMPT}.txt"
      CRITIC_REPORT_FILE="${ABS_WORKTREE_DIR}/out/critic_report_attempt_${ATTEMPT}.txt"

      cat << CRITIC_EOF > "$CRITIC_PROMPT_FILE"
You are an uncompromising Senior Principal Frontend Architect and UI Design Critic acting as the QUALITY GUARD for the UDMI Workbench UI.

Your mission is to evaluate the generated code in ui/src/ and documentation in ui/spec/impl/ against the project's design standards and core domain contracts.

PERMANENT CORE SPECIFICATIONS:
Review permanent core requirements in ui/spec/core/ (01-architecture.md, 02-functional-requirements.md, 03-data-and-api-contracts.md, 04-state-and-events.md, user-flows.md, tools/).

REQUESTED VISUAL AESTHETIC VIBE:
"${SELECTED_VIBE}"

FILES TO CRITIQUE:
Inspect the source files under ui/src/ (index.html, style.css, main.js, shared/, sequencer/, mantis/) and specs under ui/spec/impl/.

CRITIQUE AUDIT CHECKLIST:
1. Visual Polish & Aesthetic Impact:
   - Did the builder achieve a genuinely high-end, bespoke UI aesthetic matching "${SELECTED_VIBE}" (curated color palettes, dark modes, glassmorphism/neon glows, custom scrollbars, typography scales)?
   - REJECT if the design looks like plain default un-styled HTML or generic white/grey MVP cards.
2. Micro-Frontend Sandboxing & postMessage State Protocol:
   - Are Sequencer and Mantis isolated in iframe sandbox containers?
   - Is siteModel state broadcast downstream via postMessage 'udmi_state_change'?
3. Functional Domain Completeness:
   - Is Project Spec Builder ([//provider/]project[/namespace][+user]) prominent and functional?
   - Do WSL shortcuts (~, /, /mnt/c, /mnt/d) exist in directory selection?
   - Are Sequencer device compliance matrix and live terminal log components implemented?
   - Are Mantis trace timelines, raw JSON payload trees, and Markdown AI reports implemented?

MANDATORY VERDICT:
At the end of your analysis, output your verdict on a single line matching either:
VERDICT: APPROVED
or
VERDICT: REJECTED

If REJECTED, detail the exact required design and code modifications below your verdict.
CRITIC_EOF

      if [[ "$AI_CMD" == *"agentapi"* ]]; then
        $AI_CMD --title="Critic Review Attempt ${ATTEMPT}" "$(cat "$CRITIC_PROMPT_FILE")" > "$CRITIC_REPORT_FILE" 2>&1 || true
      else
        $AI_CMD -p "$(cat "$CRITIC_PROMPT_FILE")" --approval-mode yolo > "$CRITIC_REPORT_FILE" 2>&1 || \
        $AI_CMD -p "$(cat "$CRITIC_PROMPT_FILE")" --approval-mode auto_edit > "$CRITIC_REPORT_FILE" 2>&1 || true
      fi

      cat "$CRITIC_REPORT_FILE"

      if grep -i "VERDICT: REJECTED" "$CRITIC_REPORT_FILE" > /dev/null 2>&1; then
        CRITIC_VERDICT="REJECTED"
        CRITIC_FEEDBACK=$(cat "$CRITIC_REPORT_FILE")
        echo -e "\n${RED}${BOLD}❌ Critic Agent REJECTED the implementation design quality on Attempt ${ATTEMPT}.${NC}"
      else
        echo -e "\n${GREEN}${BOLD}✨ Critic Agent APPROVED the implementation visual & architectural quality!${NC}"
      fi
    fi

    if [ "$EMPIRICAL_PASSED" = true ] && [ "$CRITIC_VERDICT" = "APPROVED" ]; then
      echo -e "\n${GREEN}${BOLD}🎉 COMPLETE VICTORY! Empirical tests PASSED and Critic Agent APPROVED on Attempt ${ATTEMPT}.${NC}"
      BUILD_SUCCESS=true
      break
    fi

    if [ "$ATTEMPT" -lt "$MAX_ATTEMPTS" ] && [ "$DRY_RUN" = false ]; then
      echo -e "\n${MAGENTA}${BOLD}🤖 Launching Builder Agent Repair Loop (Attempt $((ATTEMPT+1))): feeding Selenium test logs + Critic review feedback to AI CLI...${NC}\n"
      
      REPAIR_PROMPT_FILE="${ABS_WORKTREE_DIR}/out/ui_repair_attempt_${ATTEMPT}.txt"
      cat << REPAIR_EOF > "$REPAIR_PROMPT_FILE"
You are an expert Frontend Architect fixing test failures and design critique issues in the UDMI Workbench UI implementation.

Visual Vibe Directive: "${SELECTED_VIBE}"

=== EMPIRICAL TEST LOG (UNIT TESTS + HEADLESS SELENIUM BROWSER TESTS) ===
$(cat "$TEST_LOG")
========================================================================

=== CRITIC AGENT AUDIT & REVIEW REPORT ===
${CRITIC_FEEDBACK:-No empirical failures, but review architectural and visual quality.}
==========================================

INSTRUCTIONS FOR SELF-CORRECTION:
1. Address any empirical automated test failures from Selenium / Unit tests.
2. Address all concrete Critic Agent critiques regarding visual polish, glassmorphism/neon styling, Google typography, iframe sandboxing, and missing domain components (Project Spec Builder, WSL shortcuts, Sequencer log search, Mantis JSON viewer and Markdown report).
3. Read permanent core specs in ui/spec/core/ to confirm design invariants.
4. Modify files inside ui/src/ and ui/spec/impl/ directly.

Please apply all needed code and style fixes into the repository.
REPAIR_EOF

      if [[ "$AI_CMD" == *"agentapi"* ]]; then
        $AI_CMD --title="Fix UI Code Attempt ${ATTEMPT}" "$(cat "$REPAIR_PROMPT_FILE")"
      else
        $AI_CMD -p "$(cat "$REPAIR_PROMPT_FILE")" --approval-mode yolo || \
        $AI_CMD -p "$(cat "$REPAIR_PROMPT_FILE")" --approval-mode auto_edit || \
        $AI_CMD --prompt "$(cat "$REPAIR_PROMPT_FILE")" --approval-mode auto_edit || true
      fi
    fi
    
    ATTEMPT=$((ATTEMPT + 1))
  done

  if [ "$BUILD_SUCCESS" = false ]; then
    echo -e "\n${RED}${BOLD}❌ UI generation completed after ${MAX_ATTEMPTS} attempts, but tests or critic reviews still flagged issues. Review logs in out/.${NC}"
  fi
else
  echo -e "${GREEN}${BOLD}Prompt context is ready!${NC}"
  echo -e "You can pass ${CYAN}out/ui_generation_prompt.txt${NC} to your AI assistant or run it inside:"
  echo -e "  ${BOLD}cd ${WORKTREE_DIR}${NC}\n"
fi

echo -e "${BOLD}Next Steps:${NC}"
echo -e "  1. Test the new UI in worktree:"
echo -e "     ${CYAN}cd ${WORKTREE_DIR} && bin/workbench${NC}"
echo -e "  2. Promote to HEAD when ready:"
echo -e "     ${CYAN}ui/bin/promote ${WORKTREE_DIR}${NC}\n"
