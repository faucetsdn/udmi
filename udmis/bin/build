#!/bin/bash -e

ROOT=$(realpath $(dirname $0)/..)
UDMI_ROOT=$(realpath $ROOT/..)
source $UDMI_ROOT/etc/shell_common.sh
cd $ROOT

check=
covg=
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "check" ]]; then
    check=check
    [[ ! -f /tmp/pod_ready.txt ]] || rm -f /tmp/pod_ready.txt || sudo -n rm -f /tmp/pod_ready.txt
    shift
  elif [[ "$1" == "debug" ]]; then
    check="check -i"
    shift
  elif [[ "$1" == "covg" ]]; then
    covg=jacocoTestReport
    shift
  else
    break
  fi
done

jarbase=udmis-1.0-SNAPSHOT-all.jar
jartmp=/tmp/$jarbase
jardir=build/libs
jarfile=$jardir/$jarbase

mirror_local_files() {
  mirror_udmi_files schema butler common gencode mcp
  mkdir -p var && cp -a etc/*.json var/
}

if [[ -z $check && -z $covg ]] && up_to_date $jarfile src/; then
    mirror_local_files
    ls -l $jarfile
    echo $jarfile up-to-date, skipping build.
    exit 0
fi

rm -f $jartmp
echo Stashing $jartmp
[[ ! -f $jarfile ]] || cp -a $jarfile $jartmp

echo Cleaning $ROOT/build/
rm -rf build
mkdir -p $jardir

[[ ! -f $jartmp ]] || cp -a $jartmp $jarfile

mirror_local_files

echo Building udmis in $PWD

./gradlew shadow $check $covg $*

[[ -f $jarfile || ! -f $jartmp ]] || cp -a $jartmp $jarfile
touch -c $jarfile

ls -l $jarfile

echo Done with udmis build.
