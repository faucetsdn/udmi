#!/bin/bash -ex
if (( $# != 1 )); then
    echo Usage: $0 IMAGE_REF
    exit 1
fi
ROOT_DIR=$(dirname $(realpath $0 ))
UDMI_ROOT=$(realpath $ROOT_DIR/../../..)
source $UDMI_ROOT/etc/shell_common.sh
SRCPATH=$(realpath $ROOT_DIR/../src)

IMAGE_REF=$1
VERSION_REF=$(date +%y%m%d)-$(git rev-list --count --since="today 00:00:00" HEAD)
echo -n $VERSION_REF > $SRCPATH/udmi/installed_version.txt


cd $SRCPATH
retry_cmd docker build -t $IMAGE_REF -f $ROOT_DIR/../Dockerfile .
