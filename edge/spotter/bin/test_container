#!/usr/bin/env python3
"""Container integration tests for UDMI Spotter edge agent."""

import json
import os
import subprocess
import sys
import tempfile
import time
import unittest

IMAGE_NAME = "udmi-spotter:latest"


class TestContainer(unittest.TestCase):
  """Tests verifying Spotter agent container lifecycle and execution."""

  engine: str = "docker"

  @classmethod
  def setUpClass(cls):
    print("Checking container image availability...", flush=True)
    cls.engine = "docker"
    res = subprocess.run(
        ["docker", "image", "inspect", IMAGE_NAME],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if res.returncode != 0:
      podman_res = subprocess.run(
          ["podman", "image", "inspect", IMAGE_NAME],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
          check=False,
      )
      if podman_res.returncode == 0:
        cls.engine = "podman"
      else:
        print(f"Container image {IMAGE_NAME} not available. Run build first.")
        sys.exit(1)
    print(
        f"Container image '{IMAGE_NAME}' verified using {cls.engine}.",
        flush=True,
    )

  def setUp(self):
    # pylint: disable=consider-using-with
    self.test_dir = tempfile.TemporaryDirectory()
    self.config_file = os.path.join(self.test_dir.name, "config.json")
    with open(self.config_file, "w", encoding="utf-8") as f:
      f.write('{"log_level": "INFO"}')

  def tearDown(self):
    self.test_dir.cleanup()

  def test_real_spotter_agent_cli_and_dependencies(self):
    """Verifies container dependency installation and CLI execution."""
    print(
        "\n=== Test: Real Spotter Agent Dependency & CLI Verification ===",
        flush=True,
    )
    cmd = [self.engine, "run", "--rm", "-i", IMAGE_NAME, "--help"]
    res = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=15,
        check=False,
    )
    self.assertEqual(
        res.returncode,
        0,
        f"Failed to run agent.py --help in container:\n{res.stderr}",
    )
    self.assertIn("Start Spotter Unified Edge Node", res.stdout)
    self.assertIn("--config_file", res.stdout)
    print(
        "PASS: Container dependencies imported and agent CLI executed.",
        flush=True,
    )

  def test_real_spotter_agent_normal_lifecycle_and_shutdown(self):
    """Verifies graceful SIGTERM shutdown inside the container."""
    print(
        "\n=== Test: Real Spotter Agent Lifecycle & Graceful Shutdown ===",
        flush=True,
    )
    cfg = {
        "log_level": "INFO",
        "mqtt": {
            "device_id": "TEST-1",
            "host": "127.0.0.1",
            "port": 18883,
            "registry_id": "ZZ-TEST",
            "authentication_mechanism": "udmi_local",
            "key_file": "/config_dir/rsa_private.pem",
            "connect_timeout_sec": 30,
        },
    }
    with open(self.config_file, "w", encoding="utf-8") as f:
      f.write(json.dumps(cfg))

    key_path = os.path.join(self.test_dir.name, "rsa_private.pem")
    with open(key_path, "wb") as f:
      f.write(b"MOCK PRIVATE KEY")

    container_name = f"spotter-real-test-{os.getpid()}"
    cmd = [
        self.engine,
        "run",
        "--rm",
        "-i",
        "--name",
        container_name,
        "-v",
        f"{self.test_dir.name}:/config_dir",
        IMAGE_NAME,
        "--config_file",
        "/config_dir/config.json",
    ]

    print("  Spawning real Spotter container...", flush=True)
    with subprocess.Popen(
        cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
    ) as proc:
      time.sleep(2.5)
      print(
          f"  Sending SIGTERM via '{self.engine} stop' to {container_name}...",
          flush=True,
      )
      subprocess.run(
          [self.engine, "stop", "-t", "5", container_name],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
          check=False,
      )
      try:
        exit_code = proc.wait(timeout=10)
      except subprocess.TimeoutExpired:
        proc.kill()
        exit_code = proc.wait()

      stdout, stderr = proc.communicate()
      print(f"  Container exited with code: {exit_code}", flush=True)

      self.assertEqual(
          exit_code,
          0,
          f"Expected clean shutdown with code 0, got {exit_code}\nSTDOUT:\n"
          f"{stdout}\nSTDERR:\n{stderr}",
      )

      self.assertIn("Starting UDMI Spotter Unified Agent", stdout)
      self.assertIn("Signal 15 received. Shutting down Spotter...", stdout)
      print(
          "PASS: Spotter agent initialized and shut down gracefully.",
          flush=True,
      )

  def test_real_spotter_agent_missing_config_fails(self):
    """Verifies that nonexistent config causes failure exit code."""
    print(
        "\n=== Test: Real Spotter Agent Missing Config Failure ===", flush=True
    )
    cmd = [
        self.engine,
        "run",
        "--rm",
        "-i",
        IMAGE_NAME,
        "--config_file",
        "/nonexistent.json",
    ]
    res = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=15,
        check=False,
    )
    self.assertNotEqual(
        res.returncode, 0, "Expected non-zero exit code on missing config"
    )
    print(
        "PASS: Real Spotter agent correctly failed on missing config.",
        flush=True,
    )

  def test_container_agent_crash(self):
    """Verifies process exit code propagation from inside container."""
    print(
        "\n=== Test: Single Process Agent Crash Propagation ===", flush=True
    )
    cmd = [
        self.engine,
        "run",
        "--rm",
        "-i",
        "--entrypoint",
        "/venv/bin/python3",
        IMAGE_NAME,
        "-c",
        "import sys; sys.exit(42)",
    ]
    res = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        timeout=15,
        check=False,
    )
    self.assertEqual(
        res.returncode,
        42,
        f"Expected exit code 42, got {res.returncode}\nSTDOUT:\n{res.stdout}\n"
        f"STDERR:\n{res.stderr}",
    )
    print("PASS: Agent exit code (42) propagated cleanly.", flush=True)


if __name__ == "__main__":
  unittest.main(verbosity=2)


