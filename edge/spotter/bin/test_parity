#!/usr/bin/env python3
"""Multi-device discovery & UDMI spec compliance tests for Spotter."""

import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import unittest

_script_dir = os.path.dirname(os.path.abspath(__file__))
_workspace_dir = os.path.abspath(os.path.join(_script_dir, "../../../"))
_venv_dir = os.path.join(_workspace_dir, "edge/spotter/venv")
_venv_python = os.path.join(_venv_dir, "bin/python3")
_curr_prefix = os.path.abspath(sys.prefix)
if os.path.exists(_venv_python) and _curr_prefix != os.path.abspath(_venv_dir):
  os.execv(_venv_python, [_venv_python] + sys.argv)

import paho.mqtt.client as mqtt  # pylint: disable=g-import-not-at-top

sys.path.insert(0, os.path.join(_workspace_dir, "clientlib/python/src"))
sys.path.insert(0, _workspace_dir)

BACNET_POINT_REF_REGEX = re.compile(r"^([A-Z]{2,4})/(0|[1-9][0-9]*)(#[_a-z]+)?$")


def get_container_engine():
  if os.environ.get("CONTAINER_ENGINE"):
    return os.environ["CONTAINER_ENGINE"]
  if shutil.which("docker"):
    return "docker"
  if shutil.which("podman"):
    return "podman"
  return "docker"


CONTAINER_ENGINE = get_container_engine()
PARITY_TEST_NUM_DEVICES = int(os.environ.get("PARITY_TEST_NUM_DEVICES", "2"))


def create_mqtt_client(client_id=None):
  """Instantiates an MQTT client compatible with paho-mqtt v1 and v2."""
  if hasattr(mqtt, "CallbackAPIVersion"):
    if client_id:
      return mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id=client_id)
    return mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
  if client_id:
    return mqtt.Client(client_id=client_id)
  return mqtt.Client()


def datetime_now_iso():
  """Returns the current UTC ISO-8601 formatted timestamp."""
  return datetime.datetime.now(datetime.timezone.utc).strftime(
      "%Y-%m-%dT%H:%M:%SZ"
  )


def find_null_paths(obj, path="$"):
  """Recursively finds any JSON paths with None (null) values."""
  nulls = []
  if obj is None:
    nulls.append(path)
  elif isinstance(obj, dict):
    for k, v in obj.items():
      nulls.extend(find_null_paths(v, f"{path}.{k}"))
  elif isinstance(obj, list):
    for idx, v in enumerate(obj):
      nulls.extend(find_null_paths(v, f"{path}[{idx}]"))
  return nulls


def sort_discovery_events(events):
  """Sorts events with start (0) first, devices by addr, and stop (<0) last."""
  start_events = [e for e in events if e.get("event_no") == 0]
  stop_events = [e for e in events if e.get("event_no", 0) < 0]
  device_events = [
      e
      for e in events
      if e.get("event_no", 0) > 0 or e.get("addr") is not None
  ]
  device_events.sort(key=lambda e: str(e.get("addr", "")))
  for idx, dev_evt in enumerate(device_events, start=1):
    dev_evt["event_no"] = idx
  return start_events + device_events + stop_events


class TestParity(unittest.TestCase):
  """Validates UDMI spec compliance of Spotter and co-existence with legacy node."""

  @classmethod
  def setUpClass(cls):
    cleanup_cmd = (
        f"{CONTAINER_ENGINE} ps -q --filter network=parity-spotter-net | xargs"
        f" -r {CONTAINER_ENGINE} stop"
    )
    subprocess.run(
        cleanup_cmd,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    res = subprocess.run(
        [CONTAINER_ENGINE, "network", "inspect", "parity-spotter-net"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if res.returncode != 0:
      try:
        subprocess.run(
            [
                CONTAINER_ENGINE,
                "network",
                "create",
                "--subnet=192.168.12.0/24",
                "--gateway=192.168.12.254",
                "parity-spotter-net",
            ],
            check=True,
        )
      except subprocess.CalledProcessError:
        subprocess.run(
            [CONTAINER_ENGINE, "network", "rm", "-f", "parity-spotter-net"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        subprocess.run(
            [
                CONTAINER_ENGINE,
                "network",
                "create",
                "--subnet=192.168.12.0/24",
                "--gateway=192.168.12.254",
                "parity-spotter-net",
            ],
            check=True,
        )

  def setUp(self):
    # pylint: disable=consider-using-with
    self.test_dir = tempfile.TemporaryDirectory()
    self.mqtt_port = 18883
    self.mqtt_plain_port = 18884

    workspace_dir = os.path.abspath(
        os.path.join(os.path.dirname(__file__), "../../../")
    )
    site_dir = os.path.join(workspace_dir, "sites/udmi_site_model")
    ca_src = os.path.join(site_dir, "reflector/ca.crt")
    server_crt_src = os.path.join(site_dir, "reflector/server.crt")
    server_key_src = os.path.join(site_dir, "reflector/server.key")
    ahu_dir = os.path.join(site_dir, "devices/AHU-1")
    ahu_key_src = os.path.join(ahu_dir, "rsa_private.pem")
    ahu_crt_src = os.path.join(ahu_dir, "rsa_private.crt")
    ahu_pkcs8_src = os.path.join(ahu_dir, "rsa_private.pkcs8")

    for cert_path in [
        ca_src,
        server_crt_src,
        server_key_src,
        ahu_key_src,
        ahu_crt_src,
        ahu_pkcs8_src,
    ]:
      if not os.path.exists(cert_path):
        raise FileNotFoundError(
            f"Prerequisite certificate/key missing: {cert_path}. Ensure"
            " 'bin/setup_ca sites/udmi_site_model localhost' and 'bin/keygen"
            " CERT sites/udmi_site_model/devices/AHU-1' have been run."
        )

    shutil.copy(ca_src, os.path.join(self.test_dir.name, "ca.crt"))
    shutil.copy(
        ahu_key_src, os.path.join(self.test_dir.name, "rsa_private.pem")
    )
    shutil.copy(
        ahu_pkcs8_src, os.path.join(self.test_dir.name, "rsa_private.pkcs8")
    )
    shutil.copy(
        ahu_crt_src, os.path.join(self.test_dir.name, "rsa_private.crt")
    )

    self.mosquitto_conf = os.path.join(self.test_dir.name, "mosquitto.conf")
    with open(self.mosquitto_conf, "w", encoding="utf-8") as f:
      f.write(f"""
listener {self.mqtt_plain_port} 0.0.0.0
allow_anonymous true

listener {self.mqtt_port} 0.0.0.0
cafile {ca_src}
certfile {server_crt_src}
keyfile {server_key_src}
require_certificate true
allow_anonymous true
""")

    self.mosquitto_log_path = os.path.join(self.test_dir.name, "mosquitto.log")
    # pylint: disable=consider-using-with
    self.mosquitto_log_file = open(
        self.mosquitto_log_path, "w", encoding="utf-8"
    )
    self.mosquitto_proc = subprocess.Popen(
        ["mosquitto", "-c", self.mosquitto_conf, "-v"],
        stdout=self.mosquitto_log_file,
        stderr=self.mosquitto_log_file,
    )
    time.sleep(1.5)

    if self.mosquitto_proc.poll() is not None:
      self.mosquitto_log_file.close()
      with open(self.mosquitto_log_path, "r", encoding="utf-8") as f:
        log_content = f.read()
      raise RuntimeError(f"Mosquitto failed to start:\n{log_content}")

    res = subprocess.run(
        [CONTAINER_ENGINE, "network", "inspect", "parity-spotter-net"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if res.returncode != 0:
      try:
        subprocess.run(
            [
                CONTAINER_ENGINE,
                "network",
                "create",
                "--subnet=192.168.12.0/24",
                "--gateway=192.168.12.254",
                "parity-spotter-net",
            ],
            check=True,
        )
      except subprocess.CalledProcessError:
        pass

    self.simulated_devices = []
    print(
        f"\n[TestParity] Starting {PARITY_TEST_NUM_DEVICES} simulated BACnet"
        " device(s)..."
    )
    for i in range(1, PARITY_TEST_NUM_DEVICES + 1):
      ip = f"192.168.12.{10 + i}"
      dev_id = 12340 + i
      cname = f"parity-bacnet-device-{i}"
      subprocess.run(
          [CONTAINER_ENGINE, "stop", cname],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
          check=False,
      )
      proc = subprocess.Popen(
          [
              CONTAINER_ENGINE,
              "run",
              "--rm",
              "--network=parity-spotter-net",
              f"--ip={ip}",
              "-e",
              f"BACNET_ID={dev_id}",
              "-e",
              "PYTHONUNBUFFERED=1",
              "--name",
              cname,
              "test-bacnet-device:latest",
          ],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
      )
      self.simulated_devices.append((cname, proc, dev_id, ip))
    time.sleep(3)

  def tearDown(self):
    for cname, proc, _, _ in getattr(self, "simulated_devices", []):
      subprocess.run(
          [CONTAINER_ENGINE, "stop", cname],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
          check=False,
      )
      if proc:
        try:
          proc.wait(timeout=2)
        except Exception:
          pass

    if hasattr(self, "mosquitto_proc") and self.mosquitto_proc:
      self.mosquitto_proc.terminate()
      try:
        self.mosquitto_proc.wait(timeout=2)
      except Exception:
        pass

    if hasattr(self, "mosquitto_log_file") and self.mosquitto_log_file:
      self.mosquitto_log_file.close()

    self.test_dir.cleanup()

  def run_discovery_test(
      self,
      container_image,
      container_name,
      client_id,
      config_file_in_container,
      family="bacnet",
      depth="system",
      addrs=None,
      scan_duration_sec=6,
      settle_time=12,
  ):
    """Executes a container discovery run and collects emitted events & states."""
    if self.mosquitto_proc.poll() is not None:
      self.mosquitto_log_file.close()
      with open(self.mosquitto_log_path, "r", encoding="utf-8") as f:
        log_content = f.read()
      raise RuntimeError(f"Mosquitto broker died:\n{log_content}")

    messages = []
    states = []
    client = create_mqtt_client()
    state_received = threading.Event()
    connected = threading.Event()

    def on_message(client, userdata, message):
      # pylint: disable=unused-argument
      if message.topic.endswith("/state"):
        states.append(json.loads(message.payload.decode()))
        state_received.set()
      elif message.topic.endswith("/events/discovery"):
        payload = json.loads(message.payload.decode())
        messages.append(payload)

    def on_connect(client, userdata, flags, rc, properties=None):
      # pylint: disable=unused-argument
      connected.set()

    client.on_connect = on_connect
    client.on_message = on_message
    client.connect("127.0.0.1", self.mqtt_plain_port)
    client.loop_start()

    if not connected.wait(timeout=5):
      raise RuntimeError("Test MQTT client failed to connect to local broker")

    client.subscribe(f"/r/ZZ-TRI-FECTA/d/{client_id}/events/discovery")
    client.subscribe(f"/r/ZZ-TRI-FECTA/d/{client_id}/state")

    subprocess.run(
        [CONTAINER_ENGINE, "stop", container_name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    # pylint: disable=consider-using-with
    container_proc = subprocess.Popen(
        [
            CONTAINER_ENGINE,
            "run",
            "--rm",
            "--network=parity-spotter-net",
            "--ip=192.168.12.2",
            "--name",
            container_name,
            "-v",
            f"{self.test_dir.name}:/config_dir",
            container_image,
            "--config_file",
            config_file_in_container,
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    try:
      timestamp = datetime_now_iso()
      family_scan_cfg = {
          "generation": timestamp,
          "scan_duration_sec": scan_duration_sec,
          "depth": depth,
      }
      if addrs:
        family_scan_cfg["addrs"] = addrs

      config_payload = {
          "timestamp": timestamp,
          "discovery": {
              "families": {
                  family: family_scan_cfg,
              }
          },
      }

      success = False
      for _ in range(15):
        client.publish(
            f"/r/ZZ-TRI-FECTA/d/{client_id}/config",
            json.dumps(config_payload),
            qos=1,
        )
        if state_received.wait(timeout=1.0):
          time.sleep(0.5)
          client.publish(
              f"/r/ZZ-TRI-FECTA/d/{client_id}/config",
              json.dumps(config_payload),
              qos=1,
          )
          success = True
          break

      if not success:
        print(f"\nERROR: Container {container_name} timed out.")
        if os.path.exists(self.mosquitto_log_path):
          with open(self.mosquitto_log_path, "r", encoding="utf-8") as f:
            print("\n--- MOSQUITTO BROKER LOGS ---")
            print(f.read())
        raise RuntimeError(
            f"Container {container_name} failed to publish state update."
        )

      time.sleep(settle_time)
    finally:
      subprocess.run(
          [CONTAINER_ENGINE, "stop", container_name],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
          check=False,
      )
      stdout, stderr = container_proc.communicate()
      print(f"\n[{container_name} STDOUT]:\n", stdout.decode())
      if stderr:
        print(f"\n[{container_name} STDERR]:\n", stderr.decode())

      client.loop_stop()
      client.disconnect()

    return messages, states

  def _prepare_configs(self):
    legacy_config = {
        "mqtt": {
            "device_id": "DSN-1",
            "host": "192.168.12.254",
            "port": self.mqtt_port,
            "registry_id": "ZZ-TRI-FECTA",
            "region": "us-central1",
            "project_id": "my-project",
            "key_file": "/config_dir/rsa_private.pem",
            "ca_file": "/config_dir/ca.crt",
            "cert_file": "/config_dir/rsa_private.crt",
            "algorithm": "RS256",
            "authentication_mechanism": "udmi_local",
        },
        "bacnet": {"ip": None, "port": None, "interface": None},
        "udmi": {
            "discovery": {
                "ipv4": True,
                "vendor": False,
                "ether": True,
                "bacnet": True,
            }
        },
    }
    legacy_config_file = os.path.join(self.test_dir.name, "legacy_config.json")
    with open(legacy_config_file, "w", encoding="utf-8") as f:
      f.write(json.dumps(legacy_config))

    spotter_config = {
        "mqtt": {
            "device_id": "DSN-1",
            "host": "192.168.12.254",
            "port": self.mqtt_port,
            "registry_id": "ZZ-TRI-FECTA",
            "region": "us-central1",
            "project_id": "my-project",
            "key_file": "/config_dir/rsa_private.pem",
            "ca_file": "/config_dir/ca.crt",
            "cert_file": "/config_dir/rsa_private.crt",
            "algorithm": "RS256",
            "authentication_mechanism": "udmi_local",
        }
    }
    spotter_config_file = os.path.join(
        self.test_dir.name, "spotter_config.json"
    )
    with open(spotter_config_file, "w", encoding="utf-8") as f:
      f.write(json.dumps(spotter_config))

  def test_01_bacnet_multi_device_discovery_parity(self):
    """Verifies BACnet system discovery coverage and UDMI spec compliance."""
    self._prepare_configs()
    expected_devs = {
        str(dev_id): ip for _, _, dev_id, ip in self.simulated_devices
    }
    expected_dev_ids = sorted(expected_devs.keys())

    num_devs = len(self.simulated_devices)
    scan_dur = max(6, 2 + num_devs * 2)
    settle_t = max(10, 4 + num_devs * 3)

    print(
        f"\n--- [Test 1] Running Legacy Discovery: BACnet depth=system"
        f" (devices={num_devs}, scan={scan_dur}s, settle={settle_t}s) ---"
    )
    legacy_events, _ = self.run_discovery_test(
        "test-discovery_node:latest",
        "parity-legacy-node-system",
        "DSN-1",
        "/config_dir/legacy_config.json",
        family="bacnet",
        depth="system",
        scan_duration_sec=scan_dur,
        settle_time=settle_t,
    )

    print(
        f"\n--- [Test 1] Running Spotter Discovery: BACnet depth=system"
        f" (devices={num_devs}, scan={scan_dur}s, settle={settle_t}s) ---"
    )
    spotter_events, spotter_states = self.run_discovery_test(
        "udmi-spotter:latest",
        "parity-spotter-node-system",
        "DSN-1",
        "/config_dir/spotter_config.json",
        family="bacnet",
        depth="system",
        scan_duration_sec=scan_dur,
        settle_time=settle_t,
    )

    # 1. Verify zero null fields in raw Spotter state and event payloads
    for s_idx, st in enumerate(spotter_states):
      null_paths = find_null_paths(st)
      self.assertEqual(
          null_paths, [], f"Spotter state[{s_idx}] contains nulls: {null_paths}"
      )
    for e_idx, evt in enumerate(spotter_events):
      null_paths = find_null_paths(evt)
      self.assertEqual(
          null_paths,
          [],
          f"Spotter event[{e_idx}] contains nulls: {null_paths}",
      )

    legacy_sorted = sort_discovery_events(legacy_events)
    spotter_sorted = sort_discovery_events(spotter_events)

    print(f"\nDiscovered simulated BACnet device IDs: {expected_dev_ids}")
    print(f"Legacy total events: {len(legacy_sorted)}")
    print(f"Spotter total events: {len(spotter_sorted)}")
    if spotter_states:
      print("\n[Spotter Final State Payload]:")
      print(json.dumps(spotter_states[-1], indent=2))
    print("\n[Spotter Emitted Discovery Events (depth=system)]:")
    print(json.dumps(spotter_sorted, indent=2))

    # 2. Verify start & stop markers and final state phase/active_count
    self.assertTrue(len(spotter_states) > 0, "No Spotter states captured")
    final_bacnet_state = (
        spotter_states[-1]
        .get("discovery", {})
        .get("families", {})
        .get("bacnet", {})
    )
    self.assertEqual(
        final_bacnet_state.get("phase"),
        "stopped",
        f"Expected final Spotter phase 'stopped', got {final_bacnet_state}",
    )
    self.assertEqual(
        final_bacnet_state.get("active_count"),
        len(expected_devs),
        f"Expected final active_count {len(expected_devs)}, got {final_bacnet_state}",
    )
    self.assertTrue(
        any(e.get("event_no") == 0 for e in legacy_sorted),
        "Legacy missing start marker 0",
    )
    self.assertTrue(
        any(e.get("event_no") == 0 for e in spotter_sorted),
        "Spotter missing start marker 0",
    )
    self.assertTrue(
        any(e.get("event_no", 0) < 0 for e in legacy_sorted),
        "Legacy missing finish marker < 0",
    )
    self.assertTrue(
        any(e.get("event_no", 0) < 0 for e in spotter_sorted),
        "Spotter missing finish marker < 0",
    )
    self.assertEqual(len(legacy_sorted), len(spotter_sorted))

    # 3. Verify all simulated devices are discovered and Spotter adheres to spec
    for dev_id, expected_ip in expected_devs.items():
      leg_match = [e for e in legacy_sorted if e.get("addr") == dev_id]
      spt_match = [e for e in spotter_sorted if e.get("addr") == dev_id]
      self.assertEqual(
          len(leg_match), 1, f"Legacy failed to discover device {dev_id}"
      )
      self.assertEqual(
          len(spt_match), 1, f"Spotter failed to discover device {dev_id}"
      )

      spt_evt = spt_match[0]
      leg_evt = leg_match[0]

      # Verify Spotter families.ipv4 includes both addr and UDP port 47808
      self.assertEqual(
          spt_evt.get("families", {}).get("ipv4", {}).get("addr"), expected_ip
      )
      self.assertEqual(
          spt_evt.get("families", {}).get("ipv4", {}).get("port"), 47808
      )

      # Verify system block per docs/specs/discovery_bacnet.md Section 3.3
      leg_sys = leg_evt.get("system", {})
      spt_sys = spt_evt.get("system", {})
      self.assertEqual(leg_sys.get("hardware"), spt_sys.get("hardware"))
      self.assertIsNotNone(spt_sys.get("name"))
      self.assertEqual(
          spt_sys.get("name"), leg_sys.get("ancillary", {}).get("name")
      )
      self.assertNotIn("name", spt_sys.get("ancillary", {}))
      self.assertNotIn("description", spt_sys.get("ancillary", {}))
      self.assertIn("firmware-revision", spt_sys.get("ancillary", {}))
      self.assertIn(
          "application-software-version", spt_sys.get("ancillary", {})
      )

    print(
        "\nSUCCESS: BACnet multi-device system discovery and UDMI spec"
        " compliance verified!"
    )

  def test_02_bacnet_point_enumeration_parity(self):
    """Verifies BACnet point reference enumeration and UDMI spec compliance."""
    self._prepare_configs()
    expected_dev_ids = sorted(
        str(dev_id) for _, _, dev_id, _ in self.simulated_devices
    )

    num_devs = len(self.simulated_devices)
    scan_dur = max(7, 3 + num_devs * 2)
    settle_t = max(12, 5 + num_devs * 3)

    print(
        f"\n--- [Test 2] Running Legacy Discovery: BACnet depth=refs"
        f" (devices={num_devs}, scan={scan_dur}s, settle={settle_t}s) ---"
    )
    legacy_events, _ = self.run_discovery_test(
        "test-discovery_node:latest",
        "parity-legacy-node-refs",
        "DSN-1",
        "/config_dir/legacy_config.json",
        family="bacnet",
        depth="refs",
        scan_duration_sec=scan_dur,
        settle_time=settle_t,
    )

    print(
        f"\n--- [Test 2] Running Spotter Discovery: BACnet depth=details"
        f" (devices={num_devs}, scan={scan_dur}s, settle={settle_t}s) ---"
    )
    spotter_events, spotter_states = self.run_discovery_test(
        "udmi-spotter:latest",
        "parity-spotter-node-details",
        "DSN-1",
        "/config_dir/spotter_config.json",
        family="bacnet",
        depth="details",
        scan_duration_sec=scan_dur,
        settle_time=settle_t,
    )

    for s_idx, st in enumerate(spotter_states):
      null_paths = find_null_paths(st)
      self.assertEqual(
          null_paths,
          [],
          f"Spotter details state[{s_idx}] contains nulls: {null_paths}",
      )
    for e_idx, evt in enumerate(spotter_events):
      null_paths = find_null_paths(evt)
      self.assertEqual(
          null_paths,
          [],
          f"Spotter details event[{e_idx}] contains nulls: {null_paths}",
      )

    legacy_sorted = sort_discovery_events(legacy_events)
    spotter_sorted = sort_discovery_events(spotter_events)

    print(f"\nLegacy refs events: {len(legacy_sorted)}")
    print(f"Spotter details events: {len(spotter_sorted)}")
    print("\n[Spotter Emitted Discovery Events (depth=details)]:")
    print(json.dumps(spotter_sorted, indent=2))
    if spotter_states:
      print("\n[Spotter Final State (depth=details)]:")
      print(json.dumps(spotter_states[-1], indent=2))

    # 1. Verify markers and final state phase/active_count
    self.assertTrue(len(spotter_states) > 0, "No Spotter states captured")
    final_details_state = (
        spotter_states[-1]
        .get("discovery", {})
        .get("families", {})
        .get("bacnet", {})
    )
    self.assertEqual(
        final_details_state.get("phase"),
        "stopped",
        f"Expected final Spotter phase 'stopped', got {final_details_state}",
    )
    self.assertEqual(
        final_details_state.get("active_count"),
        len(expected_dev_ids),
        f"Expected final active_count {len(expected_dev_ids)}, got {final_details_state}",
    )
    self.assertTrue(any(e.get("event_no") == 0 for e in legacy_sorted))
    self.assertTrue(any(e.get("event_no") == 0 for e in spotter_sorted))
    self.assertTrue(any(e.get("event_no", 0) < 0 for e in legacy_sorted))
    self.assertTrue(any(e.get("event_no", 0) < 0 for e in spotter_sorted))

    # 2. Verify all simulated devices and canonical BACnet refs
    expected_spotter_points = {
        "AI/0": ("AI:0", "analog-input", False),
        "AV/0": ("AV:0", "analog-value", True),
        "BI/0": ("BI:0", "binary-input", False),
        "MSV/0": ("MSV:0", "multi-state-value", True),
    }

    for dev_id in expected_dev_ids:
      leg_match = [e for e in legacy_sorted if e.get("addr") == dev_id]
      spt_match = [e for e in spotter_sorted if e.get("addr") == dev_id]
      self.assertEqual(len(leg_match), 1, f"Legacy missing device {dev_id}")
      self.assertEqual(len(spt_match), 1, f"Spotter missing device {dev_id}")

      leg_refs = leg_match[0].get("refs", {})
      spt_refs = spt_match[0].get("refs", {})

      for ref_key in spt_refs:
        self.assertRegex(
            ref_key,
            BACNET_POINT_REF_REGEX,
            f"Spotter ref key {ref_key} violates canonical <TYPE>/<INSTANCE> format",
        )

      self.assertTrue(
          set(expected_spotter_points.keys()).issubset(set(spt_refs.keys())),
          f"Spotter missing expected points on {dev_id}: {set(spt_refs.keys())}",
      )

      for spt_id, (leg_id, exp_type, exp_writable) in (
          expected_spotter_points.items()
      ):
        lp = leg_refs[leg_id]
        sp = spt_refs[spt_id]
        self.assertEqual(
            lp.get("name"),
            sp.get("name"),
            f"Point {spt_id} name mismatch on {dev_id}",
        )
        self.assertEqual(
            sp.get("type"),
            exp_type,
            f"Point {spt_id} type mismatch on {dev_id}",
        )
        self.assertEqual(
            sp.get("writable"),
            exp_writable,
            f"Point {spt_id} writable mismatch on {dev_id}",
        )
        self.assertEqual(
            lp.get("description"),
            sp.get("description"),
            f"Point {spt_id} description mismatch on {dev_id}",
        )
        self.assertIn(
            "present-value",
            sp.get("ancillary", {}),
            f"Point {spt_id} missing present-value in ancillary",
        )
        if "units" in lp:
          self.assertEqual(
              lp.get("units"),
              sp.get("units"),
              f"Point {spt_id} units mismatch on {dev_id}",
          )
        if spt_id in ("BI/0", "MSV/0"):
          self.assertTrue(
              isinstance(sp.get("possible_values"), list)
              and len(sp["possible_values"]) >= 2,
              f"Point {spt_id} missing possible_values list on {dev_id}",
          )

    print(
        "\nSUCCESS: BACnet point reference enumeration and UDMI spec"
        " compliance verified across all devices!"
    )


if __name__ == "__main__":
  unittest.main()
