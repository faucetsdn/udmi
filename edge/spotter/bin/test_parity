#!/usr/bin/env python3
"""Multi-device discovery parity tests between discoverynode & Spotter."""

import datetime
import json
import os
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import unittest

_script_dir = os.path.dirname(os.path.abspath(__file__))
_workspace_dir = os.path.abspath(os.path.join(_script_dir, "../../../"))
_venv_dir = os.path.join(_workspace_dir, "edge/spotter/venv")
_venv_python = os.path.join(_venv_dir, "bin/python3")
_curr_prefix = os.path.abspath(sys.prefix)
if os.path.exists(_venv_python) and _curr_prefix != os.path.abspath(_venv_dir):
  os.execv(_venv_python, [_venv_python] + sys.argv)

import paho.mqtt.client as mqtt  # pylint: disable=g-import-not-at-top

sys.path.insert(0, os.path.join(_workspace_dir, "clientlib/python/src"))
sys.path.insert(0, _workspace_dir)

def get_container_engine():
  if os.environ.get("CONTAINER_ENGINE"):
    return os.environ["CONTAINER_ENGINE"]
  if shutil.which("docker"):
    return "docker"
  if shutil.which("podman"):
    return "podman"
  return "docker"


CONTAINER_ENGINE = get_container_engine()
PARITY_TEST_NUM_DEVICES = int(os.environ.get("PARITY_TEST_NUM_DEVICES", "2"))


def create_mqtt_client(client_id=None):
  """Instantiates an MQTT client compatible with paho-mqtt v1 and v2."""
  if hasattr(mqtt, "CallbackAPIVersion"):
    if client_id:
      return mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id=client_id)
    return mqtt.Client(mqtt.CallbackAPIVersion.VERSION2)
  if client_id:
    return mqtt.Client(client_id=client_id)
  return mqtt.Client()


def datetime_now_iso():
  """Returns the current UTC ISO-8601 formatted timestamp."""
  return datetime.datetime.now(datetime.timezone.utc).strftime(
      "%Y-%m-%dT%H:%M:%SZ"
  )


def remove_none_fields(d):
  """Recursively removes keys/items with None values."""
  if isinstance(d, dict):
    return {k: remove_none_fields(v) for k, v in d.items() if v is not None}
  if isinstance(d, list):
    return [remove_none_fields(v) for v in d if v is not None]
  return d


def clean_events(events):
  """Normalizes timestamps and generations for payload comparison."""
  cleaned = []
  for event in events:
    evt = json.loads(json.dumps(event))
    evt = remove_none_fields(evt)
    if "timestamp" in evt:
      evt["timestamp"] = "CLEANED"
    if "generation" in evt:
      evt["generation"] = "CLEANED"
    if "version" in evt:
      evt["version"] = "CLEANED"
    if evt.get("families") and isinstance(evt["families"], dict):
      for _, data in evt["families"].items():
        if isinstance(data, dict) and "generation" in data:
          data["generation"] = "CLEANED"
    cleaned.append(evt)
  return cleaned


def sort_discovery_events(events):
  """Sorts events with start (0) first, devices by addr, and stop (<0) last."""
  start_events = [e for e in events if e.get("event_no") == 0]
  stop_events = [e for e in events if e.get("event_no", 0) < 0]
  device_events = [
      e
      for e in events
      if e.get("event_no", 0) > 0 or e.get("addr") is not None
  ]
  device_events.sort(key=lambda e: str(e.get("addr", "")))
  for idx, dev_evt in enumerate(device_events, start=1):
    dev_evt["event_no"] = idx
  return start_events + device_events + stop_events


class TestParity(unittest.TestCase):
  """Validates parity between discoverynode and Spotter container scans."""

  @classmethod
  def setUpClass(cls):
    cleanup_cmd = (
        f"{CONTAINER_ENGINE} ps -q --filter network=parity-spotter-net | xargs"
        f" -r {CONTAINER_ENGINE} stop"
    )
    subprocess.run(
        cleanup_cmd,
        shell=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    res = subprocess.run(
        [CONTAINER_ENGINE, "network", "inspect", "parity-spotter-net"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if res.returncode != 0:
      try:
        subprocess.run(
            [
                CONTAINER_ENGINE,
                "network",
                "create",
                "--subnet=192.168.12.0/24",
                "--gateway=192.168.12.254",
                "parity-spotter-net",
            ],
            check=True,
        )
      except subprocess.CalledProcessError:
        subprocess.run(
            [CONTAINER_ENGINE, "network", "rm", "-f", "parity-spotter-net"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        subprocess.run(
            [
                CONTAINER_ENGINE,
                "network",
                "create",
                "--subnet=192.168.12.0/24",
                "--gateway=192.168.12.254",
                "parity-spotter-net",
            ],
            check=True,
        )

  def setUp(self):
    # pylint: disable=consider-using-with
    self.test_dir = tempfile.TemporaryDirectory()
    self.mqtt_port = 18883
    self.mqtt_plain_port = 18884

    # 1. Get workspace paths for certificates
    workspace_dir = os.path.abspath(
        os.path.join(os.path.dirname(__file__), "../../../")
    )
    site_dir = os.path.join(workspace_dir, "sites/udmi_site_model")
    ca_src = os.path.join(site_dir, "reflector/ca.crt")
    server_crt_src = os.path.join(site_dir, "reflector/server.crt")
    server_key_src = os.path.join(site_dir, "reflector/server.key")
    ahu_dir = os.path.join(site_dir, "devices/AHU-1")
    ahu_key_src = os.path.join(ahu_dir, "rsa_private.pem")
    ahu_crt_src = os.path.join(ahu_dir, "rsa_private.crt")
    ahu_pkcs8_src = os.path.join(ahu_dir, "rsa_private.pkcs8")

    # Copy client certs for AHU-1 to config dir
    for cert_path in [
        ca_src,
        server_crt_src,
        server_key_src,
        ahu_key_src,
        ahu_crt_src,
        ahu_pkcs8_src,
    ]:
      if not os.path.exists(cert_path):
        raise FileNotFoundError(
            f"Prerequisite certificate/key missing: {cert_path}. Ensure"
            " 'bin/setup_ca sites/udmi_site_model localhost' and 'bin/keygen"
            " CERT sites/udmi_site_model/devices/AHU-1' have been run."
        )

    shutil.copy(ca_src, os.path.join(self.test_dir.name, "ca.crt"))
    shutil.copy(
        ahu_key_src, os.path.join(self.test_dir.name, "rsa_private.pem")
    )
    shutil.copy(
        ahu_pkcs8_src, os.path.join(self.test_dir.name, "rsa_private.pkcs8")
    )
    shutil.copy(
        ahu_crt_src, os.path.join(self.test_dir.name, "rsa_private.crt")
    )

    # 2. Start local Mosquitto broker on unprivileged ports
    self.mosquitto_conf = os.path.join(self.test_dir.name, "mosquitto.conf")
    with open(self.mosquitto_conf, "w", encoding="utf-8") as f:
      f.write(f"""
listener {self.mqtt_plain_port} 0.0.0.0
allow_anonymous true

listener {self.mqtt_port} 0.0.0.0
cafile {ca_src}
certfile {server_crt_src}
keyfile {server_key_src}
require_certificate true
allow_anonymous true
""")

    self.mosquitto_log_path = os.path.join(self.test_dir.name, "mosquitto.log")
    # pylint: disable=consider-using-with
    self.mosquitto_log_file = open(
        self.mosquitto_log_path, "w", encoding="utf-8"
    )
    self.mosquitto_proc = subprocess.Popen(
        ["mosquitto", "-c", self.mosquitto_conf, "-v"],
        stdout=self.mosquitto_log_file,
        stderr=self.mosquitto_log_file,
    )
    time.sleep(1.5)

    if self.mosquitto_proc.poll() is not None:
      self.mosquitto_log_file.close()
      with open(self.mosquitto_log_path, "r", encoding="utf-8") as f:
        log_content = f.read()
      raise RuntimeError(f"Mosquitto failed to start:\n{log_content}")

    # 3. Ensure network exists
    res = subprocess.run(
        [CONTAINER_ENGINE, "network", "inspect", "parity-spotter-net"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    if res.returncode != 0:
      try:
        subprocess.run(
            [
                CONTAINER_ENGINE,
                "network",
                "create",
                "--subnet=192.168.12.0/24",
                "--gateway=192.168.12.254",
                "parity-spotter-net",
            ],
            check=True,
        )
      except subprocess.CalledProcessError:
        pass

    # 4. Start N simulated BACnet devices
    self.simulated_devices = []
    print(
        f"\n[TestParity] Starting {PARITY_TEST_NUM_DEVICES} simulated BACnet"
        " device(s)..."
    )
    for i in range(1, PARITY_TEST_NUM_DEVICES + 1):
      ip = f"192.168.12.{10 + i}"
      dev_id = 12340 + i
      cname = f"parity-bacnet-device-{i}"
      subprocess.run(
          [CONTAINER_ENGINE, "stop", cname],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
          check=False,
      )
      proc = subprocess.Popen(
          [
              CONTAINER_ENGINE,
              "run",
              "--rm",
              "--network=parity-spotter-net",
              f"--ip={ip}",
              "-e",
              f"BACNET_ID={dev_id}",
              "-e",
              "PYTHONUNBUFFERED=1",
              "--name",
              cname,
              "test-bacnet-device:latest",
          ],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
      )
      self.simulated_devices.append((cname, proc, dev_id, ip))
    time.sleep(3)

  def tearDown(self):
    # Stop simulated devices
    for cname, proc, _, _ in getattr(self, "simulated_devices", []):
      subprocess.run(
          [CONTAINER_ENGINE, "stop", cname],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
          check=False,
      )
      if proc:
        try:
          proc.wait(timeout=2)
        except Exception:
          pass

    if hasattr(self, "mosquitto_proc") and self.mosquitto_proc:
      self.mosquitto_proc.terminate()
      try:
        self.mosquitto_proc.wait(timeout=2)
      except Exception:
        pass

    if hasattr(self, "mosquitto_log_file") and self.mosquitto_log_file:
      self.mosquitto_log_file.close()

    self.test_dir.cleanup()

  def run_discovery_test(
      self,
      container_image,
      container_name,
      client_id,
      config_file_in_container,
      family="bacnet",
      depth="system",
      addrs=None,
      scan_duration_sec=6,
      settle_time=12,
  ):
    """Executes a container discovery run and collects emitted events."""
    if self.mosquitto_proc.poll() is not None:
      self.mosquitto_log_file.close()
      with open(self.mosquitto_log_path, "r", encoding="utf-8") as f:
        log_content = f.read()
      raise RuntimeError(f"Mosquitto broker died:\n{log_content}")

    messages = []
    client = create_mqtt_client()
    state_received = threading.Event()
    connected = threading.Event()

    def on_message(client, userdata, message):
      # pylint: disable=unused-argument
      if message.topic.endswith("/state"):
        state_received.set()
      elif message.topic.endswith("/events/discovery"):
        payload = json.loads(message.payload.decode())
        messages.append(payload)

    def on_connect(client, userdata, flags, rc, properties=None):
      # pylint: disable=unused-argument
      connected.set()

    client.on_connect = on_connect
    client.on_message = on_message
    client.connect("127.0.0.1", self.mqtt_plain_port)
    client.loop_start()

    if not connected.wait(timeout=5):
      raise RuntimeError("Test MQTT client failed to connect to local broker")

    client.subscribe(f"/r/ZZ-TRI-FECTA/d/{client_id}/events/discovery")
    client.subscribe(f"/r/ZZ-TRI-FECTA/d/{client_id}/state")

    # Clean existing container name if running
    subprocess.run(
        [CONTAINER_ENGINE, "stop", container_name],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    # pylint: disable=consider-using-with
    container_proc = subprocess.Popen(
        [
            CONTAINER_ENGINE,
            "run",
            "--rm",
            "--network=parity-spotter-net",
            "--ip=192.168.12.2",
            "--name",
            container_name,
            "-v",
            f"{self.test_dir.name}:/config_dir",
            container_image,
            "--config_file",
            config_file_in_container,
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    try:
      timestamp = datetime_now_iso()
      family_scan_cfg = {
          "generation": timestamp,
          "scan_duration_sec": scan_duration_sec,
          "depth": depth,
      }
      if addrs:
        family_scan_cfg["addrs"] = addrs

      config_payload = {
          "timestamp": timestamp,
          "discovery": {
              "families": {
                  family: family_scan_cfg,
              }
          },
      }

      success = False
      for _ in range(15):
        client.publish(
            f"/r/ZZ-TRI-FECTA/d/{client_id}/config",
            json.dumps(config_payload),
            qos=1,
        )
        if state_received.wait(timeout=1.0):
          time.sleep(0.5)
          client.publish(
              f"/r/ZZ-TRI-FECTA/d/{client_id}/config",
              json.dumps(config_payload),
              qos=1,
          )
          success = True
          break

      if not success:
        print(f"\nERROR: Container {container_name} timed out.")
        if os.path.exists(self.mosquitto_log_path):
          with open(self.mosquitto_log_path, "r", encoding="utf-8") as f:
            print("\n--- MOSQUITTO BROKER LOGS ---")
            print(f.read())
        raise RuntimeError(
            f"Container {container_name} failed to publish state update."
        )

      time.sleep(settle_time)
    finally:
      subprocess.run(
          [CONTAINER_ENGINE, "stop", container_name],
          stdout=subprocess.DEVNULL,
          stderr=subprocess.DEVNULL,
          check=False,
      )
      stdout, stderr = container_proc.communicate()
      print(f"\n[{container_name} STDOUT]:\n", stdout.decode())
      if stderr:
        print(f"\n[{container_name} STDERR]:\n", stderr.decode())

      client.loop_stop()
      client.disconnect()

    return messages

  def _prepare_configs(self):
    legacy_config = {
        "mqtt": {
            "device_id": "DSN-1",
            "host": "192.168.12.254",
            "port": self.mqtt_port,
            "registry_id": "ZZ-TRI-FECTA",
            "region": "us-central1",
            "project_id": "my-project",
            "key_file": "/config_dir/rsa_private.pem",
            "ca_file": "/config_dir/ca.crt",
            "cert_file": "/config_dir/rsa_private.crt",
            "algorithm": "RS256",
            "authentication_mechanism": "udmi_local",
        },
        "bacnet": {"ip": None, "port": None, "interface": None},
        "udmi": {
            "discovery": {
                "ipv4": True,
                "vendor": False,
                "ether": True,
                "bacnet": True,
            }
        },
    }
    legacy_config_file = os.path.join(self.test_dir.name, "legacy_config.json")
    with open(legacy_config_file, "w", encoding="utf-8") as f:
      f.write(json.dumps(legacy_config))

    spotter_config = {
        "mqtt": {
            "device_id": "DSN-1",
            "host": "192.168.12.254",
            "port": self.mqtt_port,
            "registry_id": "ZZ-TRI-FECTA",
            "region": "us-central1",
            "project_id": "my-project",
            "key_file": "/config_dir/rsa_private.pem",
            "ca_file": "/config_dir/ca.crt",
            "cert_file": "/config_dir/rsa_private.crt",
            "algorithm": "RS256",
            "authentication_mechanism": "udmi_local",
        }
    }
    spotter_config_file = os.path.join(
        self.test_dir.name, "spotter_config.json"
    )
    with open(spotter_config_file, "w", encoding="utf-8") as f:
      f.write(json.dumps(spotter_config))

  def test_01_bacnet_multi_device_discovery_parity(self):
    """Verifies BACnet system discovery parity across N simulated devices."""
    self._prepare_configs()
    expected_dev_ids = [
        str(dev_id) for _, _, dev_id, _ in self.simulated_devices
    ]

    num_devs = len(self.simulated_devices)
    scan_dur = max(6, 2 + num_devs * 2)
    settle_t = max(10, 4 + num_devs * 3)

    print(
        f"\n--- [Test 1] Running Legacy Discovery: BACnet depth=system"
        f" (devices={num_devs}, scan={scan_dur}s, settle={settle_t}s) ---"
    )
    legacy_events = self.run_discovery_test(
        "test-discovery_node:latest",
        "parity-legacy-node-system",
        "DSN-1",
        "/config_dir/legacy_config.json",
        family="bacnet",
        depth="system",
        scan_duration_sec=scan_dur,
        settle_time=settle_t,
    )

    print(
        f"\n--- [Test 1] Running Spotter Discovery: BACnet depth=system"
        f" (devices={num_devs}, scan={scan_dur}s, settle={settle_t}s) ---"
    )
    spotter_events = self.run_discovery_test(
        "udmi-spotter:latest",
        "parity-spotter-node-system",
        "DSN-1",
        "/config_dir/spotter_config.json",
        family="bacnet",
        depth="system",
        scan_duration_sec=scan_dur,
        settle_time=settle_t,
    )

    legacy_clean = sort_discovery_events(clean_events(legacy_events))
    spotter_clean = sort_discovery_events(clean_events(spotter_events))

    print(f"\nDiscovered simulated BACnet device IDs: {expected_dev_ids}")
    print(f"Legacy total events: {len(legacy_clean)}")
    print(f"Spotter total events: {len(spotter_clean)}")

    # 1. Verify start & stop markers
    self.assertTrue(
        any(e.get("event_no") == 0 for e in legacy_clean),
        "Legacy missing start marker 0",
    )
    self.assertTrue(
        any(e.get("event_no") == 0 for e in spotter_clean),
        "Spotter missing start marker 0",
    )
    self.assertTrue(
        any(e.get("event_no", 0) < 0 for e in legacy_clean),
        "Legacy missing finish marker < 0",
    )
    self.assertTrue(
        any(e.get("event_no", 0) < 0 for e in spotter_clean),
        "Spotter missing finish marker < 0",
    )

    # 2. Verify all simulated devices are present in both
    for dev_id in expected_dev_ids:
      leg_match = [e for e in legacy_clean if e.get("addr") == dev_id]
      spt_match = [e for e in spotter_clean if e.get("addr") == dev_id]
      self.assertEqual(
          len(leg_match), 1, f"Legacy failed to discover device {dev_id}"
      )
      self.assertEqual(
          len(spt_match), 1, f"Spotter failed to discover device {dev_id}"
      )

      # Verify system metadata parity
      leg_sys = leg_match[0].get("system", {})
      spt_sys = spt_match[0].get("system", {})
      self.assertEqual(leg_sys.get("hardware"), spt_sys.get("hardware"))
      self.assertEqual(leg_sys.get("ancillary"), spt_sys.get("ancillary"))

    # 3. Verify total event parity
    self.assertEqual(
        legacy_clean, spotter_clean, "System discovery events do not match!"
    )
    print("\nSUCCESS: BACnet multi-device system discovery parity achieved!")

  def test_02_bacnet_point_enumeration_parity(self):
    """Verifies BACnet point reference enumeration parity across N devices."""
    self._prepare_configs()
    expected_dev_ids = [
        str(dev_id) for _, _, dev_id, _ in self.simulated_devices
    ]

    num_devs = len(self.simulated_devices)
    scan_dur = max(7, 3 + num_devs * 2)
    settle_t = max(12, 5 + num_devs * 3)

    print(
        f"\n--- [Test 2] Running Legacy Discovery: BACnet depth=refs"
        f" (devices={num_devs}, scan={scan_dur}s, settle={settle_t}s) ---"
    )
    legacy_events = self.run_discovery_test(
        "test-discovery_node:latest",
        "parity-legacy-node-refs",
        "DSN-1",
        "/config_dir/legacy_config.json",
        family="bacnet",
        depth="refs",
        scan_duration_sec=scan_dur,
        settle_time=settle_t,
    )

    print(
        f"\n--- [Test 2] Running Spotter Discovery: BACnet depth=refs"
        f" (devices={num_devs}, scan={scan_dur}s, settle={settle_t}s) ---"
    )
    spotter_events = self.run_discovery_test(
        "udmi-spotter:latest",
        "parity-spotter-node-refs",
        "DSN-1",
        "/config_dir/spotter_config.json",
        family="bacnet",
        depth="refs",
        scan_duration_sec=scan_dur,
        settle_time=settle_t,
    )

    legacy_clean = sort_discovery_events(clean_events(legacy_events))
    spotter_clean = sort_discovery_events(clean_events(spotter_events))

    print(f"\nLegacy refs events: {len(legacy_clean)}")
    print(f"Spotter refs events: {len(spotter_clean)}")

    # 1. Verify markers
    self.assertTrue(any(e.get("event_no") == 0 for e in legacy_clean))
    self.assertTrue(any(e.get("event_no") == 0 for e in spotter_clean))
    self.assertTrue(any(e.get("event_no", 0) < 0 for e in legacy_clean))
    self.assertTrue(any(e.get("event_no", 0) < 0 for e in spotter_clean))

    # 2. Verify all simulated devices are present and have points enumerated
    expected_points = {"AI:0", "AV:0", "BI:0", "MSV:0"}
    for dev_id in expected_dev_ids:
      leg_match = [e for e in legacy_clean if e.get("addr") == dev_id]
      spt_match = [e for e in spotter_clean if e.get("addr") == dev_id]
      self.assertEqual(len(leg_match), 1, f"Legacy missing device {dev_id}")
      self.assertEqual(len(spt_match), 1, f"Spotter missing device {dev_id}")

      leg_refs = leg_match[0].get("refs", {})
      spt_refs = spt_match[0].get("refs", {})

      self.assertTrue(
          expected_points.issubset(set(leg_refs.keys())),
          f"Legacy missing expected points on {dev_id}",
      )
      self.assertTrue(
          expected_points.issubset(set(spt_refs.keys())),
          f"Spotter missing expected points on {dev_id}",
      )

      # Verify point attributes parity (name, type, description, units, possible_values)
      for pt_id in expected_points:
        lp = leg_refs[pt_id]
        sp = spt_refs[pt_id]
        self.assertEqual(
            lp.get("name"),
            sp.get("name"),
            f"Point {pt_id} name mismatch on {dev_id}",
        )
        self.assertEqual(
            lp.get("type"),
            sp.get("type"),
            f"Point {pt_id} type mismatch on {dev_id}",
        )
        self.assertEqual(
            lp.get("description"),
            sp.get("description"),
            f"Point {pt_id} description mismatch on {dev_id}",
        )
        if "units" in lp:
          self.assertEqual(
              lp.get("units"),
              sp.get("units"),
              f"Point {pt_id} units mismatch on {dev_id}",
          )
        if "possible_values" in lp:
          self.assertEqual(
              lp.get("possible_values"),
              sp.get("possible_values"),
              f"Point {pt_id} possible_values mismatch on {dev_id}",
          )

    print(
        "\nSUCCESS: BACnet point reference enumeration parity achieved across"
        " all devices!"
    )


if __name__ == "__main__":
  unittest.main()
