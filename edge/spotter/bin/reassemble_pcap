#!/usr/bin/env python3
"""Utility to reassemble UDMI upload/discovery chunks into a valid PCAP file and scan manifest.

Usage:
    bin/reassemble_pcap <input_file_or_stdin> <output_pcap_path> [--manifest <manifest_path>]

Supported input formats:
    - Raw JSON array of DiscoveryUpload messages: [ {"event_no": 0, ...}, {"event_no": 1, "data": "..."}, ... ]
    - JSON Lines (JSONL): One DiscoveryUpload JSON object per line
    - mosquitto_sub output: "<topic> <json_payload>"
    - Standard input (specify "-" as input file)
"""

import argparse
import base64
import gzip
import hashlib
import json
import os
import sys
from typing import Any, Dict, List, Optional

PCAP_MAGIC_NUMBERS = [
    b"\xa1\xb2\xc3\xd4",  # Standard pcap (same-endian)
    b"\xd4\xc3\xb2\xa1",  # Standard pcap (swapped-endian)
    b"\xa1\xb2\x3c\x4d",  # Nanosecond pcap (same-endian)
    b"\x4d\x3c\xb2\xa1",  # Nanosecond pcap (swapped-endian)
]

GZIP_MAGIC = b"\x1f\x8b"


def parse_upload_messages(raw_text: str) -> List[Dict[str, Any]]:
  """Parses DiscoveryUpload objects from JSON array, JSONL, or mosquitto_sub."""
  raw_text = raw_text.strip()
  if not raw_text:
    return []

  # Case 1: Standard JSON array or single object
  if raw_text.startswith("[") or raw_text.startswith("{"):
    try:
      data = json.loads(raw_text)
      if isinstance(data, list):
        return [
            item.get("payload", item)
            if (
                isinstance(item, dict)
                and "payload" in item
                and isinstance(item["payload"], dict)
            )
            else item
            for item in data
            if isinstance(item, dict)
        ]
      if isinstance(data, dict):
        if "payload" in data and isinstance(data["payload"], dict):
          return [data["payload"]]
        return [data]
    except json.JSONDecodeError:
      pass

  # Case 2: Line by line (JSONL or mosquitto_sub format: "<topic> <payload>")
  messages: List[Dict[str, Any]] = []
  for line in raw_text.splitlines():
    line = line.strip()
    if not line:
      continue
    if " " in line and not line.startswith("{"):
      _, _, payload = line.partition(" ")
    else:
      payload = line

    try:
      obj = json.loads(payload)
      if isinstance(obj, dict):
        inner = (
            obj.get("payload")
            if isinstance(obj.get("payload"), dict)
            else obj
        )
        if "event_no" in inner or "data" in inner:
          messages.append(inner)
    except json.JSONDecodeError:
      continue

  return messages


def decode_chunk_bytes(b64_str: str) -> bytes:
  """Base64-decodes and gunzips a PCAP chunk payload."""
  raw_bytes = base64.b64decode(b64_str)
  if raw_bytes.startswith(GZIP_MAGIC):
    return gzip.decompress(raw_bytes)
  return raw_bytes


def reassemble_pcap(
    input_source: str,
    output_path: str,
    manifest_output_path: Optional[str] = None,
) -> Dict[str, Any]:
  """Reassembles chunked upload/discovery messages into a binary .pcap file and verifies sha256."""
  if input_source == "-":
    raw_content = sys.stdin.read()
  else:
    if not os.path.exists(input_source):
      sys.exit(f"Error: Input file '{input_source}' does not exist.")
    with open(input_source, "r", encoding="utf-8", errors="replace") as f:
      raw_content = f.read()

  messages = parse_upload_messages(raw_content)
  if not messages:
    sys.exit("Error: No valid upload/discovery records found in input.")

  data_events = [
      m
      for m in messages
      if m.get("data") and int(m.get("event_no", 1)) > 0
  ]
  if not data_events:
    sys.exit("Error: Found upload records but none contained base64 'data'.")

  eof_events = [m for m in messages if int(m.get("event_no", 0)) < 0]
  expected_sha256: Optional[str] = None
  expected_chunks: Optional[int] = None
  scan_manifest: Optional[Dict[str, Any]] = None

  if eof_events:
    terminal = eof_events[-1]
    expected_sha256 = terminal.get("sha256")
    expected_chunks = (-int(terminal["event_no"])) - 1
    if isinstance(terminal.get("scan_manifest"), dict):
      scan_manifest = terminal["scan_manifest"]

  def sort_key(e: Dict[str, Any]) -> int:
    return int(e.get("event_no", 0))

  sorted_events = sorted(data_events, key=sort_key)
  generation = sorted_events[0].get("generation") or "unknown"
  family = sorted_events[0].get("family", "bacnet")
  total_chunks = len(sorted_events)

  if expected_chunks is not None and total_chunks != expected_chunks:
    sys.exit(
        f"Error: Chunk count mismatch (received {total_chunks}, expected"
        f" {expected_chunks} from terminal event_no)."
    )

  pcap_data = bytearray()
  for idx, evt in enumerate(sorted_events):
    b64_str = evt["data"]
    try:
      chunk_bytes = decode_chunk_bytes(b64_str)
      pcap_data.extend(chunk_bytes)
    except Exception as err:  # pylint: disable=broad-exception-caught
      sys.exit(f"Error: Failed to decode/decompress chunk at index {idx}: {err}")

  if not pcap_data:
    sys.exit("Error: Reassembled PCAP payload is empty (0 bytes).")

  actual_sha256 = hashlib.sha256(pcap_data).hexdigest()
  if expected_sha256 and actual_sha256 != expected_sha256:
    sys.exit(
        f"Error: SHA-256 digest mismatch! Expected {expected_sha256}, got"
        f" {actual_sha256}."
    )

  magic = bytes(pcap_data[:4])
  is_valid_magic = any(magic == m for m in PCAP_MAGIC_NUMBERS)

  os.makedirs(os.path.dirname(os.path.abspath(output_path)), exist_ok=True)
  with open(output_path, "wb") as f:
    f.write(pcap_data)

  resolved_manifest_path = manifest_output_path
  if scan_manifest is not None:
    if not resolved_manifest_path:
      resolved_manifest_path = os.path.join(
          os.path.dirname(os.path.abspath(output_path)), "scan_manifest.json"
      )
    os.makedirs(
        os.path.dirname(os.path.abspath(resolved_manifest_path)), exist_ok=True
    )
    with open(resolved_manifest_path, "w", encoding="utf-8") as mf:
      json.dump(scan_manifest, mf, indent=2)

  magic_status = "VALID" if is_valid_magic else "WARNING: Unexpected header"
  print("========================================")
  print("PCAP Reassembly Completed Successfully")
  print("========================================")
  print(f"Generation     : {generation}")
  print(f"Family         : {family}")
  print(f"Chunks Decoded : {total_chunks}")
  print(f"Total Bytes    : {len(pcap_data)}")
  print(f"SHA-256 Digest : {actual_sha256}")
  print(f"Magic Bytes    : {magic.hex()} ({magic_status})")
  print(f"Output File    : {output_path}")
  if resolved_manifest_path and os.path.exists(resolved_manifest_path):
    print(f"Scan Manifest  : {resolved_manifest_path}")

  return {
      "generation": generation,
      "family": family,
      "chunks": total_chunks,
      "bytes": len(pcap_data),
      "sha256": actual_sha256,
      "output_path": output_path,
      "manifest_path": resolved_manifest_path,
  }


def main():
  """CLI entry point for PCAP reassembly."""
  parser = argparse.ArgumentParser(
      description="Reassemble UDMI upload/discovery chunks into PCAP file"
  )
  parser.add_argument(
      "input",
      help="Input file containing upload/discovery data (or '-' for stdin)",
  )
  parser.add_argument(
      "output", help="Destination file path for reassembled .pcap"
  )
  parser.add_argument(
      "--manifest",
      default=None,
      help="Optional destination path for scan_manifest.json",
  )
  args = parser.parse_args()

  reassemble_pcap(args.input, args.output, manifest_output_path=args.manifest)


if __name__ == "__main__":
  main()
